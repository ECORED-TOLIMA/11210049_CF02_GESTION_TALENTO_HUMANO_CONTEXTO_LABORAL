":335,"to":382,"x":0}]]},{"lines":[[{"y":183,"from":383,"to":467,"x":0}],[{"y":207,"from":467,"to":548,"x":0}],[{"y":231,"from":548,"to":631,"x":0}],[{"y":255,"from":631,"to":654,"x":0}]]},{"lines":[[{"y":279,"from":655,"to":655,"x":0}]]},{"lines":[[{"y":303,"from":656,"to":702,"x":0}]]},{"lines":[[{"y":327,"from":703,"to":787,"x":0}],[{"y":351,"from":787,"to":869,"x":0}],[{"y":375,"from":869,"to":952,"x":0}],[{"y":399,"from":952,"to":994,"x":0}]]},{"lines":[[{"y":423,"from":995,"to":995,"x":0}]]},{"lines":[[{"y":447,"from":996,"to":1039,"x":0}]]},{"lines":[[{"y":471,"from":1040,"to":1118,"x":0}],[{"y":495,"from":1118,"to":1201,"x":0}],[{"y":519,"from":1201,"to":1275,"x":0}],[{"y":543,"from":1275,"to":1322,"x":0}]]}],"rawText":"•\tFactibilidad técnica: \nDetermina si la organización cuenta con las herramientas, la infraestructura y el conocimiento especializado necesarios para implementar la alternativa propuesta. También considera si es posible adquirir o desarrollar esas capacidades en un tiempo razonable sin comprometer la operación habitual del equipo. \n\n•\tImpacto en el bienestar de los colaboradores:\nAnaliza de qué manera la alternativa seleccionada afecta las condiciones laborales, la motivación y la calidad de vida de quienes integran el equipo. Las soluciones sostenibles deben mejorar o, al menos, no deteriorar el ambiente organizacional ni la cohesión del grupo. \n\n•\tAlineación con los valores organizacionales:\n Verifica que la alternativa propuesta sea coherente con la misión, la visión y los principios que orientan la cultura institucional. Una solución que contradice los valores de la organización genera desconfianza y dificulta su aceptación por parte de los integrantes del equipo de trabajo. \n\n•\tTiempo requerido para su implementación: \nEstima el plazo necesario para poner en marcha la alternativa y evalúa si ese período es compatible con las necesidades del equipo y las condiciones del entorno organizacional. Las soluciones que exigen tiempos excesivos pueden perder vigencia antes de generar resultados concretos."}},{"type":"group","name":"Grupo 1201930","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"ae1eb57d-ac83-48c2-b354-98656adbcc47","transform":{"a":1,"b":0,"c":0,"d":1,"tx":21557,"ty":674.5},"group":{"children":[{"type":"shape","name":"Rectángulo 455354","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintBottom":true}},"id":"43042cc6-f77b-4a07-bfbc-3ccad4ba978f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23995,"ty":-3701},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":327,"height":465,"r":[20,20,20,20]}},{"type":"group","name":"Enmascarar grupo 1119288","meta":{"ux":{"nameL10N":"SHAPE_MASK","clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457913","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintBottom":true}},"id":"b6b0bd34-a0cc-4ef2-8389-12ac1654b467","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-24628,"ty":-3013},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":0,"g":60,"b":225}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":327,"height":401,"r":[20,20,20,20]}}],"type":"clipPath"}}},"id":"19a8a87b-bb91-464d-b21b-000a31e5765b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":633,"ty":-688},"group":{"children":[{"type":"shape","name":"Trazado 1014457","meta":{"ux":{"nameL10N":"SHAPE_PATH","rotation":-164}},"id":"2dddd6c9-2d29-40a4-87a3-cfd614258be8","transform":{"a":-0.9612616896629333,"b":-0.27563732862472534,"c":0.27563732862472534,"d":-0.9612616896629333,"tx":-2357