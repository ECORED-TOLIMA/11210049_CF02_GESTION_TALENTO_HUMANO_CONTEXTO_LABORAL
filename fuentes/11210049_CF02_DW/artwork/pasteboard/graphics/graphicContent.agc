62 0 69.39056396484375 0 69.09551239013672 C 0 68.80010986328125 0.2391053587198257 68.56099700927734 0.5345127582550049 68.56099700927734 C 6.023958683013916 68.56099700927734 10.49034786224365 73.02703857421875 10.49034786224365 78.516845703125 C 10.49034786224365 78.81188201904297 10.25088691711426 79.05135345458984 9.955835342407227 79.05135345458984"}}]}}]}},{"type":"shape","name":"Imagen 193","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":650,"height":508}}},"id":"4fdda98f-016a-429f-96ab-c5352cb4499e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4.127685546875,"ty":-4.578125},"style":{"fill":{"type":"pattern","pattern":{"width":650,"height":508,"meta":{"ux":{"scaleBehavior":"fill","uid":"56b49037238b62b2f3cc2fa1058cfe21","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":387,"height":302}}]}}]}},{"type":"text","name":"Far far away, behind","id":"f8ed7804-85d0-401c-aed0-b1102a676e59","transform":{"a":1,"b":0,"c":0,"d":1,"tx":459,"ty":-6324},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":714},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":88,"x":0}],[{"y":39,"from":88,"to":184,"x":0}],[{"y":63,"from":184,"to":283,"x":0}],[{"y":87,"from":283,"to":327,"x":0}]]},{"lines":[[{"y":111,"from":328,"to":426,"x":0}],[{"y":135,"from":426,"to":509,"x":0}]]},{"lines":[[{"y":159,"from":510,"to":510,"x":0}]]},{"lines":[[{"y":183,"from":511,"to":595,"x":0}],[{"y":207,"from":595,"to":691,"x":0}],[{"y":231,"from":691,"to":790,"x":0}],[{"y":255,"from":790,"to":850,"x":0}]]},{"lines":[[{"y":279,"from":851,"to":948,"x":0}],[{"y":303,"from":948,"to":1021,"x":0}]]},{"lines":[[{"y":327,"from":1022,"to":1022,"x":0}]]},{"lines":[[{"y":351,"from":1023,"to":1113,"x":0}],[{"y":375,"from":1113,"to":1203,"x":0}],[{"y":399,"from":1203,"to":1294,"x":0}],[{"y":423,"from":1294,"to":1388,"x":0}],[{"y":447,"from":1388,"to":1489,"x":0}],[{"y":471,"from":1489,"to":1503,"x":0}]]},{"lines":[[{"y":495,"from":1504,"to":1504,"x":0}]]},{"lines":[[{"y":519,"from":1505,"to":1589,"x":0}],[{"y":543,"from":1589,"to":1687,"x":0}],[{"y":567,"from":1687,"to":1779,"x":0}],[{"y":591,"from":1779,"to":1849,"x":0}]]},{"lines":[[{"y":615,"from":1850,"to":1945,"x":0}],[{"y":639,"from":1945,"to":1984,"x":0}]]}],"rawText":"•\tDar y recibir retroalimentación: comunicar observaciones sobre el desempeño de manera específica, objetiva y constructiva, reconociendo los logros y señalando las áreas de mejora de forma que la persona se sienta orientada y no atacada. Saber recibirla sin reactividad es igual de importante para el crecimiento profesional. \nContexto: en una institución educativa del sector público, la jefatura retroalimenta describiendo hechos concretos y proponiendo acciones de mejora sin generalizar ni descalificar. \n\n•\tDecir no de manera respetuosa: declinar una solicitud o establecer un límite ante comportamientos inadecuados de forma directa y respetuosa, explicando las razones sin culpar al interlocutor ni generar conflictos innecesarios. Esta habilidad protege el bienestar personal y la calidad del trabajo sin deteriorar la relación profesional. \nSituación: en una empresa del sector servicios, un colaborador declina asumir tareas adicionales explicando su carga actual y proponiendo una redistribución del trabajo. \n\n•\tManejar las críticas: responder a observaciones negativas de manera serena y reflexiva, evaluando si son válidas para aprender de ellas o injustas para señalarlo con calma y sin reactividad. Este manejo transforma cada crítica en una oportunidad de aprendizaje o en un momento de clarificación respetuosa. En la práctica: en una empresa de confecciones, el líder reconoce los logros públicamente y aborda las dificultades en reuniones privadas, sin generalizar ni descalificar. \n\n•\tNegociar acuerdos: buscar soluciones que satisfagan las necesidades esenciales de ambas partes en situaciones de desacuerdo, evitando la capitulación incondicional y la imposición unilateral. Requiere escucha activa, disposición al diálogo y voluntad de ceder en aspectos secundarios para preservar los vínculos y los resultados compartidos. \nCaso: en una cooperativa agropecuaria, los socios acuerdan turnos de trabajo y distribución de recursos mediante consenso en asamblea."}},{"type":"group","name":"Enmascarar grupo 1119426","meta":{"ux":{"nameL10N":"SHAPE_MASK","clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468352","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true}},"id":"01f3dc75-7b37-4568-8adf-332cf647d29a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1017,"ty":6253},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":292,"height":399}}],"type":"clipPath"}}},"id":"b0b3dd3e-be7d-4c86-8041-5ca642f883b5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-142,"ty":-11635},"group":{"children":[{"type":"shape","name":"Imagen 155","meta":{"ux":{"na