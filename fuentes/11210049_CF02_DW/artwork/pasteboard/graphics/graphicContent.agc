straintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":131,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"4a0cc4c8-b510-4629-9ab4-29104ac872c4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-2436,"ty":-4432.8837890625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":601},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0}]]},{"lines":[[{"y":39,"from":25,"to":107,"x":0}],[{"y":63,"from":107,"to":188,"x":0}],[{"y":87,"from":188,"to":266,"x":0}],[{"y":111,"from":266,"to":333,"x":0}]]},{"lines":[[{"y":135,"from":334,"to":334,"x":0}]]},{"lines":[[{"y":159,"from":335,"to":382,"x":0}]]},{"lines":[[{"y":183,"from":383,"to":467,"x":0}],[{"y":207,"from":467,"to":548,"x":0}],[{"y":231,"from":548,"to":631,"x":0}],[{"y":255,"from":631,"to":654,"x":0}]]},{"lines":[[{"y":279,"from":655,"to":655,"x":0}]]},{"lines":[[{"y":303,"from":656,"to":702,"x":0}]]},{"lines":[[{"y":327,"from":703,"to":787,"x":0}],[{"y":351,"from":787,"to":869,"x":0}],[{"y":375,"from":869,"to":952,"x":0}],[{"y":399,"from":952,"to":994,"x":0}]]},{"lines":[[{"y":423,"from":995,"to":995,"x":0}]]},{"lines":[[{"y":447,"from":996,"to":1039,"x":0}]]},{"lines":[[{"y":471,"from":1040,"to":1118,"x":0}],[{"y":495,"from":1118,"to":1201,"x":0}],[{"y":519,"from":1201,"to":1275,"x":0}],[{"y":543,"from":1275,"to":1322,"x":0}]]}],"rawText":"•\tFactibilidad técnica: \nDetermina si la organización cuenta con las herramientas, la infraestructura y el conocimiento especializado necesarios para implementar la alternativa propuesta. También considera si es posible adquirir o desarrollar esas capacidades en un tiempo razonable sin comprometer la operación habitual del equipo. \n\n•\tImpacto en el bienestar de los colaboradores:\nAnaliza de qué manera la alternativa seleccionada afecta las condiciones laborales, la motivación y la calidad de vida de quienes integran el equipo. Las soluciones sostenibles deben mejorar o, al menos, no deteriorar el ambiente organizacional ni la cohesión del grupo. \n\n•\tAlineación con los valores organizacionales:\n Verifica que la alternativa propuesta sea coherente con la misión, la visión y los principios que orientan la cultura institucional. Una solución que contradice los valores de la organización genera desconfianza y dificulta su aceptación por parte de los integrantes del equipo de trabajo. \n\n•\tTiempo requerido para su implementación: \nEstima el plazo necesario para poner en marcha la alternativa y evalúa si ese período es compatible con las necesidades del equipo y las condiciones del entorno organizacional. Las soluciones que exigen tiempos excesivos pueden perder vigencia antes de generar resultados concretos."}},{"type":"group","name":"Grupo 1201930","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"ae1eb57d-ac83-48c2-b354-98656adbcc47","transform":{"a":1,"b":0,"c":0,"d":1,"tx":21557,"ty":674.5},"group":{"children":[{"type":"shape","name":"Rectángulo 455354","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintBottom":true}},"id":"43042cc6-f77b-4a07-bfbc-3ccad4ba978f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23995,"ty":-3701},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":2