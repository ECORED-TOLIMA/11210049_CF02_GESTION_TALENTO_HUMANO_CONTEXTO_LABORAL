tyle":"Bold"}}},{"y":159,"from":337,"to":426}],[{"y":183,"from":426,"to":509,"x":0}]]},{"lines":[[{"y":207,"from":510,"to":510,"x":0}]]},{"lines":[[{"y":231,"from":511,"to":544,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":255,"from":545,"to":643,"x":0}],[{"y":279,"from":643,"to":746,"x":0}],[{"y":303,"from":746,"to":851,"x":0}]]},{"lines":[[{"y":327,"from":852,"to":852,"x":0}]]},{"lines":[[{"y":351,"from":853,"to":863,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":351,"from":863,"to":950}],[{"y":375,"from":950,"to":1023,"x":0}]]},{"lines":[[{"y":399,"from":1024,"to":1024,"x":0}]]},{"lines":[[{"y":423,"from":1025,"to":1049,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":447,"from":1050,"to":1146,"x":0}],[{"y":471,"from":1146,"to":1242,"x":0}],[{"y":495,"from":1242,"to":1340,"x":0}]]},{"lines":[[{"y":519,"from":1341,"to":1341,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":543,"from":1342,"to":1351,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":543,"from":1351,"to":1439}],[{"y":567,"from":1439,"to":1508,"x":0}]]},{"lines":[[{"y":591,"from":1509,"to":1509,"x":0}]]},{"lines":[[{"y":615,"from":1510,"to":1531,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":639,"from":1532,"to":1626,"x":0}],[{"y":663,"from":1626,"to":1722,"x":0}],[{"y":687,"from":1722,"to":1816,"x":0}],[{"y":711,"from":1816,"to":1855,"x":0}]]},{"lines":[[{"y":735,"from":1856,"to":1856,"x":0}]]},{"lines":[[{"y":759,"from":1857,"to":1863,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":759,"from":1863,"to":1952}],[{"y":783,"from":1952,"to":1991,"x":0}]]}],"rawText":"•\tDar y recibir retroalimentación\nComunicar observaciones sobre el desempeño de manera específica, objetiva y constructiva, reconociendo los logros y señalando las áreas de mejora de forma que la persona se sienta orientada y no atacada. Saber recibirla sin reactividad es igual de importante para el crecimiento profesional. \n\nContexto: en una institución educativa del sector público, la jefatura retroalimenta describiendo hechos concretos y proponiendo acciones de mejora sin generalizar ni descalificar. \n\n•\tDecir no de manera respetuosa: \nDeclinar una solicitud o establecer un límite ante comportamientos inadecuados de forma directa y respetuosa, explicando las razones sin culpar al interlocutor ni generar conflictos innecesarios. Esta habilidad protege el bienestar personal y la calidad del trabajo sin deteriorar la relación profesional. \n\nSituación: en una empresa del sector servicios, un colaborador declina asumir tareas adicionales explicando su carga actual y proponiendo una redistribución del trabajo. \n\n•\tManejar las críticas: \nResponder a observaciones negativas de manera serena y reflexiva, evaluando si son válidas para aprender de ellas o injustas para señalarlo con calma y sin reactividad. Este manejo transforma cada crítica en una oportunidad de aprendizaje o en un momento de clarificación respetuosa. En la \n\npráctica: en una empresa de confecciones, el líder reconoce los logros públicamente y aborda las dificultades en reuniones privadas, sin generalizar ni descalificar. \n\n•\tNegociar acuerdos: \nBuscar soluciones que satisfagan las necesidades esenciales de ambas partes en situaciones de desacuerdo, evitando la capitulación incondicional y la imposición unilateral. Requiere escucha activa, disposición al diálogo y voluntad de ceder en aspectos secundarios para preservar los vínculos y los resultados compartidos. \n\nCaso: en una cooperativa agropecuaria, los socios acuerdan turnos de trabajo y distribución de recursos mediante consenso en asamblea."}},{"type":"group","name":"Grupo 1201994","meta