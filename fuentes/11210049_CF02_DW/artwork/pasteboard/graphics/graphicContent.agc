617095947266 82.73141479492188 9.062543869018555 82.66281127929688 9.409102439880371 L 81.61164855957031 14.62088966369629 C 81.49799346923828 15.1800365447998 81.0059814453125 15.5660514831543 80.45713806152344 15.5660514831543 C 80.38087463378906 15.5660514831543 80.30270385742188 15.55839729309082 80.22290802001953 15.54249572753906 C 79.58544158935547 15.41367721557617 79.17306518554688 14.79269790649414 79.30130004882812 14.15522861480713 L 79.70041656494141 12.18305015563965 C 68.72196960449219 20.93433570861816 55.96684265136719 27.87361907958984 41.74112701416016 32.82747268676758 C 41.61289596557617 32.87252426147461 41.48201751708984 32.89328384399414 41.35379028320312 32.89328384399414 C 40.86663055419922 32.89342880249023 40.40995025634766 32.58853149414062 40.24094390869141 32.10270309448242 Z","winding":"evenodd"}}]}}]}},{"type":"text","name":"•\tReducción de conflictos organizacionales: \nCuando los integrantes de un equipo expresan desacuerdos de manera directa y respetuosa, los malentendidos disminuyen y se evitan situaciones de tensión acumulada que deterioran el ambiente de trabajo. Caso: en ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"38199a49-f86f-436b-9781-e96abf08f02c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":459,"ty":-10131},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":44,"x":0}]]},{"lines":[[{"y":39,"from":45,"to":175,"x":0}],[{"y":63,"from":175,"to":301,"x":0}],[{"y":87,"from":301,"to":424,"x":0}],[{"y":111,"from":424,"to":436,"x":0}]]},{"lines":[[{"y":135,"from":437,"to":437,"x":0}]]},{"lines":[[{"y":159,"from":438,"to":481,"x":0}]]},{"lines":[[{"y":183,"from":482,"to":611,"x":0}],[{"y":207,"from":611,"to":747,"x":0}],[{"y":231,"from":747,"to":848,"x":0}]]},{"lines":[[{"y":255,"from":849,"to":849,"x":0}]]},{"lines":[[{"y":279,"from":850,"to":897,"x":0}]]},{"lines":[[{"y":303,"from":898,"to":1032,"x":0}],[{"y":327,"from":1032,"to":1160,"x":0}],[{"y":351,"from":1160,"to":1284,"x":0}],[{"y":375,"from":1284,"to":1312,"x":0}]]},{"lines":[[{"y":399,"from":1313,"to":1313,"x":0}]]},{"lines":[[{"y":423,"from":1314,"to":1359,"x":0}]]},{"lines":[[{"y":447,"from":1360,"to":1486,"x":0}],[{"y":471,"from":1486,"to":1611,"x":0}],[{"y":495,"from":1611,"to":1700,"x":0}]]}],"rawText":"•\tReducción de conflictos organizacionales: \nCuando los integrantes de un equipo expresan desacuerdos de manera directa y respetuosa, los malentendidos disminuyen y se evitan situaciones de tensión acumulada que deterioran el ambiente de trabajo. Caso: en una cooperativa agropecuaria, la adopción de protocolos de comunicación asertiva redujo los conflictos entre socios durante las asambleas anuales de toma de decisiones colectivas. \n\n•\tDesarrollo de la confianza interpersonal:\nUn equipo cuyos integrantes se comunican con honestidad y respeto genera vínculos que favorecen la colaboración y el apoyo mutuo en situaciones de presión. Caso: en una institución educativa del sector público, el rector fortaleció la comunicación asertiva con los docentes y logró mayor participación en los procesos de mejora institucional y planeación académica. \n\n•\tMejora del desempeño individual y colectivo: \nLa claridad en la comunicación de expectativas, junto con la retroalimentación constructiva, permite a los colaboradores orientar sus esfuerzos con mayor precisión y mantener niveles de rendimiento más altos. Caso: en una empresa manufacturera, los supervisores capacitados en comunicación asertiva redujeron los errores de proceso al transmitir instrucciones con mayor especificidad y retroalimentación oportuna. \n\n•\tImpulso a la productividad organizacional: \nElimina los tiempos perdidos en malentendidos, retrabajos y conflictos no resueltos, liberando la energía del equipo hacia la consecución de los objetivos. Caso: en una empresa distribuidora, la adopción de protocolos asertivos entre áreas redujo los reprocesos internos y acortó los tiempos de entrega al cliente final de manera sostenida."}},{"type":"text","name":"Estilo pasivo","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintsDisabled":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":27,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"30ba217e-7725-44a7-a4ef-b1e668bb0f5f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":548,"ty":-8373},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":13,"x":-45.8493766784668}]]}],"rawText":"Estilo pasivo"}},{"type":"text","name":"La persona evita expresar sus opiniones o desacuerdos para prevenir el conflicto; cede constantemente y acumula insatisfacción, lo que reduce su influencia en el equipo. \nEjemplo 1: en una empresa de servicios, un coordinador detecta un error de su superio","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"8130adfb-a16d-4c41-8aaf-346e4898b62f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":928,"ty":-8360.7578125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":526},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":71,"x":0}],[{"y":39,"from":71,"to":142,"x":0}],[{"y":63,"from":142,"to":170,"x":0}]]},{"lines":[[{"y":87,"from":171,"to":243,"x":0}],[{"y":111,"from":243,"to":317,"x":0}],[{"y":135,"from":317,"to":329,"x":0}]]},{"lines":[[{"y":159,"from":330,"to":401,"x":0}],[{"y":183,"from":401,"to":472,"x":0}],[{"y":207,"from":472,"to":487,"x":0}]]}],"rawText":"La persona evita expresar sus opiniones o desacuerdos para prevenir el conflicto; cede constantemente y acumula insatisfacción, lo que reduce su influencia en el equipo. \nEjemplo 1: en una empresa de servicios, un coordinador detecta un error de su superior, pero no lo comunica “para no crear problemas”, y el error se propaga. \nEjemplo 2: en una empresa de retail, un colaborador acepta sobrecargas sistemáticas sin comunicar sus límites hasta que el agotamiento afecta su rendimiento."}},{"type":"group","name":"Grupo 1201975","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"b80e6c92-a56a-48b3-b311-43e522b4b35e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":316.25390625,"ty":-20743.7578125},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"247880c3-8a84-43a0-b1c4-d06a79f326e2","transform":{"