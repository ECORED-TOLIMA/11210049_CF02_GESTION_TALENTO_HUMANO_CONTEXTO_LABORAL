ight":40.078125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":30,"x":0}],[{"y":35,"from":30,"to":56,"x":0}]]}],"rawText":"https://fontawesome.com/icons/classic/solid/circle-right"}},{"type":"shape","name":"circle-right-solid-full","id":"63daceb7-8d12-4e35-899b-1d2246cee598","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1162.37109375,"ty":1939},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"aspectLock":{"width":512,"height":512}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":89}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 64 106 C 64 129.1984252929688 82.80155944824219 148 106 148 C 129.1984252929688 148 148 129.1984252929688 148 106 C 148 82.80155944824219 129.1984252929688 64 106 64 C 82.80155944824219 64 64 82.80155944824219 64 106 Z M 127.5414047241211 107.8539047241211 L 110.4789047241211 124.9164047241211 C 109.7242202758789 125.6710891723633 108.5921859741211 125.8843765258789 107.6242218017578 125.4906234741211 C 106.65625 125.0968704223633 106 124.12890625 106 123.0625 L 106 113.875 L 90.25 113.875 C 87.34609985351562 113.875 85 111.5289077758789 85 108.625 L 85 103.375 C 85 100.4710922241211 87.34609985351562 98.125 90.25 98.125 L 106 98.125 L 106 88.9375 C 106 87.87109375 106.6398468017578 86.91952514648438 107.6242218017578 86.50936889648438 C 108.6085968017578 86.09921264648438 109.7406234741211 86.32890319824219 110.4789047241211 87.08358764648438 L 127.5414047241211 104.1460952758789 C 128.55859375 105.1632843017578 128.55859375 106.8367156982422 127.5414047241211 107.8539047241211 Z"}}]}},{"type":"text","name":"•\tComunicación verbal escrita:\nCircula a través de correos electrónicos, circulares, manuales e informes; deja trazabilidad documental y unifica criterios a lo largo de la organización. Ejemplo: una entidad pública de Bogotá comunica por circular interna l","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":131,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"f738cd8c-3920-4564-bcb2-b89fcf42eb54","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-8722,"ty":-5716.94140625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":913},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":30,"x":0}]]},{"lines":[[{"y":39,"from":31,"to":160,"x":0}],[{"y":63,"from":160,"to":286,"x":0}],[{"y":87,"from":286,"to":406,"x":0}],[{"y":111,"from":406,"to":418,"x":0}]]},{"lines":[[{"y":135,"from":419,"to":419,"x":0}]]},{"lines":[[{"y":159,"from":420,"to":454,"x":0}]]},{"lines":[[{"y":183,"from":455,"to":584,"x":0}],[{"y":207,"from":584,"to":706,"x":0}],[{"y":231,"from":706,"to":810,"x":0}]]},{"lines":[[{"y":255,"from":811,"to":811,"x":0}]]},{"lines":[[{"y":279,"from":812,"to":848,"x":0}]]},{"lines":[[{"y":303,"from":849,"to":969,"x":0}],[{"y":327,"from":969,"to":1084,"x":0}],[{"y":351,"from":1084,"to":1207,"x":0}]]},{"lines":[[{"y":375,"from":1208,"to":1208,"x":0}]]},{"lines":[[{"y":399,"from":1209,"to":1243,"x":0}]]},{"lines":[[{"y":423,"from":1244,"to":1370,"x":0}],[{"y":447,"from":1370,"to":1493,"x":0}],[{"y":471,"from":1493,"to":1572,"x":0}]]}],"rawText":"•\tComunicación verbal escrita:\nCircula a través de correos electrónicos, circulares, manuales e informes; deja trazabilidad documental y unifica criterios a lo largo de la organización. Ejemplo: una entidad pública de Bogotá comunica por circular interna los protocolos actualizados de atención al ciudadano, garantizando que todos los colaboradores cuenten con la misma información de forma verificable y consultable.\n\n•\tComunicación no verbal corporal:\nSe expresa a través de gestos, expresiones faciales, posturas y movimientos del cuerpo, y refuerza o contradice el contenido del mensaje verbal. Ejemplo: en una IPS de Medellín, la coordinadora de talento humano mantiene contacto visual y una postura abierta durante las entrevistas de desempeño, lo que transmite respeto y disposición genuina al diálogo.\n\n•\tComunicación no verbal paraverbal:\nComprende los elementos vocales que acompañan el habla sin ser propiamente palabras: el tono, el volumen, el ritmo, las pausas y los silencios. Ejemplo: un supervisor en Barranquilla baja deliberadamente el tono de voz al informar una reestructuración del equipo, lo que transmite calma y seguridad a los colaboradores en un momento de incertidumbre laboral.\n\nComunicación no verbal contextual:\nAbarca los espacios físicos, los tiempos y los símbolos que enmarcan la interacción y condicionan su interpretación. Ejemplo: una cooperativa del Huila organiza su oficina de atención al asociado con espacios cómodos, iluminados y ordenados, lo que transmite confianza y profesionalismo desde el primer contacto con la persona. "}},{"type":"text","name":"•\tClaridad y precisión: \nImplica construir mensajes específicos, sin ambigüedad y adaptados al nivel de comprensión del receptor. Un mensaje claro reduce los errores de interpretación y agiliza la ejecución de las tareas. Caso real: una pyme de Pereira red","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"47cc5684-d525-4476-b446-a1147a74846f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-8736,"ty":-412},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":791},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0}]]},{"lines":[[{"y":39,"from":25,"to":133,"x":0}],[{"y":63,"from":133,"to":245,"x":0}],[{"y":87,"from":245,"to":346,"x":0}],[{"y":111,"from":346,"to":404,"x":0}]]},{"lines":[[{"y":135,"from":405,"to":405,"x":0}]]},{"lines":[[{"y":159,"from":406,"to":428,"x":0}]]},{"lines":[[{"y":183,"from":429,"to":536,"x":0}],[{"y":207,"from":536,"to":646,"x":0}],[{"y":231,"from":646,"to":745,"x":0}],[{"y":255,"from":745,"to":831,"x":0}]]},{"lines":[[{"y":279,"from":832,"to":832,"x":0}]]},{"lines":[[{"y":303,"from":833,"to":867,"x":0}]]},{"lines":[[{"y":327,"from":868,"to":972,"x":0}],[{"y":351,"from":972,"to":1082,"x":0}],[{"y":375,"from":1082,"to":1190,"x":0}],[{"y":399,"from":1190,"to":1246,"x":0}]]},{"lines":[[{"y":423,"from":1247,"to":1247,"x":0}]]},{"lines":[[{"y":447,"from":1248,"to":1273,"x":0}]]},{"lines":[[{"y":471,"from":1274,"to":1381,"x":0}],[{"y":495,"from":1381,"to":1484,"x":0}],[{"y":519,"from":1484,"to":1584,"x":0}],[{"y":543,"from":1584,"to":1690,"x":0}]]}],"rawText":"•\tClaridad y precisión: \nImplica construir mensajes específicos, sin ambigüedad y adaptados al nivel de comprensión del receptor. Un mensaje claro reduce los errores de interpretación y agiliza la ejecución de las tareas. Caso real: una pyme de Pereira redacta instrucciones paso a paso para el proceso de despacho de pedidos y elimina las dudas recurrentes que generaban reprocesos en el área operativa.\n\n•\tElección del canal: \nSupone seleccionar el medio de comunicación más adecuado según el tipo de mensaje, la urgencia y el perfil del receptor. Una elección inadecuada puede distorsionar el contenido o generar desconfianza. Aplicación: una empresa de Cúcuta anuncia un cambio en las condiciones laborales en reunión presencial en lugar de comunicarlo por chat, para garantizar comprensión y atender las reacciones del equipo.\n\n•\tRetroalimentación constructiva: \nPermite señalar fortalezas y oportunidades de mejora de forma objetiva, específica y respetuosa, con el propósito de fortalecer el desempeño sin afectar la relación. Ejemplo: en una obra de Cartagena, el residente de obra reconoce el avance del equipo, describe el error específico y propone conjuntamente una mejora, sin descalificar a la persona ni afectar el clima del grupo.\n\n•\tComunicación empática: \nConsidera las emociones, las circunstancias y la perspectiva del interlocutor al construir y transmitir un mensaje. Implica adaptar el tono, el contenido y el momento de la comunicación al estado emocional del receptor. En contexto: una jefa de talento humano en Manizales ajusta el estilo comunicativo con un colaborador que atraviesa una situación personal difícil para preservar la confianza y el vínculo laboral."}},{"type":"text","name":"•\tResponsabilidad individual y colectiva:\nCapacidad de cada integrante para asumir su contribución al proceso grupal sin delegar en los demás ni depender exclusivamente del esfuerzo ajeno, mientras el grupo, como unidad, responde por el resultado final. En","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":131,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"f22a0c8b-2d8d-4d3d-9697-c821ed205298","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-5639,"ty":-7026.93359375},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":793},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":41,"x":0}]]},{"lines":[[{"y":39,"from":42,"to":145,"x":0}],[{"y":63,"from":145,"to":254,"x":0}],[{"y":87,"from":254,"to":362,"x":0}],[{"y":111,"from":362,"to":417,"x":0}]]},{"lines":[[{"y":135,"from":418,"to":418,"x":0}]]},{"lines":[[{"y":159,"from":419,"to":454,"x":0}]]},{"lines":[[{"y":183,"from":455,"to":566,"x":0}],[{"y":207,"from":566,"to":678,"x":0}],[{"y":231,"from":678,"to":784,"x":0}],[{"y":255,"from":784,"to":888,"x":0}],[{"y":279,"from":888,"to":903,"x":0}]]},{"lines":[[{"y":303,"from":904,"to":904,"x":0}]]},{"lines":[[{"y":327,"from":905,"to":935,"x":0}]]},{"lines":[[{"y":351,"from":936,"to":1040,"x":0}],[{"y":375,"from":1040,"to":1152,"x":0}],[{"y":399,"from":1152,"to":1263,"x":0}],[{"y":423,"from":1263,"to":1362,"x":0}]]},{"lines":[[{"y":447,"from":1363,"to":1363,"x":0}]]},{"lines":[[{"y":471,"from":1364,"to":1402,"x":0}]]},{"lines":[[{"y":495,"from":1403,"to":1513,"x":0}],[{"y":519,"from":1513,"to":1629,"x":0}],[{"y":543,"from":1629,"to":1736,"x":0}],[{"y":567,"from":1736,"to":1814,"x":0}]]}],"rawText":"•\tResponsabilidad individual y colectiva:\nCapacidad de cada integrante para asumir su contribución al proceso grupal sin delegar en los demás ni depender exclusivamente del esfuerzo ajeno, mientras el grupo, como unidad, responde por el resultado final. En contexto: en una PYME de confecciones, cada operario responde por su estación de trabajo, pero el equipo asume colectivamente los tiempos de entrega al cliente.\n\n•\tComunicación abierta y horizontal\nAmbiente en el que todos los integrantes pueden expresar ideas, preguntas y dudas sin temor a la crítica, y en el que las jerarquías no obstaculizan el flujo de información. En la práctica: en una empresa textil, el equipo realiza reuniones semanales para proponer mejoras sin importar el cargo. Situación organizacional: en una cooperativa de caficultores, los asociados cuentan con canales directos para comunicar dificultades sin intermediarios.\n\n•\tValoración de la diversidad:\nReconocimiento de que las diferencias en perspectivas, experiencias y habilidades entre los integrantes constituyen una riqueza y no un obstáculo, y que aprovechar esa diversidad potencia la creatividad y la calidad de las soluciones colectivas. En contexto: en una empresa de consultoría, la combinación de perfiles técnicos, creativos y comerciales produce propuestas más integrales que las generadas por equipos homogéneos.\n\n•\tReflexión colectiva sobre el proceso\nPráctica mediante la cual el grupo destina momentos para evaluar su propio funcionamiento, identificar lo que favorece el logro de los objetivos y ajustar lo que genera dificultades. En la práctica: en una entidad pública, el equipo de talento humano realiza cierres de ciclo mensuales para revisar avances, reconocer aprendizajes y replantear las estrategias que no están produciendo los resultados esperados. "}},{"type":"text","name":"•\tGrupos de discusión\nEspacios estructurados para el análisis y debate de un tema específico, en los que un moderador facilita la participación equitativa y orienta el diálogo hacia conclusiones concretas. Se aplican para tomar decisiones colectivas, resol","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"28cdcfd7-1cd2-4008-93f5-719c32324aad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-5621,"ty":-5102},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":684},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":21,"x":0}]]},{"lines":[[{"y":39,"from":22,"to":108,"x":0}],[{"y":63,"from":108,"to":206,"x":0}],[{"y":87,"from":206,"to":301,"x":0}],[{"y":111,"from":301,"to":336,"x":0}]]},{"lines":[[{"y":135,"from":337,"to":337,"x":0}]]},{"lines":[[{"y":159,"from":338,"to":379,"x":0}]]},{"lines":[[{"y":183,"from":380,"to":473,"x":0}],[{"y":207,"from":473,"to":569,"x":0}],[{"y":231,"from":569,"to":664,"x":0}],[{"y":255,"from":664,"to":696,"x":0}]]},{"lines":[[{"y":279,"from":697,"to":697,"x":0}]]},{"lines":[[{"y":303,"from":698,"to":729,"x":0}]]},{"lines":[[{"y":327,"from":730,"to":825,"x":0}],[{"y":351,"from":825,"to":917,"x":0}],[{"y":375,"from":917,"to":1010,"x":0}],[{"y":399,"from":1010,"to":1058,"x":0}]]},{"lines":[[{"y":423,"from":1059,"to":1059,"x":0}]]},{"lines":[[{"y":447,"from":1060,"to":1078,"x":0}]]},{"lines":[[{"y":471,"from":1079,"to":1175,"x":0}],[{"y":495,"from":1175,"to":1269,"x":0}],[{"y":519,"from":1269,"to":1360,"x":0}],[{"y":543,"from":1360,"to":1382,"x":0}]]}],"rawText":"•\tGrupos de discusión\nEspacios estructurados para el análisis y debate de un tema específico, en los que un moderador facilita la participación equitativa y orienta el diálogo hacia conclusiones concretas. Se aplican para tomar decisiones colectivas, resolver conflictos o construir acuerdos frente a situaciones que afectan al equipo. \n\n•\tAprendizaje basado en problemas (ABP): \nEstrategia pedagógica y organizacional que parte de situaciones problema reales para motivar la búsqueda colectiva de soluciones y fortalecer el pensamiento crítico. En las organizaciones, se emplea para desarrollar competencias prácticas a través del análisis de casos concretos del entorno laboral de cada equipo. \n\n•\tMatrices de responsabilidad: \nHerramientas visuales que permiten identificar con claridad quién es responsable de cada tarea dentro del equipo, evitando duplicidades, vacíos de responsabilidad y confusiones sobre los roles. Se utilizan en la gestión de proyectos para garantizar que cada integrante conozca su contribución específica al resultado colectivo. \n\n•\tRetrospectivas: \nReuniones periódicas en las que el equipo reflexiona sobre su propio funcionamiento, identifica lo que está operando bien y lo que puede mejorarse, y establece compromisos para la siguiente etapa. Se implementan al cierre de ciclos de trabajo para promover la mejora continua y el aprendizaje colectivo."}},{"type":"text","name":"B. Barreras psicológicas: se originan en estados emocionales, actitudes o sesgos que distorsionan la recepción o emisión del mensaje; incluyen el temor al juicio, los prejuicios y la baja confianza para expresarse. Caso 1: en una empresa de confecciones, u","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":26,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":467,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"934d8dc0-8da4-482b-a3b5-a3506799d590","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-5590,"ty":-2794},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":543},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":26,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":26,"to":74}],[{"y":39,"from":74,"to":146,"x":0}],[{"y":63,"from":146,"to":226,"x":0}],[{"y":87,"from":226,"to":300,"x":0}],[{"y":111,"from":300,"to":374,"x":0}],[{"y":135,"from":374,"to":447,"x":0}],[{"y":159,"from":447,"to":493,"x":0}]]}],"rawText":"B. Barreras psicológicas: se originan en estados emocionales, actitudes o sesgos que distorsionan la recepción o emisión del mensaje; incluyen el temor al juicio, los prejuicios y la baja confianza para expresarse. Caso 1: en una empresa de confecciones, un operario identifica una falla, pero no la reporta por temor a represalias del supervisor. Caso 2: en una empresa de tecnología, un líder descarta las propuestas de nuevos colaboradores por considerarlas «poco maduras» sin analizarlas. "}},{"type":"text","name":"C. Barreras tecnológicas o físicas: surgen cuando los canales son inadecuados o el ambiente físico dificulta la transmisión del mensaje con claridad. Caso 1: en una organización pública, las reuniones virtuales se realizan sin herramientas estables ni agen","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":36,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":426,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"a51913f2-7a38-4b8d-9167-f563253eda74","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-5590,"ty":-2384},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":543},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":36,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":36,"to":66}],[{"y":39,"from":66,"to":140,"x":0}],[{"y":63,"from":140,"to":214,"x":0}],[{"y":87,"from":214,"to":289,"x":0}],[{"y":111,"from":289,"to":364,"x":0}],[{"y":135,"from":364,"to":438,"x":0}],[{"y":159,"from":438,"to":462,"x":0}]]}],"rawText":"C. Barreras tecnológicas o físicas: surgen cuando los canales son inadecuados o el ambiente físico dificulta la transmisión del mensaje con claridad. Caso 1: en una organización pública, las reuniones virtuales se realizan sin herramientas estables ni agenda previa, generando confusión y pérdida de información. Caso 2: en una empresa del sector construcción, el ruido en la obra impide que los trabajadores reciban las instrucciones de seguridad con claridad. "}},{"type":"text","name":"D. Barreras culturales u organizacionales: se presentan cuando jerarquías, normas no escritas o diferencias culturales limitan la participación equitativa y el libre flujo de ideas. Caso 1: en una empresa familiar, la cultura de «no contradecir al jefe» im","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":43,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":441,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"761ba536-e89e-45cc-95b2-e10d1a4c55fe","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-5590,"ty":-1974},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":543},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":43,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":43,"to":75}],[{"y":39,"from":75,"to":144,"x":0}],[{"y":63,"from":144,"to":226,"x":0}],[{"y":87,"from":226,"to":302,"x":0}],[{"y":111,"from":302,"to":369,"x":0}],[{"y":135,"from":369,"to":445,"x":0}],[{"y":159,"from":445,"to":484,"x":0}]]}],"rawText":"D. Barreras culturales u organizacionales: se presentan cuando jerarquías, normas no escritas o diferencias culturales limitan la participación equitativa y el libre flujo de ideas. Caso 1: en una empresa familiar, la cultura de «no contradecir al jefe» impide que los colaboradores señalen errores en las decisiones directivas. Caso 2: en una organización con equipos multigeneracionales, las diferencias en el uso de canales digitales generan brechas en el acceso a la información. "}},{"type":"group","name":"Grupo 1201888","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true}},"id":"a8325399-290d-4ba3-bc7e-ccef0f1fbdad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":18924,"ty":4537},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"88d997e9-d70a-4603-a557-455f184f2d85","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23947,"ty":-7331},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":584,"height":330}},{"type":"shape","name":"Rectángulo 454715","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"0cde038c-614a-4423-bf81-0ecc818e8c6c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23577,"ty":-7331},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":214,"height":330}},{"type":"group","name":"Enmascarar grupo 1119137","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 454730","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"0a89c176-4e78-4e3e-81e0-769ecad38621","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-0.25390625,"ty":0},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":560,"height":309,"r":[10,10,10,10]}}],"type":"clipPath"}}},"id":"c7d3a049-1dc6-4664-8df6-978d5e26107e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23934.74609375,"ty":-7320},"gr