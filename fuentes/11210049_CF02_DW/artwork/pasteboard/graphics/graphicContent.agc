 cooperativa agroindustrial, la coordinadora solicita cambios en el proceso, explica las razones y escucha las inquietudes del equipo antes de decidir. \n\nEjemplo 2: en una empresa de alimentos, un colaborador comunica que necesita más tiempo para una tarea, argumenta por qué y propone un plan de entrega alternativo."}},{"type":"group","name":"Grupo 1201976","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"b9e0de69-0c5f-408d-b5ed-cdb03857880f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":316.25390625,"ty":-20412.7578125},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"b69550fc-ca68-4aba-96ff-05eb5a9349a0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185.74609375,"ty":12383},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":275}},{"type":"group","name":"Enmascarar grupo 1119137","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 454730","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"6a8318d2-bb7d-4736-83ed-5cb752d5da85","transform":{"a":1,"b":0,"c":0,"d":1,"tx":3.4106086553055415e-15,"ty":0},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":382.5360107421875,"height":263.1202697753906,"r":[10,10,10,10]}}],"type":"clipPath"}}},"id":"55cb8590-1e6d-4c7b-86eb-59e043e03653","transform":{"a":1,"b":0,"c":0,"d":1,"tx":192.87376403808594,"ty":12389.3359375},"group":{"children":[{"type":"grou