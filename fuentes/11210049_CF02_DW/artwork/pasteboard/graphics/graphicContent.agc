gular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":37,"x":-136.586669921875}],[{"y":39,"from":37,"to":69,"x":-114.41636657714844}],[{"y":63,"from":69,"to":105,"x":-126.00761413574219}],[{"y":87,"from":105,"to":140,"x":-121.83573913574219}],[{"y":111,"from":140,"to":178,"x":-128.34103393554688}],[{"y":135,"from":178,"to":217,"x":-135.16183471679688}],[{"y":159,"from":217,"to":256,"x":-135.6540069580078}],[{"y":183,"from":256,"to":276,"x":-67.18421936035156}]]}],"rawText":"Supone comparar cada opción a partir de los estándares de evaluación definidos previamente por el grupo. Este análisis estructurado permite jerarquizar las alternativas según su viabilidad, su impacto y su coherencia con los valores y recursos disponibles en la organización. "}},{"type":"text","name":"Una vez evaluadas las opciones, el equipo elige la que mejor responde a los parámetros definidos y diseña un plan de acción concreto. La implementación debe incluir responsables, tiempos y recursos claramente asignados para garantizar una ejecución efectiv","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"1a7bf4f2-9789-4fd0-a5a4-98e63b9e8761","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-2052,"ty":-2788.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":35,"x":-123.27713775634766}],[{"y":39,"from":35,"to":72,"x":-131.098388671875}],[{"y":63,"from":72,"to":109,"x":-131.05885314941406}],[{"y":87,"from":109,"to":137,"x":-98.11372375488281}],[{"y":111,"from":137,"to":165,"x":-100.85590362548828}],[{"y":135,"from":165,"to":198,"x":-119.61605072021484}],[{"y":159,"from":198,"to":235,"x":-134.887451171875}],[{"y":183,"from":235,"to":270,"x":-123.38260650634766}]]}],"rawText":"Una vez evaluadas las opciones, el equipo elige la que mejor responde a los parámetros definidos y diseña un plan de acción concreto. La implementación debe incluir responsables, tiempos y recursos claramente asignados para garantizar una ejecución efectiva y ordenada. "}},{"type":"text","name":"Tiene como propósito verificar si la solución implementada produjo los efectos esperados y en qué medida resolvió el problema inicial. Cuando los resultados no coinciden con lo previsto, el equipo retoma el proceso desde la etapa necesaria para introducir ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"6fa91474-cdfd-490e-aca7-fe9d91d2a50d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1690,"ty":-2788.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":37,"x":-125.15259552001953}],[{"y":39,"from":37,"to":71,"x":-125.54229736328125}],