"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"a6e9b002-dbda-4b69-862a-ef196529842f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":555,"ty":-8042},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":15,"x":-51.52609634399414}]]}],"rawText":"Estilo asertivo"}},{"type":"text","name":"La persona expresa sus ideas, necesidades y límites con claridad y respeto, reconociendo las perspectivas de los demás; favorece el diálogo constructivo y la resolución efectiva de problemas. \nEjemplo 1: en una cooperativa agroindustrial, la coordinadora s","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"f578b349-d5f8-42a5-9f31-9234b61c78f2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":928,"ty":-8029.7578125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":526},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":67,"x":0}],[{"y":39,"from":67,"to":140,"x":0}],[{"y":63,"from":140,"to":192,"x":0}]]},{"lines":[[{"y":87,"from":193,"to":264,"x":0}],[{"y":111,"from":264,"to":337,"x":0}],[{"y":135,"from":337,"to":362,"x":0}]]},{"lines":[[{"y":159,"from":363,"to":431,"x":0}],[{"y":183,"from":431,"to":498,"x":0}],[{"y":207,"from":498,"to":526,"x":0}]]}],"rawText":"La persona expresa sus ideas, necesidades y límites con claridad y respeto, reconociendo las perspectivas de los demás; favorece el diálogo constructivo y la resolución efectiva de problemas. \nEjemplo 1: en una cooperativa agroindustrial, la coordinadora solicita cambios en el proceso, explica las razones y escucha las inquietudes del equipo antes de decidir. \nEjemplo 2: en una empresa de alimentos, un colaborador comunica que necesita más tiempo para una tarea, argumenta por qué y propone un plan de entrega alternativo."}},{"type":"group","name":"Grupo 1201976","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"b9e0de69-0c5f-408d-b5ed-cdb03857880f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":316.25390625,"ty":-20412.7578125},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"b69550fc-ca68-4aba-96ff-05eb5a9349a0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185.74609375,"ty":12383},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":224.92799377441406}},{"type":"group","name":"Enmascarar grupo 1119137","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 454730","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"6a8318d2-bb7d-4736-83ed-5cb752d5da85","transform":{"a":1,"b":0,"c":0,"d":1,"tx":3.4106086553055415e-15,"ty":0},"style":{"fill":{"type":"solid","color":{"mode":"RGB","va