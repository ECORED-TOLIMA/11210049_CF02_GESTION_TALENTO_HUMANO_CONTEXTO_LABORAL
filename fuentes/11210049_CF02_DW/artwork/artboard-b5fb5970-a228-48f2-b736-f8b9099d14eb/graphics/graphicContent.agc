b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":684.900390625,"height":200}}]}},{"type":"text","name":"La diferencia entre quien coordina tareas y quien desarrolla el potencial de su equipo radica, en gran medida, en la calidad de sus prácticas comunicativas. Las estrategias que se presentan a continuación no son técnicas aisladas: forman un marco integrado","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":719.5,"ty":7375}}},"id":"bf5b849c-9476-4752-a291-d0c40ba1835e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-449.5,"ty":-4332},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":618},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":87,"x":0}],[{"y":39,"from":87,"to":173,"x":0}],[{"y":63,"from":173,"to":257,"x":0}],[{"y":87,"from":257,"to":337,"x":0}],[{"y":111,"from":337,"to":398,"x":0}]]}],"rawText":"La diferencia entre quien coordina tareas y quien desarrolla el potencial de su equipo radica, en gran medida, en la calidad de sus prácticas comunicativas. Las estrategias que se presentan a continuación no son técnicas aisladas: forman un marco integrado que, aplicado de manera consistente, transforma la forma en que las personas se relacionan, aprenden y contribuyen dentro de la organización."}},{"type":"group","name":"Grupo 1201987","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight"