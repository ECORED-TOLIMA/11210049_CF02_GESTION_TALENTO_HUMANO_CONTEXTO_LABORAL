53f2f73304","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-850,"ty":-10085},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":128,"x":0}],[{"y":39,"from":128,"to":255,"x":0}],[{"y":63,"from":255,"to":373,"x":0}]]}],"rawText":"Contribuye a crear entornos en los que las personas se sienten escuchadas y valoradas, lo que reduce la tensión interpersonal y mejora la convivencia diaria. Caso: en una empresa del sector servicios, la implementación de reuniones quincenales de escucha activa redujo el ausentismo notablemente y disminuyó la rotación de personal en los primeros dos meses de aplicación. "}},{"type":"text","name":"Transmitir de manera específica los resultados, plazos y estándares que se esperan de un colaborador, sin dar por supuesto que la información es conocida. Esta claridad reduce la ambigüedad, orienta el desempeño y evita fricciones desde el inicio de cada t","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319,"ty":5479}}},"id":"c777a221-3f0b-4592-8f45-8b48fb7455cd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-850,"ty":-6228},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":960