{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 690.2359008789062 551.2232666015625 C 691.7644653320312 551.3485107421875 694.60693359375 551.3628540039062 697.669189453125 549.9511108398438 C 699.2408447265625 549.2265014648438 701.2044067382812 548.3460083007812 702.212646484375 546.3614501953125 C 702.9847412109375 544.8414916992188 702.9520874023438 543.2503051757812 701.9052734375 538.475830078125 C 701.3657836914062 536.015380859375 700.5809326171875 532.8169555664062 699.43798828125 529.1000366210938 C 699.2001953125 529.208984375 698.9622192382812 529.3182373046875 698.7245483398438 529.42724609375 C 698.3043212890625 534.0472412109375 697.8843994140625 538.6669921875 697.4641723632812 543.287109375 C 694.0623779296875 544.1624145507812 690.6605834960938 545.0375366210938 687.259033203125 545.9129028320312 C 688.2513427734375 547.6829223632812 689.2435913085938 549.4532470703125 690.2359008789062 551.2232666015625 Z"}}]}}]}}]}}]}}]}},{"type":"text","name":"Far far away, behind","id":"2d1e2d4f-1e12-4eba-93dd-3689395e3f8d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-983,"ty":-5631},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":6076}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":246,"x":0}],[{"y":63,"from":246,"to":368,"x":0}],[{"y":87,"from":368,"to":461,"x":0}]]}],"rawText":"Las cinco habilidades expuestas no son destrezas aisladas: cada una refuerza y potencia a las demás en la práctica cotidiana. Quien aprende a comunicar expectativas con claridad encuentra más sencillo dar retroalimentación; quien sabe establecer límites construye vínculos más sólidos; y quien negocia desde el diálogo genera equipos con mayor cohesión. Su desarrollo conjunto transforma la calidad de las relaciones laborales y el nivel de desempeño colectivo."}},{"type":"shape","name":"Rectángulo 468353","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":6197}}},"id":"bfa17e7e-234a-4028-b14f-989954e26d4f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-5510},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":128}},{"type":"text","name":"La teoría adquiere sentido cuando se contrasta con situaciones concretas. A continuación, se presenta un caso de aplicación en un entorno organizacional colombiano, que permite reconocer cómo estas habilidades se articulan en la gestión real del talento hu","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":221,"ty":6228}}},"id":"5b3a46c0-8e99-49ab-91a0-e645b1d54d54","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-948,"ty":-5479},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":845},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":229,"x":0}],[{"y":63,"from":229,"to":261,"x":0}]]}],"rawText":"La teoría adquiere sentido cuando se contrasta con situaciones concretas. A continuación, se presenta un caso de aplicación en un entorno organizacional colombiano, que permite reconocer cómo estas habilidades se articulan en la gestión real del talento humano:"}},{"type":"shape","name":"Rectángulo 468354","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":6365}}},"id":"aa83a4eb-7b17-4eb7-8f9f-4b31232bab8d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-879,"ty":-5342},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":271}},{"type":"text","name":"Retroalimentación asertiva en una empresa de confecciones\n\nEn una empresa de confecciones, la coordinadora de talento humano debe dar retroalimentación a un operario cuya calidad de producción ha disminuido. En lugar de esperar la evaluación semestral o ab","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":59,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":585,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":582,"ty":6395}}},"id":"23804cb0-d6a7-410b-a949-341ace7123b8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-587,"ty":-5312},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":57,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":58,"to":58,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":59,"to":152,"x":0}],[{"y":87,"from":152,"to":242,"x":0}],[{"y":111,"from":242,"to":342,"x":0}],[{"y":135,"from":342,"to":436,"x":0}],[{"y":159,"from":436,"to":525,"x":0}],[{"y":183,"from":525,"to":617,"x":0}],[{"y":207,"from":617,"to":644,"x":0}]]}],"rawText":"Retroalimentación asertiva en una empresa de confecciones\n\nEn una empresa de confecciones, la coordinadora de talento humano debe dar retroalimentación a un operario cuya calidad de producción ha disminuido. En lugar de esperar la evaluación semestral o abordar el tema frente al grupo, solicita una reunión privada, presenta datos objetivos del indicador de calidad y reconoce el buen desempeño previo. Le pregunta si hay factores que estén afectando su rendimiento. El operario comparte dificultades personales y se siente escuchado. Juntos acuerdan un plan de apoyo. La producción mejora en las semanas siguientes y la relación se fortalece."}},{"type":"group","name":"Enmascarar grupo 1119427","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"BG","id":"6e09c1ab-b1ae-4261-a897-dc26e9e298d2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":304.9999694824219,"ty":2886},"meta":{"ux":{"hasCustomName":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":232,"g":232,"b":232}}}},"shape":{"type":"rect","x":0,"y":0,"width":293,"height":249}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":816,"ty":3190}}},"id":"8dd61041-e26a-4d34-9243-26a136abad59","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-353,"ty":-8517},"group":{"children":[{"type":"shape","name":"Imagen 195","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":600,"height":400}}},"id":"df191053-c0b3-403e-9d5a-5f43baeffdfb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":265,"ty":2884},"style":{"fill":{"type":"pattern","pattern":{"width":600,"height":400,"meta":{"ux":{"scaleBehavior":"fill","uid":"a6b708985082fd8f138cf06d3cc29837","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":383,"height":255}}]}},{"type":"text","name":"Far far away, behind","id":"4e6d2344-7995-4b79-a0c8-d278ab2fe0d8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-880,"ty":-5031},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":6676}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":155,"x":0}],[{"y":39,"from":155,"to":318,"x":0}],[{"y":63,"from":318,"to":471,"x":0}]]}],"rawText":"El caso ilustra cómo la intervención oportuna y respetuosa transforma una situación de bajo rendimiento en una oportunidad de desarrollo y fortalecimiento del vínculo laboral. La coordinadora no recurrió a la confrontación ni al silencio; eligió el diálogo estructurado, la escucha activa y el acuerdo mutuo. Ese tipo de intervención, fundamentada en la claridad y el respeto, distingue la gestión del talento humano efectiva de la que se reduce a cumplir procedimientos."}},{"type":"text","name":"Far far away, behind","id":"08dfbea3-1e3d-4b7d-a11f-f5b281fb93ba","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-3570},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8137}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":171,"x":0}],[{"y":39,"from":171,"to":339,"x":0}],[{"y":63,"from":339,"to":477,"x":0}]]}],"rawText":"Las cinco estrategias descritas no operan de manera independiente: se articulan y se refuerzan mutuamente en la práctica cotidiana del liderazgo. Un líder que comunica la visión con claridad facilita el reconocimiento genuino; quien escucha activamente gestiona mejor las situaciones difíciles; y quien conecta a su equipo horizontalmente construye redes de colaboración más sólidas. Su aplicación consistente transforma la calidad del entorno laboral y el desempeño colectivo."}},{"type":"text","name":"Far far away, behind","id":"2567ee3e-210e-454f-af95-631f7c589f25","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-4512},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":7195}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":337,"x":0}],[{"y":63,"from":337,"to":418,"x":0}]]}],"rawText":"Dirigir personas va más allá de coordinar tareas y controlar resultados: implica construir el entorno comunicativo en el que cada integrante comprende el sentido de su trabajo, percibe que sus aportes son valorados y dispone de la información necesaria para actuar con criterio. Esta perspectiva sitúa la comunicación en el centro de la función directiva, no como un instrumento auxiliar, sino como su eje estructural."}},{"type":"text","name":"Far far away, behind","id":"dd94f843-78c3-4b02-9158-320af14f90df","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-4105},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":7602}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":169,"x":0}],[{"y":39,"from":169,"to":280,"x":0}]]}],"rawText":"Estas estrategias son aplicables en cualquier contexto donde exista una persona que lidera y un equipo que trabaja hacia un propósito compartido, independientemente del sector o del tamaño de la organización. Las más relevantes en la gestión del talento humano son las siguientes:"}},{"type":"shape","name":"Rectángulo 468356","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":6783}}},"id":"8e9d8104-ef56-4b1f-86ea-90040766f2b8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-880,"ty":-4924},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":170,"r":[20,20,20,20]}},{"type":"text","name":"Desarrollar las habilidades comunicativas abordadas en este apartado constituye la base sobre la cual se construye el liderazgo efectivo de personas. Sin embargo, la capacidad de comunicarse con claridad y respeto no basta por sí sola: requiere integrarse ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":325,"ty":6811}}},"id":"d23f3f33-6622-44af-a938-54c6879fbd04","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-844,"ty":-4896},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":949},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":128,"x":0}],[{"y":39,"from":128,"to":259,"x":0}],[{"y":63,"from":259,"to":388,"x":0}],[{"y":87,"from":388,"to":519,"x":0}],[{"y":111,"from":519,"to":620,"x":0}]]}],"rawText":"Desarrollar las habilidades comunicativas abordadas en este apartado constituye la base sobre la cual se construye el liderazgo efectivo de personas. Sin embargo, la capacidad de comunicarse con claridad y respeto no basta por sí sola: requiere integrarse en enfoques deliberados que orienten, motiven y potencien a los integrantes del equipo de manera sostenida. Quien lidera desde esta perspectiva no solo transmite información, sino que genera las condiciones para que cada persona alcance su potencial dentro de la organización. El siguiente apartado examina las herramientas que hacen posible esta forma de dirigir."}},{"type":"group","name":"Grupo 1201985","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":6073}}},"id":"62ec30fa-bc73-4a14-b28c-4640ccd1bed9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1169,"ty":-5634},"group":{"children":[{"type":"shape","name":"Rectángulo 467460","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"5826de46-16aa-446e-bb0d-41e3b0412d86","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":603},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":252,"b":247}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84}},{"type":"group","name":"Grupo 1200421","meta":{"ux":{"nameL10N":"SHAPE_GROUP","aspectLock":{"width":57.64900588989258,"height":64.9173583984375}}},"id":"ee63ebdd-7b9b-4701-b583-036c3fe7a378","transform":{"a":1,"b":0,"c":0,"d":1,"tx":197.71484375,"ty":612.1748046875},"group":{"children":[{"type":"group","name":"Grupo 1200420","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 467426","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"aa599238-5b96-435a-859e-83d3c078bcf8","style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}}},"shape":{"type":"rect","x