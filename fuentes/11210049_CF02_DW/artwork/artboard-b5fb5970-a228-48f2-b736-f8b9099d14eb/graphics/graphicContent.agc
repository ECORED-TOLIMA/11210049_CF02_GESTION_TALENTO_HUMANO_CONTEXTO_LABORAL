c":0,"d":1,"tx":-38.15127944946289,"ty":-56.580421447753906},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}}},"shape":{"type":"path","path":"M 64.29690551757812 95.1080322265625 C 63.39088821411133 95.1080322265625 62.47790908813477 94.92213439941406 61.6013298034668 94.54967498779297 C 57.99544143676758 93.01943969726562 56.12087631225586 88.75131988525391 57.42252731323242 85.0352783203125 C 57.55582809448242 84.65554046630859 57.97161483764648 84.45573425292969 58.35103225708008 84.58871459960938 C 58.73077011108398 84.72168731689453 58.93090438842773 85.13715362548828 58.79792404174805 85.51722717285156 C 57.74536514282227 88.52208709716797 59.2580451965332 91.97251129150391 62.17061996459961 93.20866394042969 C 63.55562210083008 93.79647827148438 65.05043029785156 93.79647827148438 66.37953186035156 93.20899963378906 C 67.72120666503906 92.61590576171875 68.73835754394531 91.49519348144531 69.24346923828125 90.05263519287109 C 69.37680053710938 89.67289733886719 69.79191589355469 89.47310638427734 70.1719970703125 89.6060791015625 C 70.55172729492188 89.73905181884766 70.75186157226562 90.15451049804688 70.61888122558594 90.53459167480469 C 69.97880554199219 92.36085510253906 68.68280029296875 93.78422546386719 66.96865844726562 94.54173278808594 C 66.11491394042969 94.91915893554688 65.20956420898438 95.1080322265625 64.29690551757812 95.1080322265625"}}]}}]}}]}},{"type":"shape","name":"Rectángulo 467720","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":2836}}},"id":"54cb6d1e-0c6f-40f3-9f06-1290b3817add","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-568,"ty":-8871},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":156,"r":[10,10,10,10]}},{"type":"text","name":"Far far away, behind","id":"697a19e7-08e8-4c7e-a5c4-cc1b0d93e143","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-540,"ty":-8838},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":629,"ty":2869}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":757},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":102,"x":0}],[{"y":39,"from":102,"to":203,"x":0}],[{"y":63,"from":203,"to":311,"x":0}],[{"y":87,"from":311,"to":347,"x":0}]]}],"rawText":"La persona asertiva, en cambio, se expresa con claridad y honestidad, defiende sus derechos y expresa sus necesidades sin atropellar los derechos y necesidades de los demás. Reconoce que tiene derecho a opinar, a decir no, a expresar desacuerdos y a pedir lo que necesita, pero ejerce ese derecho con respeto y consideración hacia el interlocutor."}},{"type":"text","name":"Far far away, behind","id":"0c1b4144-5811-4f8c-815f-9bcecd954064","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-464,"ty":-8685},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":705,"ty":3022}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":708},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":86,"x":0}],[{"y":39,"from":86,"to":182,"x":0}],[{"y":63,"from":182,"to":280,"x":0}],[{"y":87,"from":280,"to":371,"x":0}],[{"y":111,"from":371,"to":404,"x":0}]]}],"rawText":"En los entornos organizacionales, esta competencia resulta fundamental para comunicar expectativas con claridad, para brindar retroalimentación constructiva, para establecer límites cuando es necesario y para resolver conflictos sin dañar las relaciones. Un líder asertivo genera confianza porque sus colaboradores saben qué esperar de él y confían en que será honesto y respetuoso en sus comunicaciones."}},{"type":"text","name":"Far far away, behind","id":"6a9bdeb4-00ea-4e4e-afc3-c135d3abfd22","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-8540},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":3167}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":173,"x":0}],[{"y":39,"from":173,"to":345,"x":0}],[{"y":63,"from":345,"to":465,"x":0}]]}],"rawText":"Comprender las diferencias entre estos tres estilos resulta esencial para identificar patrones de comunicación propios y del equipo de trabajo. Mientras la pasividad inhibe la expresión genuina y la agresividad impone sin considerar las necesidades del otro, el estilo asertivo construye relaciones basadas en el respeto y la claridad. Cada uno genera efectos particulares en el clima organizacional y en el desempeño colectivo, tal como se describe a continuación:"}},{"type":"text","name":"Far far away, behind","id":"e2f7045f-b56a-494d-8426-d45feff233c8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-7990},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":3717}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":171,"x":0}],[{"y":39,"from":171,"to":338,"x":0}],[{"y":63,"from":338,"to":436,"x":0}]]}],"rawText":"Los tres estilos descritos no son categorías rígidas ni etiquetas permanentes: la mayoría de las personas oscilan entre ellos según el contexto, la relación y el nivel de presión percibido. Lo relevante es reconocer en cuál se tiende a actuar con mayor frecuencia y comprender que el estilo que más favorece tanto las relaciones como los resultados organizacionales es aquel que combina claridad, respeto y firmeza de manera simultánea."}},{"type":"text","name":"Far far away, behind","id":"d3f18b02-cdae-40f4-8d85-a5e4c8922d5c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-880,"ty":-7687},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":4020}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1020},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":143,"x":0}],[{"y":39,"from":143,"to":277,"x":0}],[{"y":63,"from":277,"to":316,"x":0}]]}],"rawText":"Para profundizar en el concepto de  asertividad y reconocer cómo se aplica en situaciones reales del entorno laboral, se presenta el siguiente recurso de audio, que explica qué es la asertividad, en qué se diferencia de la pasividad y la agresividad, y cómo permite mejorar la comunicación en los equipos de trabajo:"}},{"type":"text","name":"Far far away, behind","id":"3912da56-d238-4ad5-8a73-4fb8a38faf8e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-7111},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":4596}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":167,"x":0}],[{"y":39,"from":167,"to":335,"x":0}],[{"y":63,"from":335,"to":430,"x":0}]]}],"rawText":"Con el marco conceptual establecido, el paso siguiente consiste en reconocer cómo esta competencia se expresa en las interacciones cotidianas del entorno laboral. Las prácticas concretas no operan en situaciones excepcionales: se ponen en juego cada vez que se informa una expectativa, se ofrece o recibe una crítica, o se gestiona un desacuerdo. El siguiente apartado examina esas manifestaciones en la dinámica real del trabajo."}},{"type":"group","name":"Grupo 1200695","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-332,"ty":-565}}},"id":"178fa894-16ba-4364-b7cf-fc05c074beb4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501,"ty":-12272},"group":{"children":[{"type":"shape","name":"Rectángulo 467559","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"b838dd51-726a-47c0-82b8-98c481a392c6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":517,"ty":1231},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1200694","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"ac780a46-b7de-499c-85f1-61fee87b659a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":525.2913208007812,"ty":1182.51318359375},"group":{"children":[{"type":"group","name":"Grupo 1200692","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"bf61a30b-6f65-4d6f-8705-53475a1143ae","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0.9861626029014587,"ty":66.37519836425781},"group":{"children":[{"type":"group","name":"Grupo 1200681","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true}},"id":"092316df-bc08-448c-9c26-7b67bdb2833b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":23.21369743347168,"ty":29.20419692993164},"group":{"children":[{"type":"shape","name":"Elipse 15040","meta":{"ux":{"nameL10N":"SHAPE_ELLIPSE"}},"id":"e0fab1d9-a248-4d58-9729-876a8a795877","style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":212,"g":246,"b":247}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"cx":9.508726119995117,"cy":9.508726119995117,"type":"circle","r":9.508726119995117}}]}},{"type":"group","name":"Grupo 1200682","meta":{"ux"