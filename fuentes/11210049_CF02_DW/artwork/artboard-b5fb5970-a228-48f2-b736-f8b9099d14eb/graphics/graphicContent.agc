"d":1,"tx":-28.25899887084961,"ty":-394.3265380859375},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":89}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 32.21902847290039 433.6555480957031 C 31.95460891723633 433.3911437988281 31.5258903503418 433.3911437988281 31.26156234741211 433.6555480957031 C 30.99714660644531 433.9199829101562 30.99714660644531 434.3486938476562 31.26156234741211 434.613037109375 L 33.08612823486328 436.4375915527344 C 33.35054397583008 436.7020263671875 33.77926635742188 436.7020263671875 34.04359436035156 436.4375915527344 C 34.30801010131836 436.1731872558594 34.30801010131836 435.7444458007812 34.04359436035156 435.4801330566406 L 32.21902847290039 433.6555480957031 Z"}},{"type":"shape","name":"Trazado 1016782","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true}},"id":"7765c47c-b673-4349-8e51-7acae434aba2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-405.4879455566406,"ty":-394.3271789550781},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":89}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 447.7491149902344 433.6562194824219 L 445.924560546875 435.4807739257812 C 445.6601257324219 435.7452087402344 445.6601257324219 436.1739196777344 445.924560546875 436.4382629394531 C 446.18896484375 436.7026672363281 446.6177062988281 436.7026672363281 446.8820190429688 436.4382629394531 L 448.7065734863281 434.6136779785156 C 448.9709777832031 434.3492736816406 448.9709777832031 433.9205322265625 448.7065734863281 433.6562194824219 C 448.4422607421875 433.3918762207031 448.0135498046875 433.3918762207031 447.7491149902344 433.6562194824219 Z"}}]}}]}},{"type":"text","name":"En cualquier organización, la calidad de las relaciones laborales depende en gran medida de la forma en que las personas expresan sus ideas, necesidades y desacuerdos. Comunicarse de manera efectiva no significa simplemente hablar con fluidez: implica tran","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":631,"ty":362}}},"id":"1155485a-a2b0-4bd2-9e0e-85e3e4a3b0a3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-538,"ty":-11345},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":752},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":104,"x":0}],[{"y":39,"from":104,"to":202,"x":0}],[{"y":63,"from":202,"to":306,"x":0}],[{"y":87,"from":306,"to":411,"x":0}],[{"y":111,"from":411,"to":510,"x":0}],[{"y":135,"from":510,"to":614,"x":0}]]}],"rawText":"En cualquier organización, la calidad de las relaciones laborales depende en gran medida de la forma en que las personas expresan sus ideas, necesidades y desacuerdos. Comunicarse de manera efectiva no significa simplemente hablar con fluidez: implica transmitir pensamientos, sentimientos y posiciones de forma directa, honesta y respetuosa, sin agredir al interlocutor ni renunciar a los propios derechos por temor al conflicto. Esta capacidad, una de las más valoradas en el mundo contemporáneo y, al mismo tiempo, una de las menos desarrolladas en muchos entornos laborales, es el eje central de este apartado."}},{"type":"text","name":"La comunicación asertiva constituye una de las competencias más demandadas en la gestión contemporánea del talento humano. Según Trujillo Vargas (2023), comunicar de manera asertiva no solo implica transmitir mensajes con claridad, sino también construir r","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":631,"ty":4951}}},"id":"257dd4a9-163a-4bbb-a337-aff8fc0c4e44","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-538,"ty":-6756},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":752},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":89,"x":0}],[{"y":39,"from":89,"to":190,"x":0}],[{"y":63,"from":190,"to":291,"x":0}],[{"y":87,"from":291,"to":395,"x":0}],[{"y":111,"from":395,"to":502,"x":0}],[{"y":135,"from":502,"to":524,"x":0}]]}],"rawText":"La comunicación asertiva constituye una de las competencias más demandadas en la gestión contemporánea del talento humano. Según Trujillo Vargas (2023), comunicar de manera asertiva no solo implica transmitir mensajes con claridad, sino también construir relaciones de trabajo basadas en el respeto mutuo, la confianza y la apertura al diálogo. En las organizaciones colombianas, esta habilidad se convierte en un factor diferenciador que incide directamente en el clima laboral, la productividad y la retención del talento."}},{"type":"text","name":"El recorrido por este eje parte del concepto fundamental y los estilos comunicativos que lo contextualizan, avanza hacia las habilidades concretas que caracterizan la comunicación asertiva en el trabajo y culmina con las estrategias para dirigir equipos de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":569}}},"id":"92b17172-bd38-449b-a1b5-16087690040f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-11138},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":167,"x":0}],[{"y":39,"from":167,"to":336,"x":0}],[{"y":63,"from":336,"to":477,"x":0}]]}],"rawText":"El recorrido por este eje parte del concepto fundamental y los estilos comunicativos que lo contextualizan, avanza hacia las habilidades concretas que caracterizan la comunicación asertiva en el trabajo y culmina con las estrategias para dirigir equipos desde una comunicación efectiva y respetuosa. Cada apartado incorpora situaciones aplicadas al contexto organizacional colombiano para facilitar la comprensión y la transferencia de los aprendizajes a la práctica cotidiana."}},{"type":"text","name":"Los hallazgos reportados por Experior (2024) señalan que la comunicación asertiva en el ámbito laboral se expresa en momentos cotidianos que, aunque pueden parecer menores, tienen un efecto acumulativo significativo sobre la motivación y el desempeño de lo","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":5158}}},"id":"1fa5db89-34e8-4008-802a-8f8d5c55ac6c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-6549},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":330,"x":0}],[{"y":63,"from":330,"to":472,"x":0}]]}],"rawText":"Los hallazgos reportados por Experior (2024) señalan que la comunicación asertiva en el ámbito laboral se expresa en momentos cotidianos que, aunque pueden parecer menores, tienen un efecto acumulativo significativo sobre la motivación y el desempeño de los equipos. Reconocer cuándo y cómo comunicar una expectativa, ofrecer una retroalimentación constructiva o establecer un límite respetuoso define, en gran medida, la calidad del liderazgo ejercido en la organización."}},{"type":"group","name":"Grupo 1201973","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":1779}}},"id":"e6652eba-7f2e-4213-8c70-0e433ddd9183","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1169,"ty":-9928},"group":{"children":[{"type":"shape","name":"Rectángulo 467460","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"2643315e-3dfd-4fa0-82a9-0c2ace68f2e2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":603},"style":{"fill":{"type":"solid","