ke":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":46,"y2":0}}]}}]}},{"type":"shape","name":"Rectángulo 467540","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":316}}},"id":"f74a1f52-b9cb-41ff-b1b8-ca780b75cfdd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-568,"ty":-11391},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":223}},{"type":"shape","name":"Rectángulo 468346","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":4905}}},"id":"ead81df7-b3e5-4efb-9aeb-b2aca27a6250","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-568,"ty":-6802},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":223}},{"type":"text","name":"El impacto de esta competencia en las organizaciones no se manifiesta en un solo evento: se acumula en cada interacción cotidiana, en cada retroalimentación que orienta sin herir y en cada límite que se establece sin generar resentimiento. Las organizacion","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":208,"ty":2239}}},"id":"1f2c394a-2bb5-4d67-ac5e-baee73502ddf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-961,"ty":-9468},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":766},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":103,"x":0}],[{"y":39,"from":103,"to":203,"x":0}],[{"y":63,"from":203,"to":310,"x":0}],[{"y":87,"from":310,"to":412,"x":0}]]}],"rawText":"El impacto de esta competencia en las organizaciones no se manifiesta en un solo evento: se acumula en cada interacción cotidiana, en cada retroalimentación que orienta sin herir y en cada límite que se establece sin generar resentimiento. Las organizaciones que invierten en el desarrollo de esta competencia construyen culturas laborales más saludables, productivas y resilientes ante los desafíos del entorno."}},{"type":"text","name":"Para consolidar esta habilidad comunicativa en el entorno laboral, es necesario comprender primero en qué consiste y cómo se diferencia de otros estilos comunicativos que, aunque frecuentes, resultan menos efectivos y más costosos para la organización. El ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":2382}}},"id":"b90265fe-2f07-4d5f-aba0-49f483479315","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-880,"ty":-9325},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":708},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":91,"x":0}],[{"y":39,"from":91,"to":179,"x":0}],[{"y":63,"from":179,"to":275,"x":0}],[{"y":87,"from":275,"to":327,"x":0}]]}],"rawText":"Para consolidar esta habilidad comunicativa en el entorno laboral, es necesario comprender primero en qué consiste y cómo se diferencia de otros estilos comunicativos que, aunque frecuentes, resultan menos efectivos y más costosos para la organización. El siguiente apartado aborda este concepto desde sus fundamentos teóricos."}},{"type":"shape","name":"Rectángulo 467558","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":1271}}},"id":"07c39416-da4f-4969-8999-3643f1680f53","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-672,"ty":-10436},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":917,"height":100,"r":[10,10,10,10]}},{"type":"text","name":"Far far away, behind","id":"0bd96acf-54ee-4b60-b8d4-45dbe1d791e6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-879,"ty":-11041},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":666}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1123},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":149,"x":0}],[{"y":39,"from":149,"to":303,"x":0}],[{"y":63,"from":303,"to":449,"x":0}],[{"y":87,"from":449,"to":497,"x":0}]]}],"rawText":"La comprensión profunda de una competencia comunicativa requiere abordarla desde múltiples ángulos: su fundamento conceptual, sus manifestaciones en la interacción cotidiana y las estrategias que permiten aplicarla de manera efectiva en la dirección de equipos. En el contexto de la gestión del talento humano, estas tres dimensiones se articulan de manera progresiva y complementaria, de modo que cada una prepara el terreno para la siguiente. Las dimensiones que estructuran este desarrollo son:"}},{"type":"text","name":"Far far away, behind","id":"62a29232-23ff-46bd-a182-974caa1da0c7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-879,"ty":-6452},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":5255}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1123},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":149,"x":0}],[{"y":39,"from":149,"to":305,"x":0}],[{"y":63,"from":305,"to":399,"x":0}]]}],"rawText":"La comunicación asertiva no ocurre de manera espontánea: se construye a través de prácticas concretas que se ejercen día a día en la interacción con equipos, pares y superiores. Reconocer cuándo y cómo actuar en cada situación define, en gran medida, la calidad del liderazgo ejercido en la organización. Las habilidades que mayor impacto generan en la gestión del talento humano son las siguientes:"}},{"type":"text","name":"Far far away, behind","id":"01ebd233-2dc2-4434-8c76-d0eb1d433e3b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-672,"ty":-10509.5},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":1197.5}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":917},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":244,"x":0}]]}],"rawText":"Estas tres dimensiones se articulan de manera progresiva: la primera provee el marco conceptual; la segunda lo traslada a las interacciones cotidianas; y la tercera lo integra en las decisiones que definen el estilo de liderazgo organizacional."}},{"type":"text","name":"Far far away, behind","id":"9d619247-014d-4b12-ad83-5a6663409adb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-672,"ty":-10305.5},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":1401.5}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":917},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":122,"x":0}],[{"y":39,"from":122,"to":249,"x":0}],[{"y":63,"from":249,"to":376,"x":0}]]}],"rawText":"Los entornos organizacionales que promueven la comunicación asertiva registran mejoras concretas en múltiples dimensiones de la vida laboral. Según la literatura especializada, estas transformaciones inciden tanto en el desempeño individual como en los resultados colectivos. A continuación, se describen los principales efectos de la asertividad en el entorno organizacional:"}},{"type":"text","name":"Far far away, behind","id":"14c4442f-f29e-4ead-9fb0-43811bef244a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-620,"ty":-10407},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":549,"ty":1300}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":813},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":189,"x":0}]]}],"rawText":"La asertividad no es un recurso reservado para situaciones de conflicto: es una práctica cotidiana que define la calidad de las relaciones laborales y el clima organizacional a largo plazo."}},{"type":"shape","name":"Rectángulo 468344","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":3840}}},"id":"f5a0cc09-b26c-44d8-af7c-a3a313718745","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-880,"ty":-7867},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":140}},{"type":"text","name":"Comunicarse de forma asertiva no es una cuestión de temperamento ni de carácter; es una competencia que se aprende, se entrena y se fortalece con la práctica cotidiana en cada interacción laboral.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":183,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320,"ty":3912.83984375}}},"id":"a5d9a1a2-ed20-4e0c-bd3e-c50ee982074f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-849,"ty":-7794.16015625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":127,"x":-476.64788818359375}],[{"y":39,"from":127,"to":196,"x":-241.2389678955078}]]}],"rawText":"Comunicarse de forma asertiva no es una cuestión de temperamento ni de carácter; es una competencia que se aprende, se entrena y se fortalece con la práctica cotidiana en cada interacción laboral."}},{"type":"text","name":"La asertividad puede entenderse como el punto de equilibrio entre dos estilos comunicativos extremos: la pasividad y la agresividad. La persona pasiva evita expresar sus opiniones y necesidades por temor al rechazo o al conflicto, acumulando frustración y ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":2715}}},"id":"3b4fd1fb-85ef-4538-9ab4-97fc1fa077c9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-984,"ty":-8992},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":170,"x":0}],[{"y":39,"from":170,"to":333,"x":0}],[{"y":63,"from":333,"to":505,"x":0}],[{"y":87,"from":505,"to":541,"x":0}]]}],"rawText":"La asertividad puede entenderse como el punto de equilibrio entre dos estilos comunicativos extremos: la pasividad y la agresividad. La persona pasiva evita expresar sus opiniones y necesidades por temor al rechazo o al conflicto, acumulando frustración y resentimiento que eventualmente deterioran sus relaciones y su bienestar. La persona agresiva, por el contrario, expresa sus ideas y necesidades de manera impositiva, sin considerar los derechos y sentimientos de los demás, lo que genera conflictos y deteriora el clima organizacional."}},{"type":"group","name":"Grupo 1201977","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1,"ty":123}}},"id":"9c616f01-2419-4314-b9b4-faac5f3d4e10","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1168,"ty":-11584},"group":{"children":[{"type":"shape","name":"Rectángulo 467481","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","aspectLock":{"width":100,"height":100},"constraintWidth":true,"constraintHeight":true}},"id":"b6132fa3-0c0a-4987-a7e5-d8e17cd75d7b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":764,"ty":3691},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}},"width":5,"align":"outside"}},"shape":{"type":"rect","x":0,"y":0,"width":80,"height":80,"r":[40,40,40,40]}},{"type":"group","name":"Grupo 1200525","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"5226e841-fa59-4ab2-9583-35180118d409","transform":{"a":1,"b":0,"c":0,"d":1,"tx":780.8896484375,"ty":3707.8896484375},"group":{"children":[{"type":"shape","name":"Trazado 1016778","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"1d139b99-6c84-48a9-a2c8-6b66c52d50f1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2.384185791015625e-7,"ty":0},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":89}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 45.89070510864258 8.502536773681641 C 46.10384750366211 8.289396286010742 46.22120666503906 8.006020545959473 46.22120666503906 7.704589366912842 L 46.22120666503906 1.128447651863098 C 46.22120666503906 0.5061764717102051 45.71503067016602 0 45.0927619934082 0 L 41.04840469360352 0 C 40.74697494506836 0 40.46359634399414 0.1173585578799248 40.25045776367188 0.3304997384548187 L 36.79009628295898 3.790952205657959 C 36.35009002685547 4.230956554412842 36.35009002685547 4.946844100952148 36.79009628295898 5.386847972869873 L 36.98355865478516 5.58030891418457 L 36.46059036254883 6.10327672958374 C 36.22830963134766 6.079624652862549 35.99395370483398 6.068972110748291 35.76645660400391 6.070957660675049 L 28.33992004394531 6.070957660675049 C 27.71764755249023 6.070957660675049 27.21147155761719 6.57713508605957 27.21147155761719 7.199406147003174 L 27.21147155761719 7.746657848358154 C 27.21147155761719 7.912223339080811 27.22781181335449 8.073997497558594 27.25886535644531 8.230626106262207 C 25.59806251525879 9.205785751342773 24.17477416992188 10.55459594726562 23.11069107055664 12.16520690917969 C 22.04652214050293 10.55450630187988 20.62332344055176 9.205785751342773 18.96251678466797 8.230626106262207 C 18.99357223510742 8.073997497558594 19.00991249084473 7.912223339080811 19.00991249084473 7.7466578483