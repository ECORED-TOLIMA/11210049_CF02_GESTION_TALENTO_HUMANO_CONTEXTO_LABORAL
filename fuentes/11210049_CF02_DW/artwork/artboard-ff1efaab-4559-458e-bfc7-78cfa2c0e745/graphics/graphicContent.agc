de"}},"shape":{"type":"rect","x":0,"y":0,"width":560,"height":363}}]}}]}},{"type":"shape","name":"Rectángulo 468199","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":3965}}},"id":"71b6f3fa-8a90-4257-b180-eae3b1045f89","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-7742},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":248}},{"type":"shape","name":"Rectángulo 468213","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":6704}}},"id":"82108602-81ce-4925-8d79-3711a6a16040","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-5003},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":248}},{"type":"shape","name":"Rectángulo 468223","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":9591}}},"id":"3e5790c5-cc7a-46b0-88fd-383f266147af","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-2116},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":270}},{"type":"shape","name":"Rectángulo 468232","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":12142}}},"id":"499dcd51-effa-4017-80c9-9c3dd865c49b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":435},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":341}},{"type":"shape","name":"Rectángulo 468200","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":5480.83203125}}},"id":"61dfaa82-87e4-4044-a55d-2ff2fcf55bcd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-6226.16796875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":154}},{"type":"text","name":"Comunicación informativa y motivadora en una pyme de servicios\n\nEn una empresa de servicios tecnológicos, la dirección de talento humano decide reforzar la comunicación interna sobre resultados trimestrales. Para ello, integra en una misma reunión la prese","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":64,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":514,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":581,"ty":3995}}},"id":"a747cf9d-9de4-449f-bdff-e5cd137fcd15","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9796,"ty":-7712},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":62,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":63,"to":63,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":64,"to":156,"x":0}],[{"y":87,"from":156,"to":251,"x":0}],[{"y":111,"from":251,"to":346,"x":0}],[{"y":135,"from":346,"to":433,"x":0}],[{"y":159,"from":433,"to":520,"x":0}],[{"y":183,"from":520,"to":578,"x":0}]]}],"rawText":"Comunicación informativa y motivadora en una pyme de servicios\n\nEn una empresa de servicios tecnológicos, la dirección de talento humano decide reforzar la comunicación interna sobre resultados trimestrales. Para ello, integra en una misma reunión la presentación de indicadores de desempeño (función informativa) con el reconocimiento público a los equipos que cumplieron metas (función motivadora). Al vincular datos objetivos con mensajes de valoración, se fortalece la percepción de transparencia y se incrementa la disposición de los colaboradores para asumir nuevos retos."}},{"type":"text","name":"Incoherencia entre mensaje verbal y no verbal\n\nEn una entidad del sector público, un directivo comunica verbalmente su disposición al diálogo con los funcionarios, pero durante las reuniones mantiene los brazos cruzados, evita el contacto visual y responde","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":47,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":518,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":581,"ty":6734}}},"id":"0256f971-e7ef-4e0a-8a9f-f15f67598a76","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9796,"ty":-4973},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":45,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":46,"to":46,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":47,"to":142,"x":0}],[{"y":87,"from":142,"to":239,"x":0}],[{"y":111,"from":239,"to":331,"x":0}],[{"y":135,"from":331,"to":420,"x":0}],[{"y":159,"from":420,"to":510,"x":0}],[{"y":183,"from":510,"to":565,"x":0}]]}],"rawText":"Incoherencia entre mensaje verbal y no verbal\n\nEn una entidad del sector público, un directivo comunica verbalmente su disposición al diálogo con los funcionarios, pero durante las reuniones mantiene los brazos cruzados, evita el contacto visual y responde de manera evasiva a las preguntas incómodas. Aunque las palabras sugieren apertura, el lenguaje corporal transmite distancia y resistencia. Como consecuencia, los colaboradores perciben que no existe un verdadero espacio para expresar inquietudes, y se incrementa la comunicación informal cargada de rumores."}},{"type":"text","name":"Ajuste proxémico en una retroalimentación de desempeño\n\nEn una empresa del sector comercio, una coordinadora de talento humano debe brindar retroalimentación a un colaborador respecto a incumplimientos reiterados en los horarios de llegada. En lugar de abo","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":56,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":572,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":581,"ty":9621}}},"id":"acb0ae95-35b7-4e40-82ed-f413ef14f4b2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9796,"ty":-2086},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":54,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":55,"to":55,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":56,"to":140,"x":0}],[{"y":87,"from":140,"to":232,"x":0}],[{"y":111,"from":232,"to":331,"x":0}],[{"y":135,"from":331,"to":419,"x":0}],[{"y":159,"from":419,"to":510,"x":0}],[{"y":183,"from":510,"to":595,"x":0}],[{"y":207,"from":595,"to":627,"x":0}]]}],"rawText":"Ajuste proxémico en una retroalimentación de desempeño\n\nEn una empresa del sector comercio, una coordinadora de talento humano debe brindar retroalimentación a un colaborador respecto a incumplimientos reiterados en los horarios de llegada. En lugar de abordar el tema en el pasillo o frente a otros compañeros, decide realizar la conversación en un espacio privado, adecuadamente ventilado y con sillas ubicadas a una distancia que no invade la zona íntima del colaborador. Este manejo proxémico, sumado a un tono de voz sereno, reduce la actitud defensiva del colaborador y facilita que asuma compromisos de mejora concretos."}},{"type":"text","name":"Uso combinado de técnicas de comunicación efectiva\n\nEn una organización del sector salud, la jefatura de talento humano debe comunicar la implementación de un nuevo sistema de registro de turnos. Para ello, realiza primero una reunión sincrónica donde expl","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":52,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":865,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":581,"ty":12167}}},"id":"ae41a19b-3e96-4fa1-b9e0-7b3300323019","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9796,"ty":460},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":50,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":51,"to":51,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":52,"to":138,"x":0}],[{"y":87,"from":138,"to":235,"x":0}],[{"y":111,"from":235,"to":332,"x":0}],[{"y":135,"from":332,"to":426,"x":0}],[{"y":159,"from":426,"to":520,"x":0}],[{"y":183,"from":520,"to":613,"x":0}],[{"y":207,"from":613,"to":695,"x":0}],[{"y":231,"from":695,"to":790,"x":0}],[{"y":255,"from":790,"to":886,"x":0}],[{"y":279,"from":886,"to":917,"x":0}]]}],"rawText":"Uso combinado de técnicas de comunicación efectiva\n\nEn una organización del sector salud, la jefatura de talento humano debe comunicar la implementación de un nuevo sistema de registro de turnos. Para ello, realiza primero una reunión sincrónica donde explica con claridad el propósito del cambio, los pasos de implementación y los apoyos disponibles (claridad, elección adecuada del canal). Durante la reunión, abre espacios para preguntas, escucha activamente las preocupaciones de los colaboradores y las recoge para ajustar el plan de soporte (escucha activa, comunicación empática). Posteriormente, envía un instructivo escrito con los procedimientos y fechas clave, y programa sesiones de retroalimentación sobre la experiencia inicial con la nueva herramienta (refuerzo del mensaje, retroalimentación constructiva). Esta combinación de técnicas reduce la resistencia al cambio y mejora la adopción del sistema."}},{"type":"text","name":"El caso anterior demuestra que la comunicación efectiva no depende de una sola técnica, sino de la capacidad de combinarlas según el momento, el interlocutor y el propósito del mensaje. Esta flexibilidad comunicativa es una de las competencias más valorada","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":748,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":12522}}},"id":"6e0575f1-3a1d-4efe-a76a-da0546055fbc","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":815},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":163,"x":0}],[{"y":39,"from":163,"to":326,"x":0}]]}],"rawText":"El caso anterior demuestra que la comunicación efectiva no depende de una sola técnica, sino de la capacidad de combinarlas según el momento, el interlocutor y el propósito del mensaje. Esta flexibilidad comunicativa es una de las competencias más valoradas en quienes lideran y gestionan equipos dentro de las organizaciones."}},{"type":"text","name":"La comunicación no verbal (gestos, tono de voz y manejo de distancias) puede reforzar o contradecir el mensaje verbal, y es determinante en la credibilidad y la confianza que genera quien comunica.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":197,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319,"ty":5554.83203125}}},"id":"477f5eca-b42c-4220-b67f-83f6e20cff99","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10058,"ty":-6152.16796875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":124,"x":-448.12310791015625}],[{"y":39,"from":124,"to":197,"x":-267.9083251953125}]]}],"rawText":"La comunicación no verbal (gestos, tono de voz y manejo de distancias) puede reforzar o contradecir el mensaje verbal, y es determinante en la credibilidad y la confianza que genera quien comunica."}},{"type":"group","name":"Grupo 1201845","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-4,"ty":1764.9921875}}},"id":"bb55bb3f-432e-417b-ba76-1d8066132d45","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10381,"ty":-9942.0078125},"group":{"children":[{"type":"shape","name":"Rectángulo 467481","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","aspectLock":{"width":100,"height":100},"constraintWidth":true,"constraintHeight":true}},"id":"128d7796-cd16-415f-ae3c-957bdc7c2409","transform":{"a":1,"b":0,"c":0,"d":1,"tx":764,"ty":3691},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}},"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}},"width":5,"align":"outside"}},"shape":{"type":"rect","x":0,"y":0,"width":80,"height":80,"r":[40,40,40,40]}},{"type":"group","name":"Grupo 1200525","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"32841a84-4397-4682-854e-159d9b3f6bc2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":780.8896484375,"ty":3707.8896484375},"group":{"children":[{"type":"shape","name":"Trazado 1016778","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"0b0551ee-6aef-404b-853e-99da44e816d9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2.384185791015625e-7,"ty":0},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":