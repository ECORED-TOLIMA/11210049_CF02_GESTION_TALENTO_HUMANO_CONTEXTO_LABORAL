,[{"y":87,"from":273,"to":315,"x":0}]]},{"lines":[[{"y":111,"from":316,"to":316,"x":0}]]},{"lines":[[{"y":135,"from":317,"to":408,"x":0}],[{"y":159,"from":408,"to":498,"x":0}],[{"y":183,"from":498,"to":553,"x":0}]]}],"rawText":"Integrar estas técnicas de manera sistemática transforma la comunicación de un proceso improvisado en un componente planificado de la gestión. Esto se traduce en una reducción de errores, una resolución más constructiva de los conflictos y el fortalecimiento de relaciones laborales más colaborativas y respetuosas.\n\nLa aplicación simultánea de varias de estas técnicas en una misma situación organizacional multiplica su impacto. El siguiente caso ilustra cómo su uso combinado puede facilitar la implementación de un cambio significativo en el equipo:"}},{"type":"shape","name":"Image Place Holder","id":"eb8e9f32-d7e3-4f9d-bb9e-f500b4f4f42b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":888},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":12595}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":247,"g":227,"b":230}}}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":300}},{"type":"text","name":"Las técnicas de comunicación efectiva no operan de manera aislada: su verdadero alcance se evidencia cuando se aplican en el marco del trabajo colaborativo y el trabajo en equipo. La calidad de los intercambios comunicativos entre los integrantes de un equ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":226,"ty":12749}}},"id":"3eadc2bb-b3bb-4db0-9ddb-d886b8558abd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10151,"ty":1042},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":732},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":91,"x":0}],[{"y":39,"from":91,"to":194,"x":0}],[{"y":63,"from":194,"to":293,"x":0}],[{"y":87,"from":293,"to":394,"x":0}],[{"y":111,"from":394,"to":420,"x":0}]]}],"rawText":"Las técnicas de comunicación efectiva no operan de manera aislada: su verdadero alcance se evidencia cuando se aplican en el marco del trabajo colaborativo y el trabajo en equipo. La calidad de los intercambios comunicativos entre los integrantes de un equipo determina la coordinación de las tareas, la cohesión del grupo y la capacidad colectiva para alcanzar resultados que ningún individuo podría lograr por sí solo."}},{"type":"group","name":"Grupo 1201861","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1,"ty":4541}}},"id":"72cd5630-ed1a-4f88-89c5-44aa7f9bbc3f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10376,"ty":-7166},"group":{"children":[{"type":"shape","name":"Rectángulo 467590","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true}},"id":"078830f8-80d0-42af-90cd-e3d9f77ab882","transform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":8094},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[1