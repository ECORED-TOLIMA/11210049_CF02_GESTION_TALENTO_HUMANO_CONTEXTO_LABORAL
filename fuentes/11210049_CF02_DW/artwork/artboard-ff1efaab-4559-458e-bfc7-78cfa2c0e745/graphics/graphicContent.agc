[{"y":135,"from":279,"to":279,"x":0}]]},{"lines":[[{"y":159,"from":280,"to":306,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":159,"from":306,"to":395}],[{"y":183,"from":395,"to":428,"x":0}]]},{"lines":[[{"y":207,"from":429,"to":429,"x":0}]]},{"lines":[[{"y":231,"from":430,"to":468,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":231,"from":468,"to":544}],[{"y":255,"from":544,"to":575,"x":0}]]},{"lines":[[{"y":279,"from":576,"to":576,"x":0}]]},{"lines":[[{"y":303,"from":577,"to":607,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":303,"from":607,"to":694}],[{"y":327,"from":694,"to":721,"x":0}]]}],"rawText":"Reuniones de resultados: espacio para compartir cifras de desempeño y, al mismo tiempo, reconocer el trabajo del equipo en un solo mensaje. \n\nProcesos de inducción: momento para explicar normas, funciones y expectativas del cargo de forma ordenada a quien se integra al equipo. \n\nEntrevistas de desempeño: conversación para revisar qué salió bien y qué se puede mejorar, orientando a la persona sin limitarse a señalar errores. \n\nComunicados de cambio organizacional: oportunidad para explicar a los equipos por qué cambia algo en la empresa y cómo ese cambio los involucra. \n\nEspacios de retroalimentación: intercambio en el que se dice a alguien qué logró y en qué puede crecer, con ejemplos claros y un tono de apoyo. "}},{"type":"shape","name":"circle-right-solid-full","id":"9bbecec1-196a-45e6-a403-5e3643644436","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10236,"ty":-7405.9921875},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"aspectLock":{"width":512,"height":512},"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":141,"ty":4301.0078125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":71,"g":74,"b":89}}},"stroke":{"typ