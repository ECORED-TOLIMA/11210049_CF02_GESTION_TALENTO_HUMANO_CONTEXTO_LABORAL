ame":"Trazado 1020694","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"238a7b1d-c1c1-4bd1-99ff-954aaf651ee6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-160.5804443359375,"ty":-47.089969635009766},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":0,"g":0,"b":0}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 182.7610168457031 55.57095336914062 C 183.0760192871094 55.57095336914062 183.3899993896484 55.44314956665039 183.618408203125 55.19180679321289 C 184.0484924316406 54.71877288818359 184.0136566162109 53.98652267456055 183.5404968261719 53.55643463134766 C 183.0673370361328 53.12635040283203 182.3353271484375 53.16119766235352 181.9051208496094 53.63434982299805 L 181.904541015625 53.63492965698242 C 181.4744567871094 54.10796737670898 181.5096435546875 54.83986663818359 181.9826965332031 55.26995468139648 C 182.2046203613281 55.47150802612305 182.4831695556641 55.57095336914062 182.7610168457031 55.57095336914062 Z"}},{"type":"shape","name":"Trazado 1020695","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true}},"id":"194d9134-ddb3-4b58-9de4-2a8fba0bc131","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-274.2670593261719,"ty":-249.19802856445312},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":0,"g":0,"b":0}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 312.4907531738281 282.9826965332031 C 312.4907531738281 282.3433227539062 311.9723205566406 281.8250122070312 311.3330383300781 281.8250122070312 L 311.3322143554688 281.8250122070312 C 310.6929321289062 281.8250122070312 310.1749877929688 282.3433227539062 310.1749877929688 282.9826965332031 C 310.1749877929688 283.6221008300781 310.6936645507812 284.1404113769531 311.3330383300781 284.1404113769531 C 311.9724426269531 284.1404113769531 312.4907531738281 283.6221008300781 312.4907531738281 282.9826965332031 Z"}}]}}]}}]}},{"type":"text","name":"La decisión de elegir un espacio privado, adoptar una distancia adecuada y mantener un tono sereno no es casual: responde al reconocimiento de que el entorno físico y el lenguaje no verbal condicionan la disposición del interlocutor y determinan, en buena ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":9891}}},"id":"02865eb0-73b0-4050-8a09-2484396e04a0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191,"ty":-1816},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915.6298828125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":125,"x":0}],[{"y":39,"from":125,"to":250,"x":0}],[{"y":63,"from":250,"to":319,"x":0}]]}],"rawText":"La decisión de elegir un espacio privado, adoptar una distancia adecuada y mantener un tono sereno no es casual: responde al reconocimiento de que el entorno físico y el lenguaje no verbal condicionan la disposición del interlocutor y determinan, en buena medida, si el mensaje se recibe con apertura o con resistencia."}},{"type":"text","name":"El dominio de técnicas de comunicación efectiva es una competencia transversal para quienes gestionan equipos en entornos organizacionales. Comunicarse de forma efectiva implica formular mensajes claros, utilizar canales adecuados, promover la participació","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":10350}}},"id":"3573230a-f3f6-4fa0-b6de-fdcd332b4dd2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191,"ty":-1357},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":161,"x":0}],[{"y":39,"from":161,"to":334,"x":0}],[{"y":63,"from":334,"to":359,"x":0}]]}],"rawText":"El dominio de técnicas de comunicación efectiva es una competencia transversal para quienes gestionan equipos en entornos organizacionales. Comunicarse de forma efectiva implica formular mensajes claros, utilizar canales adecuados, promover la participación de los interlocutores, verificar la comprensión y ofrecer retroalimentación orientada al aprendizaje."}},{"type":"text","name":"Cada uno de estos escenarios exige del gestor de talento humano una respuesta comunicativa distinta: no existe una fórmula única que funcione en todas las situaciones. Lo que determina la efectividad es la capacidad de leer el contexto, identificar las nec","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":11084}}},"id":"a5bc0ddf-2509-4979-84f3-b0e6dc52fa81","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191,"ty":-623},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":323,"x":0}]]},{"lines":[[{"y":63,"from":324,"to":324,"x":0}]]},{"lines":[[{"y":87,"from":325,"to":487,"x":0}],[{"y":111,"from":487,"to":560,"x":0}]]}],"rawText":"Cada uno de estos escenarios exige del gestor de talento humano una respuesta comunicativa distinta: no existe una fórmula única que funcione en todas las situaciones. Lo que determina la efectividad es la capacidad de leer el contexto, identificar las necesidades del momento y responder con claridad, empatía y precisión.\n\nEl desarrollo de estas habilidades se apoya en un conjunto de técnicas que pueden incorporarse de manera progresiva a la práctica profesional. A continuación, se presentan las más relevantes en el contexto de la gestión organizacional:"}},{"type":"text","name":"En la práctica cotidiana, la comunicación efectiva se pone a prueba en momentos clave de la gestión. Los siguientes escenarios representan situaciones frecuentes en las que el uso adecuado de las técnicas comunicativas resulta determinante:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":10757}}},"id":"9b4c4263-5711-4fcf-8e7f-addebed12352","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191,"ty":-950},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":169,"x":0}],[{"y":39,"from":169,"to":240,"x":0}]]}],"rawText":"En la práctica cotidiana, la comunicación efectiva se pone a prueba en momentos clave de la gestión. Los siguientes escenarios representan situaciones frecuentes en las que el uso adecuado de las técnicas comunicativas resulta determinante:"}},{"type":"shape","name":"Rectángulo 468225","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":9978}}},"id":"02e842df-b983-4e13-a4cd-fc3337dd43db","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":-1729},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":130}},{"type":"text","name":"El dominio de estas dimensiones no verbales alcanza su mayor potencial cuando se integra con el uso deliberado de técnicas de comunicación verbal. La comunicación efectiva en el trabajo surge precisamente de esta articulación: de saber no solo qué comunica","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":221,"ty":10009}}},"id":"5e1665e7-a893-4c22-84bd-9be6c57ba2f7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10156,"ty":-1698},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":846},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":114,"x":0}],[{"y":39,"from":114,"to":230,"x":0}],[{"y":63,"from":230,"to":328,"x":0}]]}],"rawText":"El dominio de estas dimensiones no verbales alcanza su mayor potencial cuando se integra con el uso deliberado de técnicas de comunicación verbal. La comunicación efectiva en el trabajo surge precisamente de esta articulación: de saber no solo qué comunicar, sino cómo hacerlo, en qué momento y con qué actitud corporal y vocal."}},{"type":"group","name":"Enmascarar grupo 1119409","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468226","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"69b28263-a8b6-4bec-83e5-3e8ad89de414","transform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":7636},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":291,"height":217,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":936,"ty":2255}}},"id":"f630f80e-7e08-487a-9b9e-c7fb0ee5813a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9441,"ty":-9452},"group":{"children":[{"type":"shape","name":"Imagen 170",