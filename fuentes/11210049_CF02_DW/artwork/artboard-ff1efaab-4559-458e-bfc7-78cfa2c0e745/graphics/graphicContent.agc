y":2873},"style":{"fill":{"type":"pattern","pattern":{"width":650,"height":434,"meta":{"ux":{"scaleBehavior":"fill","uid":"f7cf2452f6847118b819645e6e322f25","hrefLastModifiedDate":1787672969,"flipX":true}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":615,"height":410.6307678222656}}]}},{"type":"group","name":"Right","id":"54168b97-ab72-43c0-89f6-5144d16ebbbd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9691.5,"ty":-1220},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":685.5,"ty":10487}}},"group":{"children":[{"type":"shape","name":"BG","id":"468b22e3-6ef2-4fb6-a274-8017025a80ee","meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":250,"g":251,"b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":684.900390625,"height":200}}]}},{"type":"text","name":"En el contexto de la gestión del talento humano, la comunicación efectiva no es una habilidad innata ni espontánea: se construye mediante la aplicación consciente de técnicas que permiten adaptar el mensaje a la situación, al interlocutor y al propósito de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":713,"ty":10518}}},"id":"0a31039b-11d5-4dae-afee-46668d5c64f9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9664,"ty":-1189},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":632},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":84,"x":0}],[{"y":39,"from":84,"to":166,"x":0}],[{"y":63,"from":166,"to":257,"x":0}],[{"y":87,"from":257,"to":342,"x":0}],[{"y":111,"from":342,"to":429,"x":0}],[{"y":135,"from":429,"to":460,"x":0}]]}],"rawText":"En el contexto de la gestión del talento humano, la comunicación efectiva no es una habilidad innata ni espontánea: se construye mediante la aplicación consciente de técnicas que permiten adaptar el mensaje a la situación, al interlocutor y al propósito de cada intercambio. Su dominio marca una diferencia significativa en la calidad de las relaciones laborales, en la resolución de conflictos y en la capacidad del equipo para alcanzar resultados colectivos."}},{"type":"shape","name":"Trazado 1016667","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":10831.611328125}}},"id":"74aa3bb2-df4c-4ad6-811e-df03957bf7d4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-875.388671875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":247,"g":227,"b":230}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020 0 L 1020 215.3535003662109 L 0 215.3535003662109 L 0 0 Z"}},{"type":"text","name":"Reuniones de equipo en las que se deben alinear expectativas y resolver dudas sobre un proceso en curso.\nConversaciones de retroalimentación individual en las que se abordan fortalezas y oportunidades de mejora.\nComunicados de cambio organizacional que exi","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":350.37109375,"ty":10863.96875}}},"id":"ab5d6a20-4180-40c6-80d2-df027cedc2a7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10026.62890625,"ty":-843.03125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":34}},"text":{"frame":{"type":"autoHeight","width":893},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":104,"x":0}]]},{"lines":[[{"y":49,"from":105,"to":211,"x":0}]]},{"lines":[[{"y":83,"from":212,"to":308,"x":0}]]},{"lines":[[{"y":117,"from":309,"to":425,"x":0}]]},{"lines":[[{"y":151,"from":426,"to":549,"x":0}]]}],"rawText":"Reuniones de equipo en las que se deben alinear expectativas y resolver dudas sobre un proceso en curso.\nConversaciones de retroalimentación individual en las que se abordan fortalezas y oportunidades de mejora.\nComunicados de cambio organizacional que exigen claridad, empatía y elección del canal adecuado.\nSituaciones de conflicto en las que escuchar activamente y responder con asertividad evita la escalada del problema.\nProcesos de inducción en los que la precisión del mensaje reduce la incertidumbre del colaborador que se integra al equipo."}},{"type":"shape","name":"Rectángulo 467591","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":316,"ty":10860.611328125}}},"id":"c5155b09-d98f-4764-a42b-c8c4dda48d53","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10061,"ty":-846.388671875},"style":{"fill":{"type":