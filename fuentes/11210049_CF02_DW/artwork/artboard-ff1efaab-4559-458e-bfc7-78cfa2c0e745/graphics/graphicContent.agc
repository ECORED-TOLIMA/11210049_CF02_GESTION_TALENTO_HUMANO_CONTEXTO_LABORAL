":405,"height":272}}]}},{"type":"text","name":"En la gestión de personas, la comunicación no solo transmite instrucciones o reportes, sino que se convierte en un recurso estratégico que permite alinear expectativas, clarificar roles, retroalimentar desempeños, gestionar emociones colectivas y sostener ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.6298828125,"ty":516.5}}},"id":"3229d746-e863-45ec-97db-27e2321cf7ca","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191.3701171875,"ty":-11190.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915.3701171875},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":123,"x":0}],[{"y":39,"from":123,"to":247,"x":0}],[{"y":63,"from":247,"to":371,"x":0}],[{"y":87,"from":371,"to":465,"x":0}]]}],"rawText":"En la gestión de personas, la comunicación no solo transmite instrucciones o reportes, sino que se convierte en un recurso estratégico que permite alinear expectativas, clarificar roles, retroalimentar desempeños, gestionar emociones colectivas y sostener la cultura organizacional en el tiempo. Por ello, quien gestiona personas requiere comprender la comunicación como un proceso complejo, sistémico y bidireccional, en el que intervienen múltiples factores como:"}},{"type":"shape","name":"Rectángulo 468153","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":316}}},"id":"750b78ee-3083-44b5-8119-50b581f3fc6f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":-11391},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":247,"g":227,"b":230}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":170,"r":[10,10,10,10]}},{"type":"shape","name":"Rectángulo 468154","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":1529}}},"id":"adc9f976-b95f-4214-b09b-a0ab89452df5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9776,"ty":-10178},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":190,"r":[10,10,10,10]}},{"type":"text","name":"Se trata del conjunto de procesos mediante los cuales fluye la información entre los integrantes de una organización y el entorno en el que se desarrolla, con el propósito de coordinar acciones, construir significados compartidos y orientar el comportamien","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":223.6298828125,"ty":344}}},"id":"daea8c14-443a-46ba-ac5f-6109be2452e5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10153.3701171875,"ty":-11363},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":839},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":117,"x":0}],[{"y":39,"from":117,"to":232,"x":0}],[{"y":63,"from":232,"to":352,"x":0}],[{"y":87,"from":352,"to":462,"x":0}],[{"y":111,"from":462,"to":552,"x":0}]]}],"rawText":"Se trata del conjunto de procesos mediante los cuales fluye la información entre los integrantes de una organización y el entorno en el que se desarrolla, con el propósito de coordinar acciones, construir significados compartidos y orientar el comportamiento colectivo hacia el logro de los objetivos institucionales. Más allá de la simple transmisión de datos, este proceso implica la interpretación, la negociación de sentidos, la gestión de percepciones y la construcción de relaciones de confianza entre los diferentes actores que participan en él."}},{"type":"group","name":"Enmascarar grupo 1119375","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 467756","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"31586e82-8d26-47cc-9955-96111528da8d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":3058},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":239}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-1529}}},"id":"ab745913-518c-427f-b03a-3d75696e339e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10377,"ty":-13236},"group":{"children":[{"type":"shape","name":"Imagen 160","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":550,"height":308}}},"id":"22a9470e-a7d2-454d-8008-177688065293","transform":{"a":1,"b":0,"c":0,"d":1,"tx":158,"ty":3051},"style":{"fill":{"type":"pattern","pattern":{"width":550,"height":308,"meta":{"ux":{"scaleBehavior":"fill","uid":"da491c3bff76393cc04e9ee4ebf5238b","hrefLastModifiedDate":1787672969}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":443,"height":248}}]}},{"type":"text","name":"Desde una perspectiva clásica, la comunicación puede describirse como el proceso mediante el cual un emisor codifica y transmite un mensaje a un receptor, a través de un canal y en un contexto determinado, esperando una respuesta o una comprensión comparti","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":630,"ty":1555}}},"id":"38f5bf4e-f3c2-45cb-8d91-9eb634c4e0f1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9747,"ty":-10152},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":754},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":101,"x":0}],[{"y":39,"from":101,"to":206,"x":0}],[{"y":63,"from":206,"to":300,"x":0}],[{"y":87,"from":300,"to":403,"x":0}],[{"y":111,"from":403,"to":510,"x":0}],[{"y":135,"from":510,"to":571,"x":0}]]}],"rawText":"Desde una perspectiva clásica, la comunicación puede describirse como el proceso mediante el cual un emisor codifica y transmite un mensaje a un receptor, a través de un canal y en un contexto determinado, esperando una respuesta o una comprensión compartida. Sin embargo, este modelo lineal resulta insuficiente para explicar la complejidad de la comunicación en las organizaciones actuales, donde los mensajes circulan en múltiples direcciones, utilizan diversos medios y se interpretan a la luz de culturas organizacionales, experiencias previas y relaciones de poder."}},{"type":"text","name":"En el contexto organizacional, suelen distinguirse los siguientes componentes básicos del proceso comunicativo:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":602,"ty":1749}}},"id":"d515bb90-fb07-44b3-a8c9-1be4efd335ce","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9775,"ty":-9958},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":811},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":111,"x":0}]]}],"rawText":"En el contexto organizacional, suelen distinguirse los siguientes componentes básicos del proceso comunicativo:"}},{"type":"group","name":"Dots 4","id":"b023067d-90df-4e51-9c82-20e303c52e6b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10070.857421875,"ty":-9656.779296875},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constr