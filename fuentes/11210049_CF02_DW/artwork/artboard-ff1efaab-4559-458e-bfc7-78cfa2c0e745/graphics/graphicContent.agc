":193}}}},"shape":{"type":"path","path":"M 64.29690551757812 95.1080322265625 C 63.39088821411133 95.1080322265625 62.47790908813477 94.92213439941406 61.6013298034668 94.54967498779297 C 57.99544143676758 93.01943969726562 56.12087631225586 88.75131988525391 57.42252731323242 85.0352783203125 C 57.55582809448242 84.65554046630859 57.97161483764648 84.45573425292969 58.35103225708008 84.58871459960938 C 58.73077011108398 84.72168731689453 58.93090438842773 85.13715362548828 58.79792404174805 85.51722717285156 C 57.74536514282227 88.52208709716797 59.2580451965332 91.97251129150391 62.17061996459961 93.20866394042969 C 63.55562210083008 93.79647827148438 65.05043029785156 93.79647827148438 66.37953186035156 93.20899963378906 C 67.72120666503906 92.61590576171875 68.73835754394531 91.49519348144531 69.24346923828125 90.05263519287109 C 69.37680053710938 89.67289733886719 69.79191589355469 89.47310638427734 70.1719970703125 89.6060791015625 C 70.55172729492188 89.73905181884766 70.75186157226562 90.15451049804688 70.61888122558594 90.53459167480469 C 69.97880554199219 92.36085510253906 68.68280029296875 93.78422546386719 66.96865844726562 94.54173278808594 C 66.11491394042969 94.91915893554688 65.20956420898438 95.1080322265625 64.29690551757812 95.1080322265625"}}]}}]}}]}},{"type":"text","name":"Far far away, behind","id":"a493205a-4c66-4c50-93f7-f8de0c1d8938","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9639,"ty":-8045},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":738,"ty":3662}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":647},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":82,"x":0}],[{"y":39,"from":82,"to":164,"x":0}],[{"y":63,"from":164,"to":251,"x":0}],[{"y":87,"from":251,"to":334,"x":0}],[{"y":111,"from":334,"to":342,"x":0}]]}],"rawText":"Estas cinco funciones no actúan de manera independiente: en la práctica, un mismo mensaje puede informar, regular y motivar de forma simultánea. Comprender cómo se interrelacionan facilita al gestor de talento humano diseñar estrategias comunicativas coherentes con el propósito de la organización y con las necesidades reales de los equipos."}},{"type":"text","name":"Far far away, behind","id":"f4620e49-ba0e-4cd6-916f-a56c2c78b083","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9647,"ty":-6534},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":730,"ty":5173}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":655},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":83,"x":0}],[{"y":39,"from":83,"to":169,"x":0}],[{"y":63,"from":169,"to":251,"x":0}],[{"y":87,"from":251,"to":315,"x":0}]]}],"rawText":"En las organizaciones se distingue, de manera general, entre comunicación verbal y comunicación no verbal. Aunque esta separación tiene fines didácticos, en la práctica ambas dimensiones se presentan de forma simultánea y su coherencia o incoherencia influye significativamente en la interpretación de los mensajes."}},{"type":"text","name":"Far far away, behind","id":"a8f14790-31ca-40e9-bd7f-8676d952cb41","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9776,"ty":-7878},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":3829}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":112,"x":0}],[{"y":39,"from":112,"to":220,"x":0}],[{"y":63,"from":220,"to":241,"x":0}]]}],"rawText":"El siguiente caso ilustra cómo dos funciones de la comunicación organizacional, la informativa y la motivadora, pueden integrarse en una misma acción de gestión del talento humano, con efectos positivos en el clima y el desempeño del equipo."}},{"type":"text","name":"Far far away, behind","id":"95f56674-fa24-414b-9089-747930983b1c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9776,"ty":-6379},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":5328}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":109,"x":0}],[{"y":39,"from":109,"to":222,"x":0}],[{"y":63,"from":222,"to":329,"x":0}],[{"y":87,"from":329,"to":371,"x":0}]]}],"rawText":"La comunicación verbal comprende los mensajes expresados mediante palabras, ya sea de manera oral o escrita. En el ámbito organizacional, incluye conversaciones informales, reuniones formales, entrevistas, presentaciones, comunicaciones por teléfono o videoconferencia, correos electrónicos, informes, manuales, políticas, chats corporativos y documentos institucionales."}},{"type":"text","name":"Far far away, behind","id":"c8d027b8-2035-4b91-8f7b-7b586973a416","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-7464},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":4243}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1020},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":136,"x":0}],[{"y":39,"from":136,"to":271,"x":0}],[{"y":63,"from":271,"to":349,"x":0}]]}],"rawText":"Este tipo de integración comunicativa demuestra que las funciones no son compartimentos separados, sino recursos complementarios que el gestor de talento humano puede combinar según las necesidades del equipo y el propósito de cada momento organizacional. Las siguientes situaciones ilustran cuándo y cómo aplicar cada función de manera estratégica:"}},{"type":"group","name":"Grupo 1201841","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-3068}}},"id":"f7711a49-46b7-46f2-8583-aa0ffa9accc6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10377,"ty":-14775},"group":{"children":[{"type":"shape","name":"Rectángulo 467486","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true}},"id":"9ef0e675-0762-449a-81ee-7f48fa2606a6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":627,"ty":6745},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1200599","meta":{"ux":{"nameL10N":"SH