agraphs":[{"lines":[[{"y":17,"from":0,"to":22,"x":-102.91340637207031}]]}],"rawText":"Comunicación proxémica"}},{"type":"text","name":"Feature One","id":"fd20cf43-7bab-4d7d-a89f-e1f0cd69dc89","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9328,"ty":-2976.0078125},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1049,"ty":8730.9921875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":28,"x":-120.70123291015625}]]}],"rawText":"Comunicación paralingüística"}},{"type":"text","name":"Far far away, behind","id":"ef3888d5-1344-4edd-85a5-1f135aa3a3c4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10151,"ty":-2919.396484375},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":226,"ty":8787.603515625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":40,"x":0}],[{"y":39,"from":40,"to":79,"x":0}],[{"y":63,"from":79,"to":123,"x":0}],[{"y":87,"from":123,"to":170,"x":0}],[{"y":111,"from":170,"to":215,"x":0}],[{"y":135,"from":215,"to":254,"x":0}],[{"y":159,"from":254,"to":300,"x":0}],[{"y":183,"from":300,"to":339,"x":0}],[{"y":207,"from":339,"to":352,"x":0}]]}],"rawText":"Estudia los movimientos del cuerpo, los gestos y las expresiones faciales como portadores de significado en la interacción humana. Incluye la postura, la orientación del cuerpo, el contacto visual y los movimientos de manos. En el entorno laboral, estos elementos pueden reforzar la credibilidad del comunicador o generar distancia con el interlocutor."}},{"type":"text","name":"Far far away, behind","id":"3825f05f-d2f7-4306-b1d3-0a2b7e07bfb6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9738.5,"ty":-2919.396484375},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":638.5,"ty":8787.603515625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":40,"x":0}],[{"y":39,"from":40,"to":74,"x":0}],[{"y":63,"from":74,"to":118,"x":0}],[{"y":87,"from":118,"to":152,"x":0}],[{"y":111,"from":152,"to":200,"x":0}],[{"y":135,"from":200,"to":241,"x":0}],[{"y":159,"from":241,"to":287,"x":0}],[{"y":183,"from":287,"to":326,"x":0}],[{"y":207,"from":326,"to":350,"x":0}]]}],"rawText":"Analiza el uso del espacio físico y las distancias interpersonales en las interacciones. La distancia que se mantiene durante una conversación comunica información sobre el tipo de relación, el nivel de confianza y las normas culturales del entorno. En las organizaciones, el diseño del espacio también influye en la dinámica comunicativa del equipo."}},{"type":"text","name":"Far far away, behind","id":"107a6eb3-8797-4e02-873a-e9262d1b8bec","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9328,"ty":-2919.396484375},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1049,"ty":8787.603515625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":34,"x":0}],[{"y":39,"from":34,"to":71,"x":0}],[{"y":63,"from":71,"to":118,"x":0}],[{"y":87,"from":118,"to":159,"x":0}],[{"y":111,"from":159,"to":198,"x":0}],[{"y":135,"from":198,"to":237,"x":0}],[{"y":159,"from":237,"to":282,"x":0}],[{"y":183,"from":282,"to":319,"x":0}]]}],"rawText":"Examina los elementos vocales que acompañan el habla sin pertenecer al lenguaje verbal en sí: el tono, el volumen, el ritmo, las pausas y los silencios. Estos componentes modulan el significado del mensaje y revelan estados emocionales, actitudes e intenciones que las palabras por sí solas no siempre logran expresar. "}},{"type":"shape","name":"Image Place Holder","id":"e5e81772-931e-4bbf-a500-66ff419f45cc","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-2511},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":9196}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":247,"g":227,"b":230}}}},"shape":{"type":"rect","x":0,"y":0,"width":708,"height":270}},{"type":"text","name":"La aplicación efectiva de estas dimensiones no es automática: requiere observación, práctica y disposición para ajustar los propios patrones comunicativos. Quien gestiona personas no solo debe conocer estas categorías, sino también reconocerlas en tiempo r","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":329,"ty":9350}}},"id":"7f316690-af51-4fc3-a691-a17e258e6258","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10048,"ty":-2357},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":639},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":84,"x":0}],[{"y":39,"from":84,"to":171,"x":0}],[{"y":63,"from":171,"to":255,"x":0}],[{"y":87,"from":255,"to":319,"x":0}]]}],"rawText":"La aplicación efectiva de estas dimensiones no es automática: requiere observación, práctica y disposición para ajustar los propios patrones comunicativos. Quien gestiona personas no solo debe conocer estas categorías, sino también reconocerlas en tiempo real durante las interacciones cotidianas con los colaboradores."}},{"type":"text","name":"El desconocimiento de estas dimensiones puede llevar a interpretaciones erróneas o a la reproducción involuntaria de señales que generan distancia y desconfianza. En contraste, cuando el gestor ajusta de manera consciente sus gestos, el uso del espacio y e","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":9494}}},"id":"63f44136-86e9-4c48-b945-724dcd36c44d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":-2213},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":166,"x":0}],[{"y":39,"from":166,"to":340,"x":0}],[{"y":63,"from":340,"to":470,"x":0}]]}],"rawText":"El desconocimiento de estas dimensiones puede llevar a interpretaciones erróneas o a la reproducción involuntaria de señales que generan distancia y desconfianza. En contraste, cuando el gestor ajusta de manera consciente sus gestos, el uso del espacio y el tono de voz, fortalece la efectividad de sus mensajes y contribuye al cuidado del clima organizacional. El siguiente caso ilustra cómo este ajuste transforma el resultado de una conversación de retroalimentación:"}},{"type":"group","name":"Grupo 1201853","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":104,"ty":1142}}},"id":"a57f2f49-efab-4582-bbd5-4b4b9d62b201","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10273,"ty":-10565},"group":{"children":[{"type":"shape","name":"Rectángulo 467590","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true}},"id":"05339fcd-ee31-43ac-bb24-abb4bea0de29","transform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":8094},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1202139","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"7a5d3e2a-6842-42f0-97eb-f237fb28ffbb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":237.35336303710938,"ty":8106.36181640625},"group":{"children":[{"type":"group","name":"Grupo 1202137","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"f5c576a2-aaa4-4312-ac76-28daf8985abe","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1.1677324771881104,"ty":1.1577036380767822},"group":{"children":[{"type":"shape","name":"Trazado 1020683","meta":{"ux":{"nameL10N":"SHAP