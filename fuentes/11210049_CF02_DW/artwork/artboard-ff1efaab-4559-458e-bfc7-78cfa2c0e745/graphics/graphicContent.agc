"ty":7650}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":759},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":99,"x":0}],[{"y":39,"from":99,"to":205,"x":0}],[{"y":63,"from":205,"to":304,"x":0}],[{"y":87,"from":304,"to":386,"x":0}]]}],"rawText":"La gestión efectiva de personas requiere, además del dominio de la comunicación escrita y oral, la capacidad de leer e interpretar las señales no verbales que circulan en los equipos de trabajo. Reconocer una postura cerrada, un silencio prolongado o una mirada esquiva puede ofrecer información valiosa sobre el clima del grupo y anticipar situaciones que aún no han sido verbalizadas."}},{"type":"text","name":"Far far away, behind","id":"c5fb452a-93d2-47f6-93dd-2dca581a1555","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10191,"ty":-3907},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":7800}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":212,"x":0}],[{"y":63,"from":212,"to":326,"x":0}],[{"y":87,"from":326,"to":380,"x":0}]]}],"rawText":"Profundizar en la coherencia entre el mensaje verbal y las señales no verbales implica conocer con mayor detalle los sistemas a través de los cuales opera la comunicación no verbal. La comunicación kinésica y la paralingüística son dos de esos sistemas, y su comprensión resulta clave para interpretar con mayor exactitud las interacciones cotidianas en el entorno organizacional."}},{"type":"group","name":"Enmascarar grupo 1119406","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468216","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"bad0985b-e656-4117-b603-f3454934faa6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1017,"ty":5078},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":235,"g":185,"b":193}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":271,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1,"ty":2542}}},"id":"8026aba7-ba78-448c-b972-0f1aeebd49b9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10376,"ty":-9165},"group":{"children":[{"type":"shape","name":"Imagen 135","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":734,"height":492}}},"id":"db79037b-baf3-4964-8e49-ffada7c8809d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":981,"ty":5075},"style":{"fill":{"type":"pattern","pattern":{"width":734,"height":492,"meta":{"ux":{"scaleBehavior":"fill","uid":"d2fe5fd578bc36e806b419e327f27379","hrefLastModifiedDate":1787157488,"flipX":true}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":449,"height":300.9645690917969}}]}},{"type":"text","name":"En toda interacción laboral, la comunicación va más allá de las palabras. El cuerpo expresa actitudes a través de gestos y posturas; la voz transmite emociones mediante el tono, el volumen y las pausas; el espacio físico condiciona la disposición de quiene","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":8133}}},"id":"9023008a-7b6e-43cd-a210-62464bed1cb4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9880,"ty":-3574},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915.6298828125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":123,"x":0}],[{"y":39,"from":123,"to":250,"x":0}],[{"y":63,"from":250,"to":369,"x":0}],[{"y":87,"from":369,"to":427,"x":0}]]}],"rawText":"En toda interacción laboral, la comunicación va más allá de las palabras. El cuerpo expresa actitudes a través de gestos y posturas; la voz transmite emociones mediante el tono, el volumen y las pausas; el espacio físico condiciona la disposición de quienes interactúan. Estas señales operan de manera simultánea al mensaje verbal y tienen un efecto directo en cómo se interpreta lo que se dice en cada contexto organizacional."}},{"type":"text","name":"Dentro de la comunicación no verbal, se distinguen tres dimensiones especialmente relevantes para la gestión de personas en las organizaciones. Cada una opera sobre un canal distinto y aporta información complementaria que enriquece o, en ocasiones, contra","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8424}}},"id":"4768a2c1-4893-4010-b8f8-4e3718e62be5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10192,"ty":-3283},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":293,"x":0}]]}],"rawText":"Dentro de la comunicación no verbal, se distinguen tres dimensiones especialmente relevantes para la gestión de personas en las organizaciones. Cada una opera sobre un canal distinto y aporta información complementaria que enriquece o, en ocasiones, contradice el contenido del mensaje verbal:"}},{"type":"text","name":"Estas tres dimensiones actúan de manera simultánea e interdependiente durante cualquier intercambio. Conocerlas permite identificar señales de tensión o apertura en el equipo y ajustar la propia comunicación para transmitir mensajes más coherentes. En la g","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":9082}}},"id":"efe0ae29-70e0-4f43-b5f4-7af934af0769","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10088,"ty":-2625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":153,"x":0}],[{"y":39,"from":153,"to":309,"x":0}],[{"y":63,"from":309,"to":393,"x":0}]]}],"rawText":"Estas tres dimensiones actúan de manera simultánea e interdependiente durante cualquier intercambio. Conocerlas permite identificar señales de tensión o apertura en el equipo y ajustar la propia comunicación para transmitir mensajes más coherentes. En la gestión del talento humano, esta habilidad se traduce en una lectura más precisa de las situaciones interpersonales en el entorno laboral."}},{"type":"shape","name":"Rectángulo 468217","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":8254}}},"id":"578eb5bd-fe81-4165-8d61-9c177ca6a04d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9880,"ty":-3453},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":140}},{"type":"text","name":"Para el gestor de talento humano, desarrollar sensibilidad frente a estas señales representa una ventaja concreta en la práctica diaria. Quien reconoce una postura cerrada en una reunión, detecta un tono de voz cargado de tensión o advierte que el espacio ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":522,"ty":8279}}},"id":"12878cce-ba72-4edf-a4d0-1515c01a3a65","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9855,"ty":-3428},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":866},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":120,"x":0}],[{"y":39,"from":120,"to":241,"x":0}],[{"y":63,"from":241,"to":357,"x":0}],[{"y":87,"from":357,"to":468,"x":0}]]}],"rawText":"Para el gestor de talento humano, desarrollar sensibilidad frente a estas señales representa una ventaja concreta en la práctica diaria. Quien reconoce una postura cerrada en una reunión, detecta un tono de voz cargado de tensión o advierte que el espacio de trabajo genera distancia entre los interlocutores, cuenta con información valiosa para intervenir oportunamente, ajustar su estilo comunicativo y favorecer intercambios más abiertos, respetuosos y productivos."}},{"type":"group","name":"Enmascarar grupo 1119407","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468218","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"fbef00f4-e13f-4dba-ba60-9cc96cb0e687","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":316},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":23