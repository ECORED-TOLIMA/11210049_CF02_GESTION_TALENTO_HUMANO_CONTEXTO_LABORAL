iones que el equipo ya tiene en mente antes de c","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":316,"ty":8865.943359375}}},"id":"be69a542-343c-43e0-9aa5-4c44b65375f7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3779,"ty":-2841.056640625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":38,"x":-129.30978393554688}],[{"y":39,"from":38,"to":71,"x":-113.47151947021484}],[{"y":63,"from":71,"to":109,"x":-128.03196716308594}],[{"y":87,"from":109,"to":140,"x":-107.40808868408203}],[{"y":111,"from":140,"to":175,"x":-124.90604400634766}],[{"y":135,"from":175,"to":203,"x":-98.60591125488281}],[{"y":159,"from":203,"to":240,"x":-128.82884216308594}],[{"y":183,"from":240,"to":269,"x":-110.99700164794922}],[{"y":207,"from":269,"to":286,"x":-54.73750305175781}]]}],"rawText":"Consiste en describir con claridad la situación que se desea resolver, identificando sus características, su alcance y a quiénes afecta. Es fundamental evitar confundirlo con sus síntomas visibles o con soluciones que el equipo ya tiene en mente antes de comprender su naturaleza real. "}},{"type":"text","name":"Implica ir más allá de los efectos observables para descubrir los factores que originan el problema. Herramientas como el diagrama de Ishikawa o la técnica de los cinco porqués ayudan al equipo a distinguir entre síntomas superficiales y causas estructural","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":662,"ty":8865.943359375}}},"id":"92a7c8be-eb8a-45bc-a440-c4af60713fd0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3433,"ty":-2841.056640625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":35,"x":-117.31230163574219}],[{"y":39,"from":35,"to":66,"x":-109.36121368408203}],[{"y":63,"from":66,"to":101,"x":-122.00370788574219}],[{"y":87,"from":101,"to":134,"x":-125.60041809082031}],[{"y":111,"from":134,"to":169,"x":-119.42166900634766}],[{"y":135,"from":169,"to":207,"x":-133.31761169433594}],[{"y":159,"from":207,"to":245,"x":-134.379638671875}],[{"y":183,"from":245,"to":273,"x":-97.48091125488281}],[{"y":207,"from":273,"to":295,"x":-72.5289077758789}]]}],"rawText":"Implica ir más allá de los efectos observables para descubrir los factores que originan el problema. Herramientas como el diagrama de Ishikawa o la técnica de los cinco porqués ayudan al equipo a distinguir entre síntomas superficiales y causas estructurales que requieren intervención directa. "}},{"type":"text","name":"Corresponde a la etapa de producción de ideas, en la que el equipo propone el mayor número posible de opciones sin filtrarlas ni descartarlas de antemano. La suspensión del juicio en esta fase amplía el espectro de posibilidades y favorece la aparición de ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1007,"ty":8885.943359375}}},"id":"87889152-75a2-4fc0-808e-8483081d1f59","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3088,"ty":-2821.056640625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":37,"x":-135.621826171875}],[{"y":39,"from":37,"to":75,"x":-131.96212768554688}],[{"y":63,"from":75,"to":111,"x":-133.38307189941406}],[{"y":87,"from":111,"to":145,"x":-107.54574584960938}],[{"y":111,"from":145,"to":183,"x":-136.48165893554688}],[{"y":135,"from":183,"to":215,"x":-111.45542907714844}],[{"y":159,"from":215,"to":253,"x":-129.57931518554688}],[{"y":183,"from":253,"to":281,"x":-101.04731750488281}],[{"y":207,"from":281,"to":294,"x":-42.552032470703125}]]}],"rawText":"Corresponde a la etapa de producción de ideas, en la que el equipo propone el mayor número posible de opciones sin filtrarlas ni descartarlas de antemano. La suspensión del juicio en esta fase amplía el espectro de posibilidades y favorece la aparición de soluciones innovadoras y pertinentes. "}},{"type":"text","name":"Definir el problema con precisión","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":6,"linkId":"","fontFamily":"Roboto","fontStyle":"