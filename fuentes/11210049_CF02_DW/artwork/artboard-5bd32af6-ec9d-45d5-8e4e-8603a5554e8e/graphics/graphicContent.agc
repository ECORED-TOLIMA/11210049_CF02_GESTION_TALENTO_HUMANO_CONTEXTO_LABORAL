x":-101.29340362548828}],[{"y":41,"from":26,"to":34,"x":-38.53933334350586}]]}],"rawText":"Apoyo de un facilitador o mediador"}},{"type":"text","name":"Far far away, behind","id":"f7f5af2b-edf5-4306-9d92-3cb9261dc45d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3868,"ty":-8520},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":227,"ty":3187}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":26,"x":0}],[{"y":39,"from":26,"to":47,"x":0}],[{"y":63,"from":47,"to":77,"x":0}],[{"y":87,"from":77,"to":107,"x":0}],[{"y":111,"from":107,"to":128,"x":0}],[{"y":135,"from":128,"to":157,"x":0}],[{"y":159,"from":157,"to":188,"x":0}],[{"y":183,"from":188,"to":214,"x":0}],[{"y":207,"from":214,"to":242,"x":0}],[{"y":231,"from":242,"to":263,"x":0}],[{"y":255,"from":263,"to":275,"x":0}]]}],"rawText":"Se producen dentro de una misma persona cuando experimenta tensión entre sus propios valores, expectativas o roles dentro de la organización. Son frecuentes en contextos de alta exigencia o cuando las demandas del trabajo entran en conflicto con las convicciones personales. "}},{"type":"text","name":"Far far away, behind","id":"90dcebc3-809b-4e24-bc19-f43013b7a402","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3868,"ty":542},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":227,"ty":12249}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0}],[{"y":39,"from":24,"to":49,"x":0}],[{"y":63,"from":49,"to":77,"x":0}],[{"y":87,"from":77,"to":107,"x":0}],[{"y":111,"from":107,"to":138,"x":0}],[{"y":135,"from":138,"to":168,"x":0}],[{"y":159,"from":168,"to":196,"x":0}],[{"y":183,"from":196,"to":222,"x":0}],[{"y":207,"from":222,"to":254,"x":0}],[{"y":231,"from":254,"to":281,"x":0}],[{"y":255,"from":281,"to":288,"x":0}]]}],"rawText":"Ambiente en el que cada integrante del equipo se siente seguro para expresar sus puntos de vista sin temor a ser juzgado o descalificado. Su ausencia genera inhibición y debilita la participación genuina, lo que reduce la calidad y la legitimidad de los acuerdos alcanzados por el grupo. "}},{"type":"text","name":"Far far away, behind","id":"ab31616f-6b82-470e-9833-c1ff6660568f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3561,"ty":-8520},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":534,"ty":3187}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0}],[{"y":39,"from":24,"to":53,"x":0}],[{"y":63,"from":53,"to":84,"x":0}],[{"y":87,"from":84,"to":109,"x":0}],[{"y":111,"from":109,"to":136,"x":0}],[{"y":135,"from":136,"to":166,"x":0}],[{"y":159,"from":166,"to":197,"x":0}],[{"y":183,"from":197,"to":224,"x":0}],[{"y":207,"from":224,"to":253,"x":0}]]}],"rawText":"Ocurren entre dos o más personas y suelen originarse en diferencias de perspectiva, estilo de comunicación o expectativas no alineadas. Afectan directamente el clima del equipo y, si no se abordan a tiempo, pueden escalar y comprometer la colaboración. "}},{"type":"text","name":"Far far away, behind","id":"6a56c878-8efe-4ac0-9152-d14f52496a09","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3561,"ty":542},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":534,"ty":12249}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":30,"x":0}],[{"y":39,"from":30,"to":57,"x":0}],[{"y":63,"from":57,"to":87,"x":0}],[{"y":87,"from":87,"to":117,"x":0}],[{"y":111,"from":117,"to":137,"x":0}],[{"y":135,"from":137,"to":166,"x":0}],[{"y":159,"from":166,"to":189,"x":0}],[{"y":183,"from":189,"to":218,"x":0}],[{"y":207,"from":218,"to":243,"x":0}],[{"y":231,"from":243,"to":273,"x":0}],[{"y":255,"from":273,"to":299,"x":0}]]}],"rawText":"Actitud mediante la cual cada integrante presta atención plena a las intervenciones de los demás, sin interrumpir ni formular respuestas anticipadas. Implica no solo oír las palabras, sino comprender el contexto y las razones que respaldan la posición de cada participante en el proceso de diálogo. "}},{"type":"text","name":"Far far away, behind","id":"4f5b52d2-af1f-4f7b-969e-3e3608f06340","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3246,"ty":-8520},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":849,"ty":3187}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":29,"x":0}],[{"y":39,"from":29,"to":54,"x":0}],[{"y":63,"from":54,"to":77,"x":0}],[{"y":87,"from":77,"to":108,"x":0}],[{"y":111,"from":108,"to":135,"x":0}],[{"y":135,"from":135,"to":165,"x":0}],[{"y":159,"from":165,"to":192,"x":0}],[{"y":183,"from":192,"to":215,"x":0}],[{"y":207,"from":215,"to":227,"x":0}]]}],"rawText":"Afectan a los integrantes de un mismo equipo y pueden surgir por desacuerdos internos sobre tareas, roles o procesos. Su impacto recae en la cohesión del grupo y en su capacidad para alcanzar los objetivos de forma coordinada. "}},{"type":"text","name":"Far far away, behind","id":"f59d6f3c-3163-45c5-bfce-a6ea74f4064e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3246,"ty":542},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":849,"ty":12249}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":27,"x":0}],[{"y":39,"from":27,"to":57,"x":0}],[{"y":63,"from":57,"to":88,"x":0}],[{"y":87,"from":88,"to":118,"x":0}],[{"y":111,"from":118,"to":139,"x":0}],[{"y":135,"from":139,"to":166,"x":0}],[{"y":159,"from":166,"to":195,"x":0}],[{"y":183,"from":195,"to":222,"x":0}],[{"y":207,"from":222,"to":246,"x":0}],[{"y":231,"from":246,"to":272,"x":0}],[{"y":255,"from":272,"to":298,"x":0}],[{"y":279,"from":298,"to":312,"x":0}]]}],"rawText":"Habilidad para diferenciar entre lo que cada parte exige de manera explícita (posición) y lo que realmente necesita o le preocupa de fondo (interés). Identificar los intereses subyacentes amplía el margen de negociación y facilita la búsqueda de alternativas que resulten aceptables para todos los involucrados. "}},{"type":"text","name":"Far far away, behind","id":"964111a6-878f-410a-b0ed-4f1479b1158b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-2940,"ty":-8520},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1155,"ty":3187}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":30,"x":0}],[{"y":39,"from":30,"to":53,"x":0}],[{"y":63,"from":53,"to":81,"x":0}],[{"y":87,"from":81,"to":98,"x":0}],[{"y":111,"from":98,"to":123,"x":0}],[{"y":135,"from":123,"to":154,"x":0}],[{"y":159,"from":154,"to":177,"x":0}],[{"y":183,"from":177,"to":197,"x":0}],[{"y":207,"from":197,"to":219,"x":0}],[{"y":231,"from":219,"to":244,"x":0}],[{"y":255,"from":244,"to":274,"x":0}],[{"y":279,"from":274,"to":281,"x":0}]]}],"rawText":"Se presentan entre diferentes áreas, departamentos o equipos de la organización, generalmente por competencia de recursos, objetivos divergentes o fallas en la coordinación. Su resolución requiere intervención desde el liderazgo y acuerdos que superen los intereses de cada unidad."}},{"type":"text","name":"Far far away, behind","id":"50730ea9-444e-4c19-819c-4f478a3b294c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-2940,"ty":542},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1155,"ty":12249}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":217},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":25,"x":0}],[{"y":39,"from":25,"to":56,"x":0}],[{"y":63,"from":56,"to":86,"x":0}],[{"y":87,"from":86,"to":113,"x":0}],[{"y":111,"from":113,"to":134,"x":0}],[{"y":135,"from":134,"to":158,"x":0}],[{"y":159,"from":158,"to":182,"x":0}],[{"y":183,"from":182,"to":205,"x":0}],[{"y":207,"from":205,"to":235,"x":0}],[{"y":231,"from":235,"to":263,"x":0}],[{"y":255,"from":263,"to":286,"x":0}],[{"y":279,"from":286,"to":302,"x":0}]]}],"rawText":"Presencia de una persona neutral que orienta el proceso de diálogo, propone reglas de interacción y contribuye a mantener un ambiente constructivo cuando las tensiones se elevan. Su intervención no impone soluciones, sino que favorece las condiciones para que el grupo las construya de manera autónoma."}},{"type":"group","name":"Grupo 1200680","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":188}}},"id":"081e7135-ac91-4893-8ee5-ef6e34c12329","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4095,"ty":-11519},"group":{"children":[{"type":"shape","name":"Rectángulo 467684","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"0cd25c6a-98b2-4dec-8be5-3541b56a688c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":215,"ty":8293},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1200679","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"9ad00bd8-1f53-4f99-ae6d-63d5f1ff46f3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":8264.79296875},"group":{"children":[{"type":"group","name":"Grupo 1200676","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"9eb5aa50-e5b9-46e9-b8fc-7e07cff66fad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0.9375053644180298,"ty":44.60203170776367},"group":{"children":[{"type":"group","name":"Grupo 1200675","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"c4adcb21-