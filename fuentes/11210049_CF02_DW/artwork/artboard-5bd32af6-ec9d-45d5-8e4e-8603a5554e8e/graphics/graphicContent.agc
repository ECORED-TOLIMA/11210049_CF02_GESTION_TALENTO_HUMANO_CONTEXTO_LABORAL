86157226562 90.15451049804688 70.61888122558594 90.53459167480469 C 69.97880554199219 92.36085510253906 68.68280029296875 93.78422546386719 66.96865844726562 94.54173278808594 C 66.11491394042969 94.91915893554688 65.20956420898438 95.1080322265625 64.29690551757812 95.1080322265625"}}]}}]}}]}},{"type":"shape","name":"Rectángulo 468305","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":4901}}},"id":"725911b9-1d03-4710-8fda-67d4cd0aa854","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3494,"ty":-6806},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":138,"r":[10,10,10,10]}},{"type":"text","name":"Far far away, behind","id":"94b57a99-ca68-4785-9a3d-3d4b9cda3e7a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3465,"ty":-6770},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":630,"ty":4937}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":757},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":100,"x":0}],[{"y":39,"from":100,"to":206,"x":0}],[{"y":63,"from":206,"to":309,"x":0}]]}],"rawText":"Distinguir el tipo de conflicto permite seleccionar la estrategia de intervención más adecuada: los conflictos de tarea requieren clarificación de criterios y procesos, los de relación demandan espacios de escucha y mediación, y los de proceso exigen acuerdos explícitos sobre las reglas del trabajo conjunto."}},{"type":"text","name":"Far far away, behind","id":"c6fb2efb-e9a5-44a0-be75-d216104f48f3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3494,"ty":-6638},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":5069}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":116,"x":0}],[{"y":39,"from":116,"to":230,"x":0}],[{"y":63,"from":230,"to":331,"x":0}],[{"y":87,"from":331,"to":437,"x":0}],[{"y":111,"from":437,"to":539,"x":0}],[{"y":135,"from":539,"to":650,"x":0}],[{"y":159,"from":650,"to":693,"x":0}]]}],"rawText":"Para gestionar los conflictos de manera efectiva, es indispensable identificar su causa raíz, pues intervenir sobre los síntomas sin comprender el origen prolonga la tensión y reduce las posibilidades de una solución duradera. En el entorno organizacional, los conflictos rara vez surgen de manera aislada: responden a condiciones estructurales, relacionales o comunicativas que, si no se atienden oportunamente, se convierten en fuente recurrente de malestar y bajo desempeño. Reconocer estos factores permite al gestor de talento humano anticiparse al conflicto y acompañar a los equipos con mayor precisión. Los conflictos organizacionales suelen tener su origen en los siguientes factores:"}},{"type":"text","name":"Far far away, behind","id":"1498a78a-a117-4116-b745-62f3c366a3f9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":-6175},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":5532}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":158,"x":0}],[{"y":39,"from":158,"to":312,"x":0}],[{"y":63,"from":312,"to":415,"x":0}]]}],"rawText":"La identificación de estos factores no solo facilita la comprensión del conflicto, sino que también orienta la selección de la estrategia de intervención más pertinente para cada situación. Un equipo que comprende qué origina sus tensiones internas está en mejores condiciones de abordarlas con objetividad y de construir acuerdos que respondan a las causas reales, y no a percepciones superficiales de lo ocurrido."}},{"type":"text","name":"Far far away, behind","id":"12d89f09-2a01-4bc7-ad6c-90c64a859012","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-5888},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":5819}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":169,"x":0}],[{"y":39,"from":169,"to":274,"x":0}]]}],"rawText":"Identificado el tipo y la causa del conflicto, el paso siguiente consiste en construir argumentos sólidos que orienten la búsqueda de soluciones. La argumentación y los criterios de solución son las herramientas que hacen posible esta transición del diagnóstico a la acción."}},{"type":"text","name":"Far far away, behind","id":"36ba2162-1ac8-45a3-b619-0d0b611281fb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-5279},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":6428}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":161,"x":0}],[{"y":39,"from":161,"to":334,"x":0}],[{"y":63,"from":334,"to":493,"x":0}]]}],"rawText":"Una argumentación sólida en el entorno organizacional no se construye de manera espontánea: requiere el cumplimiento de criterios que garantizan que las razones presentadas sean válidas, pertinentes y evaluables por todos los involucrados. Cuando estos criterios se respetan, el debate deja de ser una confrontación de opiniones y se convierte en un proceso racional orientado a encontrar la mejor solución posible. Los criterios que deben cumplir una argumentación sólida son los siguientes: "}},{"type":"group","name":"Enmascarar grupo 1119419","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Image Place Holder","id":"fc8a12ee-8426-4846-b07d-1786aee5b45d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":5829},"meta":{"ux":{"hasCustomName":true}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":331,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-928}}},"id":"6954afd3-8355-4dbe-84d4-bfa1bab8af2c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4095,"ty":-12635},"