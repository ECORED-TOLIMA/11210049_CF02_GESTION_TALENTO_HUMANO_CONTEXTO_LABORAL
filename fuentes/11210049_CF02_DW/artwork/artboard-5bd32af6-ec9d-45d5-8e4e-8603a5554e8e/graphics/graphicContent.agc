form":{"a":1,"b":0,"c":0,"d":1,"tx":184.6298828125,"ty":198}}},"id":"9cb55f91-ce30-40bf-8bf7-c53e888fc59a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910.3701171875,"ty":-11509},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 45.6494140625 0 L 45.6494140625 45.6513671875 L 0 45.6513671875 L 0 0 Z"}},{"type":"text","name":"3","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":30,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":207.62939453125,"ty":231}}},"id":"de3886f4-dc10-4102-a80c-75846ed55b2e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3887.37060546875,"ty":-11476},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":30},"textAttributes":{"lineHeight":35,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":1,"x":-8.6865234375}]]}],"rawText":"3"}},{"type":"shape","name":"Línea 106","meta":{"ux":{"nameL10N":"SHAPE_LINE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.0712890625,"ty":263.5}}},"id":"37f22a16-cf45-44a9-b354-1c6099fbfe4b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3909.9287109375,"ty":-11443.5},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":1230,"y2":0}},{"type":"text","name":"En toda organización, la convivencia entre personas con perspectivas, intereses y estilos de trabajo distintos genera inevitablemente situaciones de tensión que, si no se gestionan de manera adecuada, pueden escalar hasta afectar el desempeño, el clima lab","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":316}}},"id":"fd19fab6-8c85-481b-8ebc-5bd932e10f5d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3598,"ty":-11391},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915.6298828125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":118,"x":0}],[{"y":39,"from":118,"to":233,"x":0}],[{"y":63,"from":233,"to":357,"x":0}],[{"y":87,"from":357,"to":435,"x":0}]]}],"rawText":"En toda organización, la convivencia entre personas con perspectivas, intereses y estilos de trabajo distintos genera inevitablemente situaciones de tensión que, si no se gestionan de manera adecuada, pueden escalar hasta afectar el desempeño, el clima laboral y los resultados del equipo. La forma en que una organización enfrenta estas situaciones revela mucho sobre su cultura, su madurez institucional y la calidad de su liderazgo."}},{"type":"shape","name":"Rectángulo 467625","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":1320}}},"id":"7daed2d5-116c-452f-adff-f33c4ce0da3f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3494,"ty":-10387},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":190,"r":[10,10,10,10]}},{"type":"text","name":"La aplicación articulada de estos principios no garantiza que todos los conflictos se resuelvan sin dificultad, pero sí asegura que el proceso se desarrolle con rigor, respeto y orientación hacia resultados sostenibles. Una organización que incorpora estos","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":1206}}},"id":"ca76907e-b885-47a6-ad04-fd782096e324","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":-10501},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":161,"x":0}],[{"y":39,"from":161,"to":315,"x":0}],[{"y":63,"from":315,"to":397,"x":0}]]}],"rawText":"La aplicación articulada de estos principios no garantiza que todos los conflictos se resuelvan sin dificultad, pero sí asegura que el proceso se desarrolle con rigor, respeto y orientación hacia resultados sostenibles. Una organización que