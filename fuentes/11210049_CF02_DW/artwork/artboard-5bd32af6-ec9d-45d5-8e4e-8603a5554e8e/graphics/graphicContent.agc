egular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":39,"x":-134.75901794433594}],[{"y":39,"from":39,"to":71,"x":-110.32261657714844}],[{"y":63,"from":71,"to":111,"x":-135.1149444580078}],[{"y":87,"from":111,"to":150,"x":-135.66574096679688}],[{"y":111,"from":150,"to":186,"x":-128.80104064941406}],[{"y":135,"from":186,"to":222,"x":-129.0818328857422}],[{"y":159,"from":222,"to":251,"x":-105.89153289794922}],[{"y":183,"from":251,"to":289,"x":-131.09884643554688}]]}],"rawText":"Identificar una situación problemática en sus etapas iniciales permite intervenir antes de que se intensifique y afecte el funcionamiento del equipo. Ignorar las señales tempranas suele derivar en conflictos más complejos que requieren mayor tiempo y recursos para su resolución efectiva. "}},{"type":"text","name":"Comprender con precisión cuál es el problema, quiénes están involucrados y cuáles son las causas que lo originan es condición indispensable para diseñar respuestas pertinentes. Un diagnóstico superficial conduce a soluciones que atacan los síntomas sin res","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":662.50048828125,"ty":923.673828125}}},"id":"678dc5ba-b090-4adf-8265-e153aeeeeef4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3432.49951171875,"ty":-10783.326171875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":36,"x":-129.722900390625}],[{"y":39,"from":36,"to":73,"x":-134.953857421875}],[{"y":63,"from":73,"to":104,"x":-108.27137756347656}],[{"y":87,"from":104,"to":140,"x":-127.74635314941406}],[{"y":111,"from":140,"to":177,"x":-130.352294921875}],[{"y":135,"from":177,"to":214,"x":-131.58619689941406}],[{"y":159,"from":214,"to":249,"x":-128.28494262695312}],[{"y":183,"from":249,"to":287,"x":-129.87228393554688}],[{"y":207,"from":287,"to":302,"x":-45.9509391784668}]]}],"rawText":"Comprender con precisión cuál es el problema, quiénes están involucrados y cuáles son las causas que lo originan es condición indispensable para diseñar respuestas pertinentes. Un diagnóstico superficial conduce a soluciones que atacan los síntomas sin resolver las causas estructurales del conflicto. "}},{"type":"text","name":"Abordar el conflicto con el propósito de encontrar alternativas que beneficien a las partes, en lugar de buscar vencedores o vencidos, favorece la cohesión del equipo y la sostenibilidad de los acuerdos alcanzados. Este enfoque requiere apertura, escucha a","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1008.00048828125,"ty":943.673828125}}},"id":"7d59a1a3-ef35-4edc-9170-e8fbcdcaf99a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3086.99951171875,"ty":-10763.326171875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":276},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":38,"x":-129.42649841308594}],[{"y":39,"from":38,"to":68,"x":-103.95059967041016}],[{"y":63,"from":68,"to":105,"x":-123.51197814941406}],[{"y":87,"from":105,"to":135,"x":-109.68106079101562}],[{"y":111,"from":135,"to":172,"x":-127.016357421875}],[{"y":135,"from":172,"to":203,"x":-108.62684631347656}],[{"y":159,"from":203,"to":237,"x":-123.03839111328125}],[{"y":183,"from":237,"to":276,"x":-135.8922882080078}],[{"y":207,"from":276,"to":308,"x":-115.81089782714844}]]}],"rawText":"Abordar el conflicto con el propósito de encontrar alternativas que beneficien a las partes, en lugar de buscar vencedores o vencidos, favorece la cohesión del equipo y la sostenibilidad de los acuerdos alcanzados. Este enfoque requiere apertura, escucha activa y disposición para ceder en algunos aspectos. "}},{"type":"text","name":"Reconocimiento oportuno del conflicto","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":6,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":308.74658203125,"ty":880.673828125}}},"id":"4a3468b0-7b0e-461a-a057-f9c8c431a645","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3786.25341796875,"ty":-10826.326171875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":2