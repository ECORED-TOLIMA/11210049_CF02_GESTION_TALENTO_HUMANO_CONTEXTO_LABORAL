t":24}},"text":{"frame":{"type":"autoHeight","width":927},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":191,"x":0}]]},{"lines":[[{"y":63,"from":192,"to":192,"x":0}]]},{"lines":[[{"y":87,"from":193,"to":313,"x":0}],[{"y":111,"from":313,"to":385,"x":0}]]},{"lines":[[{"y":135,"from":386,"to":386,"x":0}]]},{"lines":[[{"y":159,"from":387,"to":512,"x":0}],[{"y":183,"from":512,"to":565,"x":0}]]},{"lines":[[{"y":207,"from":566,"to":566,"x":0}]]},{"lines":[[{"y":231,"from":567,"to":696,"x":0}],[{"y":255,"from":696,"to":748,"x":0}]]}],"rawText":"Definir el problema con precisión: describir el síntoma observable, el impacto que tiene y el contexto en el que se presenta, evitando saltar a las soluciones antes de comprender el problema.\n\nRecopilar información objetiva sobre las causas: distinguir los hechos verificables de las suposiciones o percepciones, consultando fuentes diversas y a las personas directamente involucradas.\n\nGenerar alternativas posibles sin descartarlas prematuramente: registrar todas las opciones identificadas por el equipo para ampliar el abanico de soluciones antes de evaluarlas.\n\nEvaluar cada alternativa y seleccionar la más viable: aplicar los criterios previamente acordados por el grupo para comparar las opciones y tomar la decisión de manera fundamentada."}},{"type":"shape","name":"Image Place Holder","id":"1861caf2-09cd-4c49-a580-8a7915fae92f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-1637},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":10070}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}}},"shape":{"type":"rect","x":0,"y":0,"width":604,"height":290}},{"type":"shape","name":"Image Place Holder","id":"b7d8c410-4a37-4773-9090-c300a98eb115","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-1327},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":10380}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}}},"shape":{"type":"rect","x":0,"y":0,"width":604,"height":290}},{"type":"shape","name":"Image Place Holder","id":"ce3ed0df-3619-4907-aa4f-f275461f642a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3286,"ty":-1637},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":809,"ty":10070}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}}},"shape":{"type":"rect","x":0,"y":0,"width":604,"height":290}},{"type":"shape","name":"Image Place Holder","id":"0d64f816-436c-4e8d-a577-1b40d3c538da","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3286,"ty":-1327},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":809,"ty":10380}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}}},"shape":{"type":"rect","x":0,"y":0,"width":604,"height":290}},{"type":"text","name":"Mapa mental: herramienta visual que organiza ideas alrededor de un concepto central mediante ramas y subramas, facilitando la identificación de relaciones entre elementos y la exploración de nuevas perspectivas. En el contexto organizacional, permite visua","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":326,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":10214}}},"id":"e632ead6-a05f-486f-bfbd-a664ebff9dc1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3870,"ty":-1493},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":524},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":67,"x":0}],[{"y":39,"from":67,"to":126,"x":0}],[{"y":63,"from":126,"to":198,"x":0}],[{"y":87,"from":198,"to":271,"x":0}],[{"y":111,"from":271,"to":326,"x":0}]]}],"rawText":"Mapa mental: herramienta visual que organiza ideas alrededor de un concepto central mediante ramas y subramas, facilitando la identificación de relaciones entre elementos y la exploración de nuevas perspectivas. En el contexto organizacional, permite visualizar de forma rápida las posibles causas y soluciones de un problema."}},{"type":"text","name":"Pensamiento de los seis sombreros: técnica que propone analizar una situación desde seis perspectivas distintas (objetiva, emocional, crítica, optimista, creativa y organizadora) para ampliar el análisis y evitar sesgos individuales. Facilita la participac","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":640,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":10524}}},"id":"a9d02cd5-3d52-4c54-9e88-d1488afca169","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3870,"ty":-1183},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":524},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":68,"x":0}],[{"y":39,"from":68,"to":143,"x":0}],[{"y":63,"from":143,"to":213,"x":0}],[{"y":87,"from":213,"to":287,"x":0}],[{"y":111,"from":287,"to":323,"x":0}]]}],"rawText":"Pensamiento de los seis sombreros: técnica que propone analizar una situación desde seis perspectivas distintas (objetiva, emocional, crítica, optimista, creativa y organizadora) para ampliar el análisis y evitar sesgos individuales. Facilita la participación equilibrada y estructurada de todos los integrantes del equipo."}},{"type":"text","name":"Técnica de los cinco porqués: metodología que consiste en preguntar ¿por qué? de manera reiterada ante cada respuesta obtenida, con el fin de llegar a la causa raíz de un problema. Se aplica cuando la solución superficial no resuelve el problema de fondo y","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":937,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":849,"ty":10214}}},"id":"ef5d5e36-f17a-4b88-a4f8-c7908c4f3b9c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3246,"ty":-1493},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":524},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":68,"x":0}],[{"y":39,"from":68,"to":139,"x":0}],[{"y":63,"from":139,"to":210,"x":0}],[{"y":87,"from":210,"to":281,"x":0}],[{"y":111,"from":281,"to":294,"x":0}]]}],"rawText":"Técnica de los cinco porqués: metodología que consiste en preguntar ¿por qué? de manera reiterada ante cada respuesta obtenida, con el fin de llegar a la causa raíz de un problema. Se aplica cuando la solución superficial no resuelve el problema de fondo y se requiere un análisis más profundo."}},{"type":"text","name":"Tormenta de ideas inversa: variación de la lluvia de ideas que parte de la pregunta ¿cómo podríamos causar o empeorar el problema?; a partir de las respuestas se identifican las acciones contrarias, que constituyen las posibles soluciones. Resulta útil cua","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":314,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":849,"ty":10524}}},"id":"35a90964-e585-4dbc-a5b7-68be9babee8b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3246,"ty":-1183},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":524},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":75,"x":0}],[{"y":39,"from":75,"to":144,"x":0}],[{"y":63,"from":144,"to":219,"x":0}],[{"y":87,"from":219,"to":290,"x":0}],[{"y":111,"from":290,"to":310,"x":0}]]}],"rawText":"Tormenta de ideas inversa: variación de la lluvia de ideas que parte de la pregunta ¿cómo podríamos causar o empeorar el problema?; a partir de las respuestas se identifican las acciones contrarias, que constituyen las posibles soluciones. Resulta útil cuando el equipo está bloqueado o no genera ideas nuevas."}},{"type":"group","name":"Grupo 1201959","m