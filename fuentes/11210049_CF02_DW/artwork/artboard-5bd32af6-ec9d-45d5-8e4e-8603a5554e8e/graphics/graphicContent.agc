834960938 296.0193481445312 43.17855834960938 Z"}}]}}]}},{"type":"shape","name":"Image Place Holder","id":"799bab9c-1d48-4370-858e-8b303f310b41","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3597,"ty":1071.826171875},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":12778.826171875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":160}},{"type":"text","name":"Los acuerdos alcanzados mediante consenso tienen mayor probabilidad de ser implementados con éxito, porque todas las partes se sienten partícipes de la decisión y comprometidas con su cumplimiento. En ese sentido, invertir tiempo en la construcción de cons","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":529,"ty":12813.826171875}}},"id":"991e026a-12b3-4701-b13f-2c7e31c5541f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3566,"ty":1106.826171875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":855},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":233,"x":0}],[{"y":63,"from":233,"to":346,"x":0}],[{"y":87,"from":346,"to":383,"x":0}]]}],"rawText":"Los acuerdos alcanzados mediante consenso tienen mayor probabilidad de ser implementados con éxito, porque todas las partes se sienten partícipes de la decisión y comprometidas con su cumplimiento. En ese sentido, invertir tiempo en la construcción de consensos no es un lujo: es una estrategia de gestión que genera resultados más sostenibles y relaciones más sólidas a largo plazo."}},{"type":"text","name":"La efectividad de la comunicación en el entorno organizacional no depende únicamente del mensaje que se transmite, sino de la manera en que se construye y se entrega. Cuando los integrantes de un equipo desarrollan hábitos comunicativos sólidos, la posibil","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":12969}}},"id":"497996fe-6576-4551-b17b-18bfc1201e7a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":1262},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":153,"x":0}],[{"y":39,"from":153,"to":305,"x":0}],[{"y":63,"from":305,"to":436,"x":0}]]}],"rawText":"La efectividad de la comunicación en el entorno organizacional no depende únicamente del mensaje que se transmite, sino de la manera en que se construye y se entrega. Cuando los integrantes de un equipo desarrollan hábitos comunicativos sólidos, la posibilidad de alcanzar acuerdos genuinos y sostenibles aumenta de forma significativa. Tres cualidades fundamentales caracterizan una comunicación que fortalece los procesos de consenso:"}},{"type":"text","name":"Desarrollar estas cualidades comunicativas no ocurre de manera espontánea: requiere formación, práctica y reflexión constante sobre la propia forma de relacionarse con los demás. La asertividad es precisamente la competencia que integra estas tres dimensio","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":13441}}},"id":"86e23d64-d4ef-470a-8804-827466558bd4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":1734},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1229},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":333,"x":0}],[{"y":63,"from":333,"to":447,"x":0}]]}],"rawText":"Desarrollar estas cualidades comunicativas no ocurre de manera espontánea: requiere formación, práctica y reflexión constante sobre la propia forma de relacionarse con los demás. La asertividad es precisamente la competencia que integra estas tres dimensiones en una sola habilidad, aplicable tanto en situaciones cotidianas como en momentos de tensión organizacional. Su comprensión y desarrollo constituyen el eje central del siguiente apartado."}},{"type":"text","name":"La presencia simultánea de estas condiciones no garantiza que el proceso sea sencillo, pero sí que sea legítimo y sostenible. Cuando el equipo opera en un entorno de confianza, escucha con atención, comprende lo que realmente está en juego para cada parte ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":12633.826171875}}},"id":"b6cbd227-9e2a-4735-933a-b91eef4eb8a2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3597,"ty":926.826171875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":250,"x":0}],[{"y":63,"from":250,"to":372,"x":0}],[{"y":87,"from":372,"to":490,"x":0}],[{"y":111,"from":490,"to":551,"x":0}]]}],"rawText":"La presencia simultánea de estas condiciones no garantiza que el proceso sea sencillo, pero sí que sea legítimo y sostenible. Cuando el equipo opera en un entorno de confianza, escucha con atención, comprende lo que realmente está en juego para cada parte y cuenta con orientación cuando el diálogo se tensa, las probabilidades de alcanzar un acuerdo duradero aumentan de manera significativa. El consenso, en ese sentido, no es el punto de llegada: es la base sobre la que se construye la implementación efectiva de cualquier solución organizacional."}},{"type":"group","name":"Enmascarar grupo 1119424","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Image Place Holder","id":"be401f10-21f1-4c26-99bd-adc010ea6a4c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":12064},"meta":{"ux":{"hasCustomName":true}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":292,"height":305,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1,"ty":569.826171875}}},"id":"dea63c4a-ba1b-41fb-8b1c-06bf3c08658d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4094,"ty":-11137.173828125},"group":{"children":[{"type":"shape","name":"Imagen 153","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":650,"height":434}}},"id":"fee3c0bd-db1e-49f7-8020-762fc13e87eb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":136,"ty":12062.8134765625},"style":{"fill":{"type":"pattern","pattern":{"width":650,"height":434,"meta":{"ux":{"scaleBehavior":"fill","uid":"f2fc21cd867e20cae73f5cd4563d7176","hrefLastModifiedDate":1787099130}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":483,"height":322.3999938964844}}]}},{"type":"group","name":"Grupo 1202130","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":276}}},"id":"6a702a40-75a9-4c61-be51-48b6cd68ef0c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4095,"ty":-11431},"group":{"children":[{"type":"shape","name":"Rectángulo 468332","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true}},"id":"4cc7deda-542a-4416-a361-8fcb38c150e7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":315,"ty":10698},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":