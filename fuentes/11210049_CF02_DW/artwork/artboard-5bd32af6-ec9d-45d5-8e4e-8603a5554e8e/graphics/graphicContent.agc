s y acuerdos"}},{"type":"group","name":"Grupo 1177787","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"7d74a9b2-a03b-4332-9727-542298317a42","transform":{"a":1,"b":0,"c":0,"d":1,"tx":9,"ty":498.5},"group":{"children":[{"type":"shape","name":"Línea 107","meta":{"ux":{"nameL10N":"SHAPE_LINE"}},"id":"20cc185e-2d8d-4d16-aebd-77ce89f3487d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":177,"ty":697},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":137,"y2":0}},{"type":"shape","name":"Línea 108","meta":{"ux":{"nameL10N":"SHAPE_LINE"}},"id":"d8432388-a844-4a89-b60d-cd2d9bb0bde9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":177,"ty":697},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":46,"y2":0}}]}}]}},{"type":"text","name":"Aplicar una metodología estructurada para resolver problemas organizacionales permite ordenar el pensamiento del equipo y avanzar de forma sistemática hacia soluciones viables. Sin esa estructura, los grupos tienden a proponer respuestas antes de comprende","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":331,"ty":8466}}},"id":"edc21b87-a9b3-4b8a-91de-48b60691efe3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3764,"ty":-3241},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":743},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":97,"x":0}],[{"y":39,"from":97,"to":201,"x":0}],[{"y":63,"from":201,"to":305,"x":0}],[{"y":87,"from":305,"to":406,"x":0}],[{"y":111,"from":406,"to":509,"x":0}]]}],"rawText":"Aplicar una metodología estructurada para resolver problemas organizacionales permite ordenar el pensamiento del equipo y avanzar de forma sistemática hacia soluciones viables. Sin esa estructura, los grupos tienden a proponer respuestas antes de comprender con claridad el origen de la situación, lo que genera soluciones superficiales o mal orientadas. La siguiente secuencia integra etapas de análisis, generación de ideas y evaluación crítica, de manera que cada paso prepara el terreno para el siguiente:"}},{"type":"text","name":"Con los criterios de evaluación definidos, el equipo cuenta con los parámetros necesarios para comparar alternativas de manera objetiva. Sin embargo, antes de evaluar, es necesario haber generado un conjunto suficiente de opciones: cuanto más amplio y dive","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8032}}},"id":"a3494a56-f8e4-4948-bc76-fccc472373fa","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-3675},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":171,"x":0}],[{"y":39,"from":171,"to":331,"x":0}],[{"y":63,"from":331,"to":503,"x":0}]]}],"rawText":"Con los criterios de evaluación definidos, el equipo cuenta con los parámetros necesarios para comparar alternativas de manera objetiva. Sin embargo, antes de evaluar, es necesario haber generado un conjunto suficiente de opciones: cuanto más amplio y diverso sea ese conjunto, mayor será la probabilidad de encontrar una solución realmente efectiva. Las estrategias creativas de solución, desarrolladas en el siguiente apartado, ofrecen herramientas concretas para ampliar ese espacio de posibilidades."}},{"type":"text","name":"La resolución efectiva de problemas organizacionales requiere un equilibrio entre la creatividad y la lógica. La creatividad permite generar alternativas novedosas que trascienden las soluciones convencionales; la lógica garantiza que esas alternativas sea","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8341}}},"id":"8eca7b55-fcb5-4f64-9a63-c52f657d8f31","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-3366},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":125,"x":0}],[{"y":39,"from":125,"to":253,"x":0}],[{"y":63,"from":253,"to":360,"x":0}]]}],"rawText":"La resolución efectiva de problemas organizacionales requiere un equilibrio entre la creatividad y la lógica. La creatividad permite generar alternativas novedosas que trascienden las soluciones convencionales; la lógica garantiza que esas alternativas sean evaluadas con rigor y que la solución seleccionada sea realmente factible y coherente con el contexto."}},{"type":"text","name":"El pensamiento creativo en la resolución de problemas puede estimularse mediante técnicas como el mapa mental, que permite visualizar las conexiones entre diferentes aspectos del problema; el método SCAMPER, que invita a sustituir, combinar, adaptar, modif","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":9859}}},"id":"b7d54225-5a02-4c8d-8e0e-903b0f0389c4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":-1848},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":149,"x":0}],[{"y":39,"from":149,"to":301,"x":0}],[{"y":63,"from":301,"to":455,"x":0}],[{"y":87,"from":455,"to":478,"x":0}]]}],"rawText":"El pensamiento creativo en la resolución de problemas puede estimularse mediante técnicas como el mapa mental, que permite visualizar las conexiones entre diferentes aspectos del problema; el método SCAMPER, que invita a sustituir, combinar, adaptar, modificar, proponer usos alternativos, eliminar y reorganizar los elementos del problema; o el pensamiento lateral, que consiste en abordar el problema desde perspectivas no convencionales para descubrir soluciones inesperadas."}},{"type":"text","name":"Cada una de estas herramientas presenta rasgos propios que la hacen adecuada para distintos tipos de problemas y contextos organizacionales. Conocer sus características permite al equipo seleccionar la técnica más pertinente según la naturaleza del conflic","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":9973}}},"id":"889c2094-6435-4a61-9b69-82c79785d6a7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-1734},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":153,"x":0}],[{"y":39,"from":153,"to":325,"x":0}],[{"y":63,"from":325,"to":349,"x":0}]]}],"rawText":"Cada una de estas herramientas presenta rasgos propios que la hacen adecuada para distintos tipos de problemas y contextos organizacionales. Conocer sus características permite al equipo seleccionar la técnica más pertinente según la naturaleza del conflicto y el nivel de análisis requerido. Las principales herramientas de resolución creativa son:"}},{"type":"text","name":"Esta secuencia no impone un único camino, sino que ofrece una estructura flexible que el equipo adapta a la naturaleza y la complejidad de cada situación. Su valor radica en convertir un proceso que suele ser intuitivo y desordenado en un ejercicio colecti","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":9175}}},"id":"12969903-a292-4ba2-b064-64960b323bf5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3494,"ty":-2532},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":108,"x":0}],[{"y":39,"from":108,"to":221,"x":0}],[{"y":63,"from":221,"to":335,"x":0}],[{"y":87,"from":335,"to":384,"x":0}]]}],"rawText":"Esta secuencia no impone un único camino, sino que ofrece una estructura flexible que el equipo adapta a la naturaleza y la complejidad de cada situación. Su valor radica en convertir un proceso que suele ser intuitivo y desordenado en un ejercicio colectivo y sistemático, en el que cada decisión se sustenta en análisis compartido y no en la opinión de un solo integrante del grupo."}},{"type":"text","name":"La elección de la técnica depende del tipo de problema y del nivel de estructuración que requiera el equipo. Lo fundamental es que el proceso sea colectivo: la diversidad de perspectivas amplía el abanico de alternativas y mejora la calidad de la decisión ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.5,"ty":10722}}},"id":"202d0ab7-8f38-4ab6-977d-31964f0978c1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3909.5,"ty":-985},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":811.5},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":112,"x":0}],[{"y":39,"from":112,"to":223,"x":0}],[{"y":63,"from":223,"to":262,"x":0}]]},{"lines":[[{"y":87,"from":263,"to":263,"x":0}]]},{"lines":[[{"y":111,"from":264,"to":370,"x":0}],[{"y":135,"from":370,"to":471,"x":0}],[{"y":159,"from":471,"to":585,"x":0}],[{"y":183,"from":585,"to":626,"x":0}]]}],"rawText":"La elección de la técnica depende del tipo de problema y del nivel de estructuración que requiera el equipo. Lo fundamental es que el proceso sea colectivo: la diversidad de perspectivas amplía el abanico de alternativas y mejora la calidad de la decisión final.\n\nEl siguiente caso ilustra cómo la aplicación combinada de estas herramientas permite al equipo de gestión humana avanzar desde el diagnóstico del conflicto hasta la construcción de una solución acordada con resultados concretos. La situación descrita corresponde a un entorno organizacional en el que la creatividad y el análisis actúan de manera complementaria:"}},{"type":"text","name":"La generación de alternativas creativas representa una etapa fundamental del proceso, pero no la última. Una vez identificadas las opciones más viables, el equipo debe avanzar hacia la construcción de acuerdos que todas las partes puedan asumir como propio","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":11250}}},"id":"1f8dcff7-2000-44a5-aedc-707c838f9992","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":-457},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":156,"x":0}],[{"y":39,"from":156,"to":310,"x":0}],[{"y":63,"from":310,"to":397,"x":0}]]}],"rawText":"La generación de alternativas creativas representa una etapa fundamental del proceso, pero no la última. Una vez identificadas las opciones más viables, el equipo debe avanzar hacia la construcción de acuerdos que todas las partes puedan asumir como propios. Este tránsito, del análisis al consenso, es el que determina si la solución seleccionada tendrá respaldo real al momento de implementarse."}},{"type":"shape","name":"Rectángulo 468303","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":2974}}},"id":"a5b00a49-641b-4000-97f2-e53f2cf0ff17","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3909,"ty":-8733},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":299,"height":520.12255859375,"r":[20,0,0,20]}},{"type":"shape","name":"Rectángulo 468336","meta":{"ux":{"nameL10