ue las diferentes partes involucrad","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":226,"ty":6248}}},"id":"ae0a1598-5fcf-43dd-b522-2c2c3597878b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3869,"ty":-5459},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":732},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":92,"x":0}],[{"y":39,"from":92,"to":186,"x":0}],[{"y":63,"from":186,"to":278,"x":0}],[{"y":87,"from":278,"to":380,"x":0}],[{"y":111,"from":380,"to":404,"x":0}]]}],"rawText":"La argumentación es la capacidad de sustentar una posición o propuesta con razones válidas, pertinentes y verificables. En el contexto de la resolución de problemas organizacionales, la argumentación es fundamental para que las diferentes partes involucradas puedan exponer sus perspectivas de manera clara y convincente, y para que el grupo pueda evaluar las diferentes opciones con criterios objetivos."}},{"type":"group","name":"Grupo 1201920","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1,"ty":1560}}},"id":"35a4fde4-4ec7-4482-bf02-13d776d96936","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4094,"ty":-10147},"group":{"children":[{"type":"shape","name":"Rectángulo 467590","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"con