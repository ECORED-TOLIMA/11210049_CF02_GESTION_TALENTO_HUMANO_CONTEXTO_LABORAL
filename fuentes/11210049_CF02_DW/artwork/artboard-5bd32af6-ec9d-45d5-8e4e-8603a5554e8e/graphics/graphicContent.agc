187866211 L 23.05554962158203 28.02339363098145 Z","winding":"evenodd"}}]}},{"type":"shape","name":"Rectángulo 468331","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":10949}}},"id":"8ca04379-c50d-4135-9d1e-584916f7e455","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3805,"ty":-758},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":271}},{"type":"text","name":"Resolución creativa de una crisis de turnos en una clínica del sector salud\n\nEn una clínica del sector salud, el área de talento humano enfrenta un conflicto recurrente sobre la asignación de turnos entre enfermeras de dos unidades. Tras aplicar la técnica","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":77,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":580,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":582,"ty":10979}}},"id":"cdd791e8-c9e3-4acf-99bd-7fc646f8e53a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3513,"ty":-728},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":698},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":75,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":39,"from":76,"to":76,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":63,"from":77,"to":175,"x":0}],[{"y":87,"from":175,"to":270,"x":0}],[{"y":111,"from":270,"to":371,"x":0}],[{"y":135,"from":371,"to":467,"x":0}],[{"y":159,"from":467,"to":556,"x":0}],[{"y":183,"from":556,"to":652,"x":0}],[{"y":207,"from":652,"to":657,"x":0}]]}],"rawText":"Resolución creativa de una crisis de turnos en una clínica del sector salud\n\nEn una clínica del sector salud, el área de talento humano enfrenta un conflicto recurrente sobre la asignación de turnos entre enfermeras de dos unidades. Tras aplicar la técnica de los cinco porqués, identifica la causa raíz: la organización carece de criterios claros para asignar turnos en días especiales y festivos. El equipo convoca a representantes de ambas unidades y, mediante un mapa mental, construye un reglamento de asignación con criterios acordados. El conflicto disminuye notablemente en el mes siguiente y el reglamento se integra al manual de procesos del área."}},{"type":"group","name":"Grupo 1201961","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":786.8665161132812,"ty":3702}}},"id":"ee163188-d5f7-47c7-ac72-cc35420c6e2d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3308.1334838867188,"ty":-8005},"group":{"children":[{"type":"shape","name":"Rectángulo 467727","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"64acf67c-1c59-4c84-99ef-84e33a67b7fe","transform":{"a":1,"b":0,"c":0,"d":1,"tx":230.13339233398438,"ty":7042},"style":{"fill":{"type"