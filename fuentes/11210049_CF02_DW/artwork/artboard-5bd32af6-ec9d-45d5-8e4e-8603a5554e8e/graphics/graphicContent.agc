{"y":63,"from":203,"to":307,"x":0}],[{"y":87,"from":307,"to":394,"x":0}]]}],"rawText":"La metodología para la resolución de conflictos organizacionales cobra sentido cuando cada etapa se ejecuta con rigor y claridad. Actuar de manera ordenada reduce el riesgo de omitir pasos fundamentales y permite al equipo mantener el foco en el problema real, sin desviarse hacia discusiones secundarias o respuestas prematuras. Las acciones que estructuran este proceso de forma práctica son:"}},{"type":"shape","name":"Rectángulo 468326","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":9500}}},"id":"4ebcbdd7-8098-4357-8b77-f701a3d23680","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3806,"ty":-2207},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":320}},{"type":"shape","name":"Rectángulo 468327","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319,"ty":9530}}},"id":"ceca9a45-5d81-4d00-abf3-5dc8b12abf7d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3776,"ty":-2177},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 468328","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319,"ty":9600}}},"id":"b6d8fe1e-a6f3-4d02-8234-c3ed5214bacd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3776,"ty":-2107},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}}