,"size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":22,"x":-91.14432525634766}]]}],"rawText":"Conflictos funcionales"}},{"type":"text","name":"Feature One","id":"f6d8e8d7-3f67-41d3-8492-e518af84371b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3039,"ty":-9326.255859375},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1056,"ty":2380.744140625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":25,"x":-103.29678344726562}]]}],"rawText":"Conflictos disfuncionales"}},{"type":"text","name":"Far far away, behind","id":"1e9c9b9b-18a9-49bf-8549-20d5596e6a57","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3761,"ty":-9297.64453125},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":334,"ty":2409.35546875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"area","width":421.734375,"height":140},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":54,"x":0}],[{"y":39,"from":54,"to":102,"x":0}],[{"y":63,"from":102,"to":151,"x":0}],[{"y":87,"from":151,"to":200,"x":0}],[{"y":111,"from":200,"to":251,"x":0}],[{"y":135,"from":251,"to":263,"x":0}]]}],"rawText":"Generan tensión productiva dentro del equipo y actúan como motor de cambio e innovación. Lejos de ser perjudiciales, cuando se gestionan adecuadamente estimulan el pensamiento crítico, cuestionan los supuestos establecidos y abren espacio para nuevas soluciones. "}},{"type":"text","name":"Far far away, behind","id":"3c4f5b44-6889-46bb-9ac2-4b29f5e2184f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3250,"ty":-9297.64453125},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":845,"ty":2409.35546875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":421.734375},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":61,"x":0}],[{"y":39,"from":61,"to":106,"x":0}],[{"y":63,"from":106,"to":153,"x":0}],[{"y":87,"from":153,"to":209,"x":0}],[{"y":111,"from":209,"to":249,"x":0}]]}],"rawText":"Deterioran las relaciones entre los integrantes, bloquean el desempeño organizacional y generan climas de desconfianza y tensión sostenida. Su presencia prolongada afecta la motivación del equipo y compromete la calidad de los resultados colectivos."}},{"type":"shape","name":"Rectángulo 468299","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":2734}}},"id":"ce179c7a-db87-4792-93d3-529fba3b0d5a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3805,"ty":-8973},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":200}},{"type":"shape","name":"Rectángulo 468304","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":3756}}},"id":"b8141bbf-3783-4a23-a187-19d42cfe52dc","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-7951},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":190}},{"type":"text","name":"Además de clasificarse por su naturaleza, los conflictos organizacionales pueden analizarse según los actores que involucran, lo que permite comprender el alcance del conflicto y definir el nivel de intervención requerido. Un desacuerdo interno de una pers","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":325,"ty":2765}}},"id":"bc7e3e3d-625a-41ab-9deb-d9b46088ae4d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3770,"ty":-8942},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":949},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":133,"x":0}],[{"y":39,"from":133,"to":263,"x":0}],[{"y":63,"from":263,"to":392,"x":0}],[{"y":87,"from":392,"to":522,"x":0}],[{"y":111,"from":522,"to":654,"x":0}],[{"y":135,"from":654,"to":701,"x":0}]]}],"rawText":"Además de clasificarse por su naturaleza, los conflictos organizacionales pueden analizarse según los actores que involucran, lo que permite comprender el alcance del conflicto y definir el nivel de intervención requerido. Un desacuerdo interno de una persona no exige la misma respuesta que una tensión entre departamentos; por ello, identificar quiénes están involucrados es un paso previo indispensable para cualquier estrategia de gestión. Esta perspectiva amplía la mirada del gestor de talento humano más allá de lo interpersonal y le permite actuar con mayor pertinencia en cada situación. Desde el punto de vista de los actores involucrados, los conflictos pueden clasificarse en cuatro tipos:"}},{"type":"text","name":"La figura 1 presenta los tres tipos de conflicto organizacional más frecuentes en los equipos de trabajo y los distingue según su naturaleza: el conflicto de tarea surge de desacuerdos sobre contenidos y plazos; el de relación, de tensiones interpersonales","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":220,"ty":3782}}},"id":"5655e720-537e-4342-ac5e-c4109263c5ea","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3875,"ty":-7925},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":741},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":105,"x":0}],[{"y":39,"from":105,"to":204,"x":0}],[{"y":63,"from":204,"to":308,"x":0}],[{"y":87,"from":308,"to":413,"x":0}],[{"y":111,"from":413,"to":511,"x":0}],[{"y":135,"from":511,"to":568,"x":0}]]}],"rawText":"La figura 1 presenta los tres tipos de conflicto organizacional más frecuentes en los equipos de trabajo y los distingue según su naturaleza: el conflicto de tarea surge de desacuerdos sobre contenidos y plazos; el de relación, de tensiones interpersonales entre integrantes; y el de proceso, de diferencias sobre cómo organizar las actividades y tomar decisiones. Esta clasificación orienta al gestor de talento humano en la identificación del tipo de conflicto antes de intervenir, lo que permite seleccionar estrategias más precisas y efectivas para cada situación."}},{"type":"group","name":"Enmascarar grupo 1119418","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constra