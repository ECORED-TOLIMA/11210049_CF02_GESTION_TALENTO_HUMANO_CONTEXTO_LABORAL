":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":533,"ty":7086}}},"id":"08a5cb18-bd6f-4e8e-a65e-33bafc239d0f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3562,"ty":-4621},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":846},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":110,"x":0}],[{"y":39,"from":110,"to":222,"x":0}],[{"y":63,"from":222,"to":342,"x":0}],[{"y":87,"from":342,"to":460,"x":0}],[{"y":111,"from":460,"to":497,"x":0}]]}],"rawText":"Seleccionar la alternativa más adecuada no depende únicamente del consenso del grupo, sino de la capacidad de evaluar cada opción con base en parámetros acordados con anterioridad. Cuando el equipo define estos estándares antes de analizar las posibles soluciones, reduce la influencia de sesgos individuales y fortalece la legitimidad de la decisión colectiva. En el contexto de la gestión del talento humano, los parámetros de evaluación más utilizados para valorar alternativas de solución son:"}},{"type":"group","name":"Grupo 1200518","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-1,"ty":4852}}},"id":"f315f5cb-86f7-4d48-b3ec-4c6d15cde7e6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4096,"ty":-6855},"group":{"children":[{"type":"group","name":"hr-before-h2","id":"8d580adc-1882-4f6f-b9a5-a8284c08c386","transform":{"a":1,"b":0,"c":0,"d":1,"tx":390.37109375,"ty":1066},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"constraintWidth":true,"constr