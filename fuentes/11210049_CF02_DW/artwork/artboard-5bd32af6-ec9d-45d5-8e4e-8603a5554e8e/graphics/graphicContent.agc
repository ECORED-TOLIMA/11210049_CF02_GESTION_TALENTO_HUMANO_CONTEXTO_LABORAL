traintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":437}}},"id":"0f7368cf-1ef1-4b15-86e2-60be1f02e3eb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3598,"ty":-11270},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":140}},{"type":"text","name":"Resolver problemas y conflictos de manera constructiva no implica eliminarlos ni evitarlos, sino abordarlos con las herramientas adecuadas para convertirlos en oportunidades de mejora. Cuando los equipos cuentan con metodologías claras, criterios compartid","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":522,"ty":462}}},"id":"ac21a582-bb65-4031-9398-e0a9757ffbad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3573,"ty":-11245},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":866},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":116,"x":0}],[{"y":39,"from":116,"to":229,"x":0}],[{"y":63,"from":229,"to":347,"x":0}],[{"y":87,"from":347,"to":404,"x":0}]]}],"rawText":"Resolver problemas y conflictos de manera constructiva no implica eliminarlos ni evitarlos, sino abordarlos con las herramientas adecuadas para convertirlos en oportunidades de mejora. Cuando los equipos cuentan con metodologías claras, criterios compartidos y habilidades de argumentación y negociación, los conflictos dejan de ser amenazas para convertirse en palancas de transformación organizacional."}},{"type":"text","name":"La resolución efectiva de problemas organizacionales descansa sobre principios que orientan el proceso desde el diagnóstico inicial hasta la consolidación de los acuerdos. Conocerlos permite al equipo actuar de manera ordenada y fundamentada, independiente","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":607}}},"id":"674fffa7-a176-4fae-9560-35df95db9a0a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3910,"ty":-11100},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":162,"x":0}],[{"y":39,"from":162,"to":326,"x":0}],[{"y":63,"from":326,"to":343,"x":0}]]}],"rawText":"La resolución efectiva de problemas organizacionales descansa sobre principios que orientan el proceso desde el diagnóstico inicial hasta la consolidación de los acuerdos. Conocerlos permite al equipo actuar de manera ordenada y fundamentada, independientemente del tipo de conflicto que se presente. Los principios que guían este proceso son:"}},{"type":"shape","name":"Rectángulo 467677","meta":{"ux":{"nameL10N":"SHAPE_RECTANGL