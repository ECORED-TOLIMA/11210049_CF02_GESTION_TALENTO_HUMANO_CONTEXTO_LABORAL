trabajo en equipo las tareas se asignan individualmente; en el colaborativo se construyen de forma conjunta.\nResponsabilidad: en el trabajo en equipo cada integrante responde por su parte; en el colaborativo la responsabilidad es compartida por el proceso y el resultado.\nInterdependencia: en el trabajo en equipo es funcional y operativa; en el colaborativo es cognitiva y relacional.\nTipo de resultado: el trabajo en equipo integra productos individuales; el colaborativo genera soluciones que no podrían surgir de manera aislada.\nLiderazgo: en el trabajo en equipo tiende a ser centralizado; en el colaborativo es distribuido y compartido entre los integrantes. "}},{"type":"shape","name":"Rectángulo 467591","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":208,"ty":2324}}},"id":"b886209a-00df-4471-8eb2-1aefec65b56e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7057,"ty":-9355},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 467592","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":208,"ty":2357}}},"id":"56bdc676-a36f-4074-8115-0d4d4987b699","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7057,"ty":-9322},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 467593","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constrai