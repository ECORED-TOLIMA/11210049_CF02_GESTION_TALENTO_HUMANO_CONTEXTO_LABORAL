ntercambiable, es útil establecer una distinción conceptual entre ellos para aprovechar mejor las posibilidades que cada uno ofrece."}},{"type":"shape","name":"Image Place Holder","id":"de1c4b22-9fb0-48ca-9112-65f7a1469125","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6665,"ty":-9889},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":600,"ty":1790}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":254,"g":221,"b":180}}}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":290}},{"type":"shape","name":"Image Place Holder","id":"f2f47e06-e62f-4499-aa6f-3b6928677470","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6976,"ty":-9129},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":2550}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}}},"shape":{"type":"rect","x":0,"y":0,"width":708,"height":200,"r":[10,10,10,10]}},{"type":"group","name":"Enmascarar grupo 1119359","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"BG","id":"afa61f0d-e636-4cd8-acc0-23ca51ef95aa","meta":{"ux":{"hasCustomName":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":232,"g":232,"b":232}}}},"shape":{"type":"rect","x":0,"y":0,"width":395,"height":290}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":1790}}},"id":"d95a49d2-6e1d-4dc2-b3ae-ffbb7710b989","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-9889},"group":{"children":[{"type":"shape","name":"Imagen 174","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":650,"height":433}}},"id":"04d070ad-af0c-466c-9cce-93ecd301730c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-26,"ty":0},"style":{"fill":{"type":"pattern","pattern":{"width":650,"height":433,"meta":{"ux":{"scaleBehavior":"fill","uid":"4f39a0f99efbb5335e6af497f69bdc95","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":442,"height":294}}]}},{"type":"text","name":"En las organizaciones, los conceptos de trabajo en equipo y trabajo colaborativo se emplean con frecuencia como sinónimos, pero presentan características que los distinguen y los hacen apropiados para distintos tipos de tareas y contextos. Comprender estas","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":640,"ty":1934}}},"id":"e8f9a8d0-1e87-4bf6-9923-2a8bd0fd09c6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6625,"ty":-9745},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":732},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":96,"x":0}],[{"y":39,"from":96,"to":196,"x":0}],[{"y":63,"from":196,"to":298,"x":0}],[{"y":87,"from":298,"to":394,"x":0}],[{"y":111,"from":394,"to":446,"x":0}]]}],"rawText":"En las organizaciones, los conceptos de trabajo en equipo y trabajo colaborativo se emplean con frecuencia como sinónimos, pero presentan características que los distinguen y los hacen apropiados para distintos tipos de tareas y contextos. Comprender estas diferencias permite al gestor de talento humano seleccionar y facilitar la modalidad que mejor responde a los objetivos del grupo y a la naturaleza del desafío que enfrenta la organización."}},{"type":"text","name":"La elección de una u otra modalidad no depende únicamente del tipo de tarea, sino también de factores como la composición del grupo, el nivel de confianza entre sus integrantes y la disponibilidad de tiempo y recursos. Un gestor de talento humano que compr","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":2108}}},"id":"95d5cd3f-1aa7-47f8-a38e-36d473fda672","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6976,"ty":-9571},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":155,"x":0}],[{"y":39,"from":155,"to":305,"x":0}],[{"y":63,"from":305,"to":431,"x":0}]]}],"rawText":"La elección de una u otra modalidad no depende únicamente del tipo de tarea, sino también de factores como la composición del grupo, el nivel de confianza entre sus integrantes y la disponibilidad de tiempo y recursos. Un gestor de talento humano que comprende estas variables está en mejor posición para facilitar dinámicas de trabajo que potencien las capacidades colectivas y generen resultados sostenibles para la organización."}},{"type":"text","name":"Las diferencias descritas no indican que una modalidad sea superior a la otra, sino que cada una responde a condiciones y propósitos distintos. El gestor de talento humano que comprende estos rasgos puede intervenir con mayor precisión: organizar los grupo","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":327,"ty":2581}}},"id":"dd1daa3c-4176-4988-a5c2-3868bbdb849b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6938,"ty":-9098},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":632},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":88,"x":0}],[{"y":39,"from":88,"to":172,"x":0}],[{"y":63,"from":172,"to":258,"x":0}],[{"y":87,"from":258,"to":345,"x":0}],[{"y":111,"from":345,"to":431,"x":0}],[{"y":135,"from":431,"to":454,"x":0}]]}],"rawText":"Las diferencias descritas no indican que una modalidad sea superior a la otra, sino que cada una responde a condiciones y propósitos distintos. El gestor de talento humano que comprende estos rasgos puede intervenir con mayor precisión: organizar los grupos de manera coherente con la tarea, distribuir las responsabilidades de forma adecuada y facilitar dinámicas que favorezcan tanto la eficiencia operativa como la construcción conjunta de soluciones."}},{"type":"text","name":"Para comprender el alcance de cada modalidad, es útil observar cómo se manifiesta en situaciones reales del entorno organizacional. Los siguientes conceptos describen las características centrales del trabajo en equipo y del trabajo colaborativo, e ilustra","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":2780}}},"id":"8afd44ef-8acd-4094-9931-8dec8800dd18","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6976,"ty":-8899},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":708},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":85,"x":0}],[{"y":39,"from":85,"to":171,"x":0}],[{"y":63,"from":171,"to":272,"x":0}],[{"y":87,"from":272,"to":297,"x":0}]]}],"rawText":"Para comprender el alcance de cada modalidad, es útil observar cómo se manifiesta en situaciones reales del entorno organizacional. Los siguientes conceptos describen las características centrales del trabajo en equipo y del trabajo colaborativo, e ilustran su aplicación mediante casos concretos:"}},{"type":"text","name":"Aunque ambas modalidades comparten el propósito de alcanzar resultados colectivos, se diferencian en aspectos fundamentales que determinan cómo se organiza el trabajo y cómo se distribuye la responsabilidad:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textS