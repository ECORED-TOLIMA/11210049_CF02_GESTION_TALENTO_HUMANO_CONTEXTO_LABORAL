pattern":{"width":650,"height":433,"meta":{"ux":{"scaleBehavior":"fill","uid":"bb996b9f84db19da48ab85b634dba99f","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":650,"height":433}}]}},{"type":"group","name":"Right","id":"d3b7dca3-6b19-4dd7-af9d-52b327011948","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6579.5,"ty":-7372},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":685.5,"ty":4307}}},"group":{"children":[{"type":"shape","name":"BG","id":"322ad1a7-f77b-42d7-8799-f3e6c1ab9bd1","meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":250,"g":251,"b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":684.900390625,"height":270}}]}},{"type":"text","name":"Los principios del trabajo colaborativo constituyen el marco que orienta la manera en que los integrantes de un grupo se relacionan, se comunican y construyen conjuntamente. Su aplicación no se limita a las grandes corporaciones con equipos especializados;","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":713,"ty":4337}}},"id":"d992c4cd-916f-4a47-a3c3-c38047490bc8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6552,"ty":-7342},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":632},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":86,"x":0}],[{"y":39,"from":86,"to":159,"x":0}],[{"y":63,"from":159,"to":241,"x":0}],[{"y":87,"from":241,"to":325,"x":0}],[{"y":111,"from":325,"to":413,"x":0}],[{"y":135,"from":413,"to":502,"x":0}],[{"y":159,"from":502,"to":586,"x":0}],[{"y":183,"from":586,"to":669,"x":0}],[{"y":207,"from":669,"to":685,"x":0}]]}],"rawText":"Los principios del trabajo colaborativo constituyen el marco que orienta la manera en que los integrantes de un grupo se relacionan, se comunican y construyen conjuntamente. Su aplicación no se limita a las grandes corporaciones con equipos especializados; en las PYMES y en las organizaciones del sector público colombiano, estos principios resultan igualmente determinantes para sostener la cohesión del grupo, distribuir la carga de trabajo de forma equitativa y mantener la motivación frente a los desafíos del entorno. El gestor de talento humano que los conoce y promueve está en capacidad de transformar la dinámica de cualquier equipo, independientemente de su tamaño o sector."}},{"type":"group","name":"Dots 4","id":"f6c626c9-d881-4dc5-9367-32ccc9de4957","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6957.857421875,"ty":-6696.8291015625},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":307.142578125,"ty":4982.1708984375}}},"group":{"children":[{"type":"shape","name":"Elipse 22","meta":{"ux":{"nameL10N":"SHAPE_ELLIPSE","constraintLeft":true,"constraintRight":true,"constraintHeight":true}},"id":"9463b124-3d76-49d3-b255-7a18e4f98b62","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-0.1429477334022522,"ty":7.7404890060424805},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":210,"g":225,"b":241}}},"stroke":{"type":"none","color