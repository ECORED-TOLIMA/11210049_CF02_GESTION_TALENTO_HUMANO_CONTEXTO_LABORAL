34,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":1,"x":-4.58984375}]]}],"rawText":"4"}},{"type":"shape","name":"Rectángulo 468247","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":6315}}},"id":"0eca8d3b-7198-46ce-b820-a381c55c5431","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6664,"ty":-5364},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":170,"r":[10,10,10,10]}},{"type":"text","name":"Far far away, behind","id":"5ccb69ef-df00-44f7-b339-382f0c92391f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6664,"ty":-5485},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":6194}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":105,"x":0}],[{"y":39,"from":105,"to":207,"x":0}],[{"y":63,"from":207,"to":315,"x":0}],[{"y":87,"from":315,"to":415,"x":0}],[{"y":111,"from":415,"to":530,"x":0}]]}],"rawText":"Las técnicas de trabajo colaborativo son herramientas metodológicas que estructuran la manera en que los grupos interactúan, toman decisiones y construyen soluciones conjuntas. En el contexto organizacional colombiano, su aplicación ha demostrado ser un factor diferenciador en empresas de distintos tamaños: desde grandes organizaciones del sector financiero y manufacturero hasta pequeñas y medianas empresas del comercio y la agroindustria, donde favorecen la participación equitativa y la calidad de los resultados colectivos."}},{"type":"text","name":"Far far away, behind","id":"181b913c-4f4f-4dbe-a674-6b6ca94cc2c0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6635,"ty":-5337},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":630,"ty":6342}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":754},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":93,"x":0}],[{"y":39,"from":93,"to":191,"x":0}],[{"y":63,"from":191,"to":290,"x":0}],[{"y":87,"from":290,"to":396,"x":0}],[{"y":111,"from":396,"to":420,"x":0}]]}],"rawText":"No todas las técnicas responden a los mismos propósitos ni se adaptan de igual manera a cada contexto. Su selección depende de factores como el tamaño del equipo, el tipo de tarea, el tiempo disponible y la cultura de la organización. El gestor de talento humano cumple un papel central en identificar las técnicas más pertinentes para cada situación y en generar las condiciones que permitan su implementación efectiva."}},{"type":"text","name":"Far far away, behind","id":"211b6cdb-51fb-4d02-bb7f-386c49244949","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-5164},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":6515}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":249,"x":0}]]}],"rawText":"Las técnicas disponibles pueden agruparse según el propósito que cumplen dentro del proceso colaborativo, lo que facilita su selección y aplicación. A continuación, se presentan algunas de las más utilizadas en el contexto organizacional colombiano:"}},{"type":"group","name":"Enmascarar grupo 1119413","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468248","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"a5ac45