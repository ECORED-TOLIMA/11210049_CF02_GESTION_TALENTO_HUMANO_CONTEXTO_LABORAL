:409,"x":0}]]}],"rawText":"Principio según el cual el éxito de cada integrante está vinculado al del grupo; para alcanzar el objetivo colectivo, todos deben contribuir de manera activa y responsable. En la práctica: en un equipo de diseño, el proyecto no avanza si un área no entrega su parte a tiempo. Aplicación: en una empresa exportadora, la coordinación entre logística y comercio exterior determina el resultado de cada operación."}},{"type":"group","name":"Grupo 1201868","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":1756}}},"id":"54daac72-ad14-400d-8e8c-4e1072f0b370","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7265,"ty":-9923},"group":{"children":[{"type":"shape","name":"Rectángulo 467569","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"e4ddb51e-ebcb-4069-82a9-31a7e2f5eae2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1121,"ty":3467},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":239,"g":242,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":292,"height":108,"r":[20,20,0,0]}},{"type":"group","name":"Grupo 1202172","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintBottom":true}},"id":"5417073c-327e-408a-bcd5-a6045408714d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1132.317138671875,"ty":3434.999755859375},"group":{"children":[{"type":"group","name":"Grupo 1202171","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 468376","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"8d3f7e29-ddb4-494b-9991-1655747b90fe","shape":{"type"