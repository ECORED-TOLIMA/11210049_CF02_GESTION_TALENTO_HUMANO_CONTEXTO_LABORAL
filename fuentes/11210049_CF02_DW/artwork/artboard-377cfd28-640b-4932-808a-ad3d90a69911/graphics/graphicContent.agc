se,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":223,"ty":3189.265625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":538},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":72,"x":0}],[{"y":39,"from":72,"to":142,"x":0}],[{"y":63,"from":142,"to":214,"x":0}],[{"y":87,"from":214,"to":244,"x":0}]]},{"lines":[[{"y":111,"from":245,"to":245,"x":0}]]},{"lines":[[{"y":135,"from":246,"to":321,"x":0}],[{"y":159,"from":321,"to":367,"x":0}]]},{"lines":[[{"y":183,"from":368,"to":443,"x":0}],[{"y":207,"from":443,"to":498,"x":0}]]}],"rawText":"Modalidad en la que un grupo coordina acciones hacia un objetivo común, con roles y responsabilidades individuales claramente definidos. Cada integrante ejecuta una parte específica; el resultado final surge de la articulación de esos aportes. \n\nEjemplo 1: en una empresa de logística, el equipo divide rutas y consolida reportes de despacho al cierre de cada turno. \nEjemplo 2: en una institución de formación, los instructores asignan áreas temáticas y articulan un plan integrado de aprendizaje."}},{"type":"text","name":"Far far away, behind","id":"396e60a0-e998-4770-a496-dadda651cfca","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6428,"ty":-8489.734375},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":837,"ty":3189.265625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":538},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":74,"x":0}],[{"y":39,"from":74,"to":147,"x":0}],[{"y":63,"from":147,"to":217,"x":0}],[{"y":87,"from":217,"to":265,"x":0}]]},{"lines":[[{"y":111,"from":266,"to":266,"x":0}]]},{"lines":[[{"y":135,"from":267,"to":339,"x":0}],[{"y":159,"from":339,"to":393,"x":0}]]},{"lines":[[{"y":183,"from":394,"to":468,"x":0}],[{"y":207,"from":468,"to":523,"x":0}]]}],"rawText":"Enfoque en el que los integrantes construyen conocimiento y soluciones de manera conjunta, mediante el diálogo, la negociación y la co-creación. A diferencia del trabajo en equipo, la responsabilidad no se divide: es compartida por todos en cada etapa del proceso. \n\nEjemplo 1: un equipo de gestión humana diseña colectivamente el plan de bienestar integrando perspectivas de distintas áreas. \nEjemplo 2: un grupo interdisciplinario elabora un protocolo de atención a partir de la experiencia acumulada de cada integrante. "}},{"type":"shape","name":"Rectángulo 468236","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":3655.076171875}}},"id":"f8062248-532a-44ea-838e-7ada7e282315","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6976,"ty":-8023.923828125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":140}},{"type":"text","name":"Las organizaciones más efectivas combinan el trabajo en equipo y el trabajo colaborativo según el desafío que enfrentan. El gestor de talento humano crea las condiciones para que los grupos transiten con flexibilidad entre ambas modalidades.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":183,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319,"ty":3729.076171875}}},"id":"c03aa9f4-b2dc-4b03-bd48-38e1eb56f22e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6946,"ty":-7949.923828125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":131,"x":-472.1341552734375}],[{"y":39,"from":131,"to":241,"x":-405.96044921875}]]}],"rawText":"Las organizaciones más efectivas combinan el trabajo en equipo y el trabajo colaborativo según el desafío que enfrentan. El gestor de talento humano crea las condiciones para que los grupos transiten con flexibilidad entre ambas modalidades."}},{"type":"group","name":"Grupo 1201867","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-5,"ty":-60.763671875}}},"id":"6a6d723e-c48c-4217-8970-a7c6f06c9963","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7270,"ty":-11739.763671875},"group":{"children":[