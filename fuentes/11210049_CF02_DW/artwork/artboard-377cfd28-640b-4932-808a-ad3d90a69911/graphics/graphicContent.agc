,"y2":0}}]}}]}},{"type":"text","name":"Far far away, behind","id":"15577e9f-e541-47f0-a48a-2375300c87b0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-7037},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":4642}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":162,"x":0}],[{"y":39,"from":162,"to":329,"x":0}],[{"y":63,"from":329,"to":360,"x":0}]]}],"rawText":"El trabajo colaborativo se sustenta en un conjunto de principios que orientan la manera en que los integrantes interactúan, asumen responsabilidades y construyen soluciones de forma conjunta. Cada principio cumple una función específica y, en conjunto, crean las condiciones para que la colaboración sea efectiva y sostenible en cualquier tipo de organización:"}},{"type":"text","name":"Far far away, behind","id":"d2203f1a-feb4-4a9d-800e-b9af8ca47bc6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-7562},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":4117}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":159,"x":0}],[{"y":39,"from":159,"to":323,"x":0}],[{"y":63,"from":323,"to":487,"x":0}],[{"y":87,"from":487,"to":652,"x":0}],[{"y":111,"from":652,"to":728,"x":0}]]}],"rawText":"En Colombia, las organizaciones de distintos tamaños y sectores han incorporado el trabajo colaborativo como estrategia para responder a entornos cada vez más complejos y cambiantes. Desde las grandes empresas del sector financiero y de servicios hasta las pequeñas y medianas empresas (PYMES) del comercio, la manufactura y la agroindustria, la colaboración se ha convertido en un mecanismo clave para aprovechar el conocimiento distribuido entre los integrantes de un equipo y generar soluciones que ningún individuo podría alcanzar de manera aislada. No obstante, la colaboración efectiva no ocurre de forma espontánea: requiere condiciones claras, intencionalidad y el desarrollo de prácticas concretas que la hagan posible."}},{"type":"shape","name":"Rectángulo 467540","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497,"ty":461}}},"id":"7038f561-64f2-4083-8c78-248d0cc3c914","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6768,"ty":-11218},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":245,"b":232}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":134}},{"type":"text","name":"Esta unidad profundiza en los conceptos de trabajo colaborativo y trabajo en equipo, explora sus diferencias y sus complementariedades, y presenta las técnicas más efectivas para potenciar la inteligencia colectiva y lograr resultados que trasciendan lo qu","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":532,"ty":495}}},"id":"701e8f11-812b-41c8-a083-78a4531dc62d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6733,"ty":-11184},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":846},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":115,"x":0}],[{"y":39,"from":115,"to":224,"x":0}],[{"y":63,"from":224,"to":311,"x":0}]]}],"rawText":"Esta unidad profundiza en los conceptos de trabajo colaborativo y trabajo en equipo, explora sus diferencias y sus complementariedades, y presenta las técnicas más efectivas para potenciar la inteligencia colectiva y lograr resultados que trasciendan lo que cada integrante podría alcanzar de manera individual."}},{"type":"group","name":"Grupo 1200464","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraint