":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":322,"ty":1360}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":647},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":87,"x":0}],[{"y":39,"from":87,"to":176,"x":0}],[{"y":63,"from":176,"to":265,"x":0}],[{"y":87,"from":265,"to":324,"x":0}]]}],"rawText":"Para aplicar estas modalidades de manera estratégica, es necesario conocer primero los distintos tipos de trabajo grupal que pueden configurarse en una organización. Cada tipo responde a características específicas del equipo, del objetivo y del contexto, y ofrece posibilidades distintas para la gestión del talento humano."}},{"type":"text","name":"Far far away, behind","id":"88170d90-e99c-4427-b4b0-2e74f5572aef","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-10456},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":1223}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":109,"x":0}],[{"y":39,"from":109,"to":225,"x":0}],[{"y":63,"from":225,"to":326,"x":0}],[{"y":87,"from":326,"to":392,"x":0}]]}],"rawText":"Comprender estos conceptos permite al gestor de talento humano diseñar estructuras de trabajo que aprovechen las fortalezas individuales y las potencien a través de la interacción. La elección entre el trabajo en equipo y el colaborativo no es excluyente: en muchas organizaciones colombianas ambas modalidades coexisten y se complementan según el tipo de tarea y el objetivo que se persigue."}},{"type":"text","name":"Los cinco principios descritos configuran un sistema interdependiente: ninguno alcanza su pleno potencial de manera aislada. El gestor de talento humano que los promueve de forma simultánea contribuye a construir equipos más cohesionados, comunicativos y c","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":5192}}},"id":"0dcdfcf6-acd5-4e62-823a-8a97b8d51444","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-6487},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":128,"x":0}],[{"y":39,"from":128,"to":239,"x":0}],[{"y":63,"from":239,"to":300,"x":0}]]},{"lines":[[{"y":87,"from":301,"to":301,"x":0}]]},{"lines":[[{"y":111,"from":302,"to":426,"x":0}],[{"y":135,"from":426,"to":481,"x":0}]]}],"rawText":"Los cinco principios descritos configuran un sistema interdependiente: ninguno alcanza su pleno potencial de manera aislada. El gestor de talento humano que los promueve de forma simultánea contribuye a construir equipos más cohesionados, comunicativos y capaces de aprender de su propia experiencia.\n\nPara que estos principios se consoliden en la práctica organizacional, el área de talento humano puede implementar acciones concretas que los activen y los sostengan en el tiempo:"}},{"type":"text","name":"Estas acciones no son medidas aisladas: conforman una estrategia integrada que permite al área de talento humano crear las condiciones para que los principios del trabajo colaborativo se expresen en la cotidianidad de los equipos. Su implementación progres","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":5587}}},"id":"a22f2910-d9a1-4e72-9d73-38b573952c0a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6976,"ty":-6092},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":148,"x":0}],[{"y":39,"from":148,"to":299,"x":0}],[{"y":63,"from":299,"to":372,"x":0}]]}],"rawText":"Estas acciones no son medidas aisladas: conforman una estrategia integrada que permite al área de talento humano crear las condiciones para que los principios del trabajo colaborativo se expresen en la cotidianidad de los equipos. Su implementación progresiva transforma la cultura organizacional y fortalece la capacidad colectiva de responder a los desafíos del entorno."}},{"type":"text","name":"Comprendidos los principios que sustentan el trabajo colaborativo, el paso siguiente consiste en identificar las técnicas que facilitan su implementación. El siguiente apartado presenta las herramientas más utilizadas en el contexto organizacional para pot","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":5909}}},"id":"4d9a7d99-06c0-4d96-a1d5-43147c86145e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7080,"ty":-5770},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":312,"x":0}]]}],"rawText":"Comprendidos los principios que sustentan el trabajo colaborativo, el paso siguiente consiste en identificar las técnicas que facilitan su implementación. El siguiente apartado presenta las herramientas más utilizadas en el contexto organizacional para potenciar la productividad y la creatividad de los equipos."}},{"type":"shape","name":"Rectángulo 467580","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":5728.8896484375}}},"id":"b6488b8c-460a-4fcd-9b7a-cefa344bfcbe","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6975,"ty":-5950.1103515625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":203,"g":213,"b":255}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":140}},{"type":"text","name":"Un equipo que practica estos principios no solo alcanza mejores resultados: desarrolla la capacidad de aprender, adaptarse y crecer de manera colectiva.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":183,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320,"ty":5802.8896484375}}},"id":"d23df920-2d43-4eab-896e-25fcf8c213f2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6945,"ty":-5876.1103515625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":960},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":132,"x":-475.93927001953125}],[{"y":39,"from":132,"to":152,"x":-75.04015350341797}]]}],"rawText":"Un equipo que practica estos principios no solo alcanza mejores resultados: desarrolla la capacidad de aprender, adaptarse y crecer de manera colectiva."}},{"type":"group","name":"Grupo 1200529","meta":{"ux":{"n