","style":"Black","size":20},"textAttributes":{"lineHeight":27}},"text":{"frame":{"type":"autoHeight","width":1112.7255859375},"paragraphs":[{"lines":[[{"y":19,"from":0,"to":89,"x":0}]]}],"rawText":"Gestión del talento humano, un encuentro con la ética en el entorno individual y laboral."}},{"type":"text","name":"Síntesis: Comunicación, trabajo colaborativo y asertividad","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":50,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":212,"ty":182.6484375}}},"id":"c6b200c0-8cef-470a-9c6c-237ea72327f2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-13832,"ty":-8099.3515625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1004},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":58,"x":0}]]}],"rawText":"Síntesis: Comunicación, trabajo colaborativo y asertividad"}},{"type":"text","name":"El componente formativo aborda la comunicación, el trabajo colaborativo y la asertividad como capacidades que se potencian de manera conjunta para mejorar las interacciones y los resultados en los entornos laborales. Explora la comunicación organizacional ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":458,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":290}}},"id":"c4c69b34-f0a6-4832-9719-1bab50c2ac7f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-13858,"ty":-7992},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":159,"x":0}],[{"y":39,"from":159,"to":316,"x":0}],[{"y":63,"from":316,"to":484,"x":0}],[{"y":87,"from":484,"to":650,"x":0}],[{"y":111,"from":650,"to":776,"x":0}]]},{"lines":[[{"y":135,"from":777,"to":777,"x":0}]]},{"lines":[[{"y":159,"from":778,"to":924,"x":0}]]}],"rawText":"El componente formativo aborda la comunicación, el trabajo colaborativo y la asertividad como capacidades que se potencian de manera conjunta para mejorar las interacciones y los resultados en los entornos laborales. Explora la comunicación organizacional desde sus fundamentos hasta su uso efectivo en los equipos, reconociendo sus formas verbales y no verbales, así como las barreras que la dificultan; el trabajo colaborativo y las bases que permiten construir grupos integrados y orientados a un propósito común; la resolución de conflictos como proceso que transforma las diferencias en oportunidades de acuerdo; y la asertividad como habilidad para orientar las personas, retroalimentar con criterio constructivo y sostener vínculos de trabajo respetuosos y productivos.\n\nA continuación, se presenta el mapa conceptual que organiza de manera visual los ejes temáticos del componente y las relaciones que los articulan:"}},{"type":"group","name":"Grupo 1200558","meta":{"ux":{"nameL10N":"SHAPE_GROUP","localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":12472.7802734375,"ty":8293.3515625}}},"id":"6a26b436-5cbc-404a-b2